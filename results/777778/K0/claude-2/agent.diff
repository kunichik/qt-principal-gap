+/*!
+    \since 6.13
+
+    Makes the next query to any QMimeDatabase check the MIME definition files
+    for changes immediately.
+
+    To avoid accessing the file system on every query, QMimeDatabase checks
+    whether the MIME definition files (or the binary cache generated by
+    \c update-mime-database) have changed at most once every few seconds.
+    An application that installs a new MIME type definition, or modifies or
+    removes an existing one, can call this function afterwards so that the
+    change becomes visible to the next query, without waiting for the next
+    periodic check.
+
+    This function does not access the file system itself; the files are checked
+    by the next query, from whichever thread performs it.
+
+    \threadsafe
+*/
+void QMimeDatabase::reload()
+{
+    QMimeDatabasePrivate::instance()->reload();
+}
