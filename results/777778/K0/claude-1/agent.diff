+void tst_QMimeDatabase::reload()
+{
+    using namespace std::chrono_literals;
+
+    QMimeDatabase db;
+    const QString mimeTypeName = u"text/x-suse-ymp"_s;
+    // Any query starts the interval between two checks of the files
+    QVERIFY(!db.mimeTypeForName(mimeTypeName).isValid());
+    QElapsedTimer sinceLastCheck;
+    sinceLastCheck.start();
+
+    const QString destDir = m_localMimeDir + "/packages/"_L1;
+    QVERIFY(QDir().mkpath(destDir));
+    static constexpr std::array mimeFiles = { "yast2-metapackage-handler-mimetypes.xml" };
+    copyFiles(mimeFiles, destDir);
+    QVERIFY(!QTest::currentTestFailed());
+
+    // The new file isn't seen until the next periodic check (every 5 seconds)...
+    const bool foundTooEarly = db.mimeTypeForName(mimeTypeName).isValid();
+    if (sinceLastCheck.durationElapsed() < 5s)
+        QVERIFY(!foundTooEarly);
+
+    // ... unless reload() is called; this affects all QMimeDatabase instances
+    QMimeDatabase::reload();
+    QVERIFY(QMimeDatabase().mimeTypeForName(mimeTypeName).isValid());
+    QCOMPARE(db.mimeTypeForFile(u"foo.ymu"_s, QMimeDatabase::MatchExtension).name(),
+             u"text/x-SuSE-ymu"_s);
+
+    // Removing it works the same way
+    sinceLastCheck.start();
+    deleteFiles(mimeFiles, destDir);
+    const bool foundAfterRemoval = db.mimeTypeForName(mimeTypeName).isValid();
+    if (sinceLastCheck.durationElapsed() < 5s)
+        QVERIFY(foundAfterRemoval);
+    QMimeDatabase::reload();
+    QVERIFY(!db.mimeTypeForName(mimeTypeName).isValid());
+
+    // Calling it repeatedly, or with nothing changed, is harmless
+    QMimeDatabase::reload();
+    QMimeDatabase::reload();
+    QVERIFY(!db.mimeTypeForName(mimeTypeName).isValid());
+    QVERIFY(db.mimeTypeForName(u"text/plain"_s).isValid());
+}
+
 QTEST_GUILESS_MAIN(tst_QMimeDatabase)
