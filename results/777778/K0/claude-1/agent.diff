+/*!
+    \since 6.13
+
+    Makes the next query check the MIME type definition files for changes.
+
+    QMimeDatabase checks whether MIME type definition files were added, removed
+    or modified at most every five seconds. Call this function after installing
+    or removing a MIME type definition file (and, on Unix systems, after running
+    \c{update-mime-database}), so that the change is visible to the next query
+    on any QMimeDatabase object, instead of up to five seconds later.
+
+    This function does not read any file itself; the check happens on the next
+    query. It affects all QMimeDatabase objects, since they share the same
+    database.
+*/
+void QMimeDatabase::reload()
+{
+    // Nothing to do before the database exists: the first query loads everything.
+    if (staticQMimeDatabase.exists())
+        staticQMimeDatabase()->requestReload();
+}
