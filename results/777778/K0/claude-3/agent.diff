+/*!
+    \since 6.13
+
+    Makes the next query check the MIME database files for changes.
+
+    QMimeDatabase checks whether the MIME definition files have changed at most
+    every five seconds, so MIME type definitions installed or removed by the
+    application may not be visible for up to five seconds. Call this function
+    after installing or removing MIME type definitions (and, on Unix, after
+    running \c update-mime-database) to have the next query on any
+    QMimeDatabase object check the files immediately.
+
+    The files are not read by this function itself; the check happens
+    on the next query.
+
+    \threadsafe
+*/
+void QMimeDatabase::reload()
+{
+    QMimeDatabasePrivate *d = QMimeDatabasePrivate::instance();
+    QMutexLocker locker(&d->mutex);
+    d->reload();
+}
