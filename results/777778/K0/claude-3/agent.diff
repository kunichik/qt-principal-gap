+void tst_QMimeDatabase::reload()
+{
+    static constexpr std::array mimeFiles = { "yast2-metapackage-handler-mimetypes.xml" };
+
+    QMimeDatabase db;
+    // Makes the database check the files now, so that the next periodic
+    // check is not due before the end of this test
+    QMimeDatabase::reload();
+    QVERIFY(!db.mimeTypeForName(u"text/x-suse-ymp"_s).isValid());
+
+    const QString destDir = m_localMimeDir + "/packages/"_L1;
+    QVERIFY(QDir().mkpath(destDir));
+    copyFiles(mimeFiles, destDir);
+    QVERIFY(!QTest::currentTestFailed());
+    auto cleanup = qScopeGuard([&] {
+        QDir(m_localMimeDir).removeRecursively();
+        QMimeDatabase::reload();
+    });
+
+    QMimeDatabase::reload();
+    QVERIFY(db.mimeTypeForName(u"text/x-suse-ymp"_s).isValid());
+    QCOMPARE(db.mimeTypeForFile(u"foo.ymu"_s, QMimeDatabase::MatchExtension).name(),
+             u"text/x-SuSE-ymu");
+
+    deleteFiles(mimeFiles, destDir);
+    QMimeDatabase::reload();
+    QVERIFY(!db.mimeTypeForName(u"text/x-suse-ymp"_s).isValid());
+    QCOMPARE(db.mimeTypeForFile(u"foo.ymu"_s, QMimeDatabase::MatchExtension).name(),
+             u"application/octet-stream");
+}
