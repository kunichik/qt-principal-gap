+/*!
+    \since 6.13
+
+    Makes the next query on any QMimeDatabase object check the MIME database
+    files for changes right away.
+
+    QMimeDatabase checks whether MIME type definitions were added, changed or
+    removed at most once every few seconds. Call this function after installing
+    or removing a MIME type definition (and running \c update-mime-database,
+    where a binary cache is used) to make the change visible to the
+    application immediately.
+
+    This function does not read any files itself; the files are checked on the
+    next query, as when the periodic check is due.
+*/
+void QMimeDatabase::reload()
+{
+    QMimeDatabasePrivate *d = QMimeDatabasePrivate::instance();
+    QMutexLocker locker(&d->mutex);
+    d->reload();
+}
