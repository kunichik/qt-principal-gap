+void tst_QMimeDatabase::reload()
+{
+    QMimeDatabase db;
+    const auto mimeTypeName = "text/x-suse-ymp"_L1;
+    const auto suffixFile = "foo.ymp"_L1;
+
+    // Make sure a check happened recently, so the periodic check isn't due
+    QMimeDatabase::reload();
+    QVERIFY(!db.mimeTypeForName(mimeTypeName).isValid());
+    QElapsedTimer sinceLastCheck;
+    sinceLastCheck.start();
+
+    // Install a MIME type definition in the local directory
+    const QString destDir = m_localMimeDir + "/packages/"_L1;
+    QVERIFY(QDir().mkpath(destDir));
+    static const std::array mimeFiles = { "yast2-metapackage-handler-mimetypes.xml" };
+    copyFiles(mimeFiles, destDir);
+    QVERIFY(!QTest::currentTestFailed());
+
+    // Without reload(), the change isn't seen until the next periodic check
+    // (unless this machine is so slow that the check is due already)
+    const bool notYetThere = !db.mimeTypeForName(mimeTypeName).isValid();
+    if (sinceLastCheck.elapsed() < 4000)
+        QVERIFY(notYetThere);
+
+    // With reload(), the change is seen by the next query
+    QMimeDatabase::reload();
+    QVERIFY(db.mimeTypeForName(mimeTypeName).isValid());
+    sinceLastCheck.start();
+    QCOMPARE(db.mimeTypeForFile(suffixFile, QMimeDatabase::MatchExtension).name(), mimeTypeName);
+
+    // Same for removing the definition again
+    deleteFiles(mimeFiles, destDir);
+    const bool stillThere = db.mimeTypeForName(mimeTypeName).isValid();
+    if (sinceLastCheck.elapsed() < 4000)
+        QVERIFY(stillThere);
+
+    QMimeDatabase::reload();
+    QVERIFY(!db.mimeTypeForName(mimeTypeName).isValid());
+    QCOMPARE(db.mimeTypeForFile(suffixFile, QMimeDatabase::MatchExtension).name(),
+             "application/octet-stream"_L1);
+}
+
