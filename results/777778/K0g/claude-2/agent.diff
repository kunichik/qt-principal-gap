+/*!
+    \since 6.13
+
+    Makes the next query to any QMimeDatabase check the MIME database files
+    for changes right away.
+
+    QMimeDatabase checks whether MIME definition files (and binary caches)
+    were added, removed, or modified at most once every five seconds. An
+    application that installs or removes a MIME type definition at runtime
+    can call this function afterwards, so that the change is visible to the
+    very next query instead of after up to five seconds.
+
+    This function does not read any files itself; the files are checked
+    lazily, by the next query. Calling it has no effect on queries that are
+    already in progress in other threads.
+
+    \note On Unix systems that use the binary cache, the cache file must be
+    regenerated with \c update-mime-database before calling this function,
+    otherwise the change is not seen.
+
+    \sa {QMimeDatabase}{Detailed Description}
+*/
+void QMimeDatabase::reload()
+{
+    if (QMimeDatabasePrivate *d = QMimeDatabasePrivate::instance())
+        d->requestReload();
+}
