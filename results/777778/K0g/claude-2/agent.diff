+void tst_QMimeDatabase::reload()
+{
+    static const std::array mimeFiles = { "yast2-metapackage-handler-mimetypes.xml" };
+    const auto mimeType = u"text/x-suse-ymp"_s;
+    const QString destDir = m_localMimeDir + "/packages/"_L1;
+
+    QMimeDatabase db;
+    // This query starts the interval between checks for changed files
+    QVERIFY(!db.mimeTypeForName(mimeType).isValid());
+    QElapsedTimer sinceLastCheck;
+    sinceLastCheck.start();
+
+    QVERIFY(QDir().mkpath(destDir));
+    copyFiles(mimeFiles, destDir);
+    QVERIFY(!QTest::currentTestFailed());
+
+    // Without reload(), the new file is not seen until the next periodic check.
+    // Only verify this if we're certain that check isn't due yet.
+    if (sinceLastCheck.elapsed() < 2000)
+        QVERIFY(!db.mimeTypeForName(mimeType).isValid());
+
+    QMimeDatabase::reload();
+    QVERIFY(db.mimeTypeForName(mimeType).isValid());
+    QCOMPARE(db.mimeTypeForFile(u"foo.ymu"_s, QMimeDatabase::MatchExtension).name(),
+             u"text/x-SuSE-ymu"_s);
+
+    // reload() applies to all QMimeDatabase instances, and to removals too
+    sinceLastCheck.start();
+    deleteFiles(mimeFiles, destDir);
+    if (sinceLastCheck.elapsed() < 2000)
+        QVERIFY(QMimeDatabase().mimeTypeForName(mimeType).isValid());
+
+    QMimeDatabase::reload();
+    QVERIFY(!QMimeDatabase().mimeTypeForName(mimeType).isValid());
+    QVERIFY(!db.mimeTypeForName(mimeType).isValid());
+}
