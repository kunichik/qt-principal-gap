+
+void tst_QUrlInternal::decodeForLocalFileFailure()
+{
+    QFETCH(QString, input);
+
+    const QString prefix = QTest::currentDataTag();
+    QString output = prefix;
+    QCOMPARE_LT(qt_urlRecode(output, input, QUrlDecodeForLocalFile), 0);
+    QCOMPARE(output, prefix);   // left unchanged
+
+    // the other modes are unaffected and don't fail
+    output = prefix;
+    QCOMPARE_GE(qt_urlRecode(output, input, QUrl::FullyDecoded), 0);
+    output = prefix;
+    QCOMPARE_GE(qt_urlRecode(output, input, QUrl::PrettyDecoded), 0);
+    output = prefix;
+    QCOMPARE_GE(qt_urlRecode(output, input, QUrl::FullyEncoded), 0);
+}
