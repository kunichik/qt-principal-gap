+void tst_QUrlInternal::decodeForLocalFile_data()
+{
+    QTest::addColumn<QString>("input");
+    QTest::addColumn<QString>("expected");
+
+    QTest::newRow("empty") << QString() << QString();
+    QTest::newRow("nothing-to-decode") << "/tmp/file.txt" << "/tmp/file.txt";
+    QTest::newRow("unencoded-unicode") << u"/tmp/\u00e9t\u00e9"_s << u"/tmp/\u00e9t\u00e9"_s;
+    QTest::newRow("space") << "/tmp/a%20b" << "/tmp/a b";
+    QTest::newRow("percent") << "/tmp/100%25" << "/tmp/100%";
+    QTest::newRow("percent-not-decoded-twice") << "/tmp/%252F" << "/tmp/%2F";
+    QTest::newRow("reserved") << "/%3A%3F%23%5B%5D%40" << "/:?#[]@";
+    QTest::newRow("lowercase-hex") << "/a%2db" << "/a-b";
+    QTest::newRow("control") << "/a%01%7Fb" << u"/a\u0001\u007fb"_s;
+#ifndef Q_OS_WIN
+    QTest::newRow("backslash") << "/a%5Cb" << "/a\\b";
+#endif
+    QTest::newRow("unencoded-backslash") << "/a\\b%20" << "/a\\b ";
+
+    // percent-encoded UTF-8 is decoded
+    QTest::newRow("utf8-2") << "/%C3%A9t%C3%A9" << u"/\u00e9t\u00e9"_s;
+    QTest::newRow("utf8-3") << "/%E2%82%AC" << u"/\u20ac"_s;
+    QTest::newRow("utf8-4") << "/%F0%9F%98%80" << u"/\U0001F600"_s;
+    QTest::newRow("utf8-nonchar") << "/%EF%BF%BF" << u"/\uffff"_s;
+    QTest::newRow("utf8-mixed") << u"/\u00e9%C3%A9%20"_s << u"/\u00e9\u00e9 "_s;
+
+    // badly-encoded data is left alone, as with QUrl::FullyDecoded
+    QTest::newRow("bad-percent-end") << "/a%2" << "/a%2";
+    QTest::newRow("bad-percent-nonhex") << "/a%20%zz" << "/a%20%zz";
+    QTest::newRow("bad-percent-after-slash") << "/a%2F%" << "/a%2F%";
+    QTest::newRow("bad-percent-before-slash") << "/a%%2F" << "/a%%2F";
+    QTest::newRow("bad-percent-after-invalid-utf8") << "/a%FF%0" << "/a%FF%0";
+}
+
+void tst_QUrlInternal::decodeForLocalFile()
+{
+    QFETCH(QString, input);
+    QFETCH(QString, expected);
+
+    // prepend some data to be sure that it remains there
+    QString output = QTest::currentDataTag();
+    expected.prepend(output);
+
+    const qsizetype result = qt_urlRecode(output, input, QUrlDecodeForLocalFile);
+    QCOMPARE_GE(result, 0);
+    if (result == 0)
+        output += input;
+    QCOMPARE(output, expected);
+}
+
