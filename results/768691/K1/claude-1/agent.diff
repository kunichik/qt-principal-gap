+/*!
+    \internal
+
+    Like decode(), but used for QUrlDecodeForLocalFile mode: percent-encoded
+    sequences are fully decoded into \a appendTo and the number of characters
+    appended is returned (0 if \a in contains nothing to decode).
+
+    Unlike decode(), this function decodes percent-encoded UTF-8 sequences
+    and fails, returning -1 and leaving \a appendTo unchanged, if the result
+    would not be safe to use as a local file path:
+    \list
+      \li a percent-encoded sequence decodes to NUL or to '/' (or to '\\' on
+          Windows), as that would change the meaning of the path;
+      \li the percent-encoded bytes are not valid UTF-8.
+    \endlist
+
+    Badly-encoded data (a '%' not followed by two hex digits) is handled as
+    in decode(): the input is copied undecoded. This takes precedence over the
+    failure conditions above, since nothing is decoded in that case.
+*/
+static qsizetype decodeForLocalFile(QString &appendTo, QStringView in)
+{
+    const char16_t *begin = in.utf16();
+    const char16_t *end = begin + in.size();
+    const char16_t *input = QtPrivate::qustrchr(in, '%');
+
+    if (Q_LIKELY(input == end))
+        return 0;           // nothing to do, it was already decoded!
+
+    // each %XX sequence (or group of them) shrinks when decoded, so the
+    // output is never longer than the input
+    const qsizetype origSize = appendTo.size();
+    appendTo.resize(origSize + in.size());
+    char16_t *output = reinterpret_cast<char16_t *>(appendTo.data()) + origSize;
+    output = std::copy(begin, input, output);
+
+    while (input != end) {
+        Q_ASSERT(*input == '%');
+
+        if (Q_UNLIKELY(end - input < 3 || !isHex(input[1]) || !isHex(input[2]))) {
+            // badly-encoded data: copy the original input, like decode() does
+            appendTo.truncate(origSize);
+            appendTo.append(in);
+            return in.size();
+        }
+
+        const uchar b = uchar(decodePercentEncoding(input));
+        if (b < 0x80) {
+            if (b == '\0' || b == '/')
+                break;
+#ifdef Q_OS_WIN
+            if (b == '\\')
+                break;
+#endif
+            *output++ = b;
+            input += 3;
+        } else {
+            char32_t ucs4;
+            char32_t *dst = &ucs4;
+            const char16_t *src = input + 3;  // skip the %XX that yielded b
+            if (QUtf8Functions::fromUtf8<QUrlLocalFileUtf8Traits>(b, dst, src, end) < 0)
+                break;
+            if (QChar::requiresSurrogates(ucs4)) {
+                *output++ = QChar::highSurrogate(ucs4);
+                *output++ = QChar::lowSurrogate(ucs4);
+            } else {
+                *output++ = char16_t(ucs4);
+            }
+            input = src;
+        }
+
+        // copy everything up to the next percent
+        const char16_t *next = QtPrivate::qustrchr(QStringView(input, end), '%');
+        output = std::copy(input, next, output);
+        input = next;
+    }
+
+    if (input != end) {
+        // We broke out of the loop: decoding would have produced an unsafe
+        // result. But if the rest of the input is badly encoded, nothing gets
+        // decoded at all (see above), so the result doesn't depend on the
+        // order in which the problems appear.
+        appendTo.truncate(origSize);
+        for (const char16_t *p = input; p != end; ++p) {
+            if (*p == '%' && (end - p < 3 || !isHex(p[1]) || !isHex(p[2]))) {
+                appendTo.append(in);
+                return in.size();
+            }
+        }
+        return -1;
+    }
+
+    const qsizetype len = output - reinterpret_cast<const char16_t *>(appendTo.constData());
+    appendTo.truncate(len);
+    return len - origSize;
+}
