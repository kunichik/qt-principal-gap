+/*!
+    \since 6.13
+    \internal
+
+    This function decodes a percent-encoded string located in \a in for use
+    as a local file path, appending the result to \a appendTo. It returns the
+    number of characters appended, 0 if there was nothing to decode, or -1 if
+    the decoded string would not be safe to use as a local file path. In the
+    latter case, \a appendTo is left unchanged.
+
+    Unlike decode(), percent-encoded sequences of %80 to %FF are decoded as
+    UTF-8. The decoding is refused if:
+
+    \list
+      \li a percent-encoded sequence decodes to NUL or '/' (or '\\' on
+          Windows);
+      \li the percent-encoded sequences from %80 to %FF do not form valid
+          UTF-8 (including overlong forms and surrogates);
+      \li on Windows, the input contains a literal '\\'.
+    \endlist
+
+    Badly-encoded input is copied to the output undecoded, as in decode().
+*/
+static qsizetype decodeForLocalFile(QString &appendTo, QStringView in)
+{
+#ifdef Q_OS_WIN
+    constexpr bool isWindows = true;
+#else
+    constexpr bool isWindows = false;
+#endif
+
+    if (isWindows && in.contains(u'\\'))
+        return -1;
+
+    const char16_t *begin = in.utf16();
+    const char16_t *end = begin + in.size();
+    const char16_t *input = QtPrivate::qustrchr(in, '%');
+    if (Q_LIKELY(input == end))
+        return 0;           // nothing to do, it was already decoded!
+
+    // badly-encoded data is not decoded at all, like decode() does
+    for (const char16_t *p = input; p != end; ++p) {
+        if (*p == '%' && (end - p < 3 || !isHex(p[1]) || !isHex(p[2]))) {
+            appendTo += in;
+            return in.size();
+        }
+    }
+
+    // decoding never makes the string longer
+    const qsizetype origSize = appendTo.size();
+    appendTo.resize(origSize + in.size());
+    char16_t *output = reinterpret_cast<char16_t *>(appendTo.data()) + origSize;
+    output = std::copy(begin, input, output);
+
+    while (input != end) {
+        if (*input != '%') {
+            *output++ = *input++;
+            continue;
+        }
+
+        const char16_t decoded = decodePercentEncoding(input);
+        input += 3;
+        bool ok;
+        if (decoded < 0x80) {
+            ok = decoded != 0 && decoded != '/' && !(isWindows && decoded == '\\');
+            *output++ = decoded;
+        } else {
+            ok = QUtf8Functions::fromUtf8<QUrlLocalFileUtf8Traits>(uchar(decoded), output,
+                                                                    input, end) >= 0;
+        }
+        if (!ok) {
+            appendTo.truncate(origSize);
+            return -1;
+        }
+    }
+
+    const qsizetype len = output - reinterpret_cast<const char16_t *>(appendTo.constData());
+    appendTo.truncate(len);
+    return len - origSize;
+}
