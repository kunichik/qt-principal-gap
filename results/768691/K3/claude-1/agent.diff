+void tst_QUrlInternal::decodeForLocalFile_data()
+{
+    QTest::addColumn<QString>("input");
+    QTest::addColumn<QString>("expected");
+
+    // empty expected means qt_urlRecode() should return 0 (nothing to decode)
+    QTest::newRow("empty") << QString() << QString();
+    QTest::newRow("no-percent") << u"/tmp/foo bar"_s << QString();
+    QTest::newRow("literal-unicode") << u"/tmp/\u00e9t\u00e9"_s << QString();
+    QTest::newRow("literal-nul") << u"/tmp/a\0b"_s << QString();
+
+    QTest::newRow("space") << u"/tmp/foo%20bar"_s << u"/tmp/foo bar"_s;
+    QTest::newRow("percent") << u"/tmp/100%25"_s << u"/tmp/100%"_s;
+    QTest::newRow("double-percent") << u"25%2525"_s << u"25%25"_s;
+    QTest::newRow("hash-question") << u"/tmp/a%23b%3Fc"_s << u"/tmp/a#b?c"_s;
+    QTest::newRow("controls") << u"%0D%0A%1F%7F"_s << u"\r\n\x1f\x7f"_s;
+    QTest::newRow("lowercase-hex") << u"%c3%a9"_s << u"\u00e9"_s;
+    QTest::newRow("utf8-2") << u"/tmp/%C3%A9t%C3%A9"_s << u"/tmp/\u00e9t\u00e9"_s;
+    QTest::newRow("utf8-3") << u"%E2%82%AC"_s << u"\u20ac"_s;
+    QTest::newRow("utf8-4") << u"%F0%9F%98%80"_s << u"\U0001F600"_s;
+    QTest::newRow("utf8-mixed-literal") << u"\u00e9%C3%A9"_s << u"\u00e9\u00e9"_s;
+#ifndef Q_OS_WIN
+    QTest::newRow("backslash") << u"a%5Cb"_s << u"a\\b"_s;
+#endif
+
+    // bad percent-encoding is left undecoded, like with QUrl::FullyDecoded
+    QTest::newRow("bad-short") << u"a%2"_s << u"a%2"_s;
+    QTest::newRow("bad-hex") << u"%2F%GG"_s << u"%2F%GG"_s;
+}
+
+void tst_QUrlInternal::decodeForLocalFile()
+{
+    QFETCH(QString, input);
+    QFETCH(QString, expected);
+
+    // prepend some data to be sure that it remains there
+    const QString prefix = QTest::currentDataTag();
+    QString output = prefix;
+
+    qsizetype result = qt_urlRecode(output, input, QUrlDecodeForLocalFile);
+    if (expected.isNull()) {
+        QCOMPARE(result, 0);
+        QCOMPARE(output, prefix);
+        expected = input;
+    } else {
+        QCOMPARE(result, expected.size());
+        QCOMPARE(output, prefix + expected);
+    }
+
+    // where there is nothing unsafe, the result matches QUrl::FullyDecoded
+    // (which decodes non-ASCII only if the input was already pretty-decoded)
+    QString pretty;
+    if (!qt_urlRecode(pretty, input, QUrl::PrettyDecoded))
+        pretty = input;
+    QString fully;
+    if (!qt_urlRecode(fully, pretty, QUrl::FullyDecoded))
+        fully = pretty;
+    QCOMPARE(fully, expected);
+}
+
