+void tst_QUrlInternal::decodeForLocalFile_data()
+{
+    QTest::addColumn<QString>("input");
+    QTest::addColumn<QString>("expected");
+    QTest::addColumn<bool>("ok");
+
+    // nothing to decode
+    QTest::newRow("empty") << QString() << QString() << true;
+    QTest::newRow("plain") << u"/tmp/file.txt"_s << u"/tmp/file.txt"_s << true;
+    QTest::newRow("plain-unicode") << u"/tmp/f\u00e9"_s << u"/tmp/f\u00e9"_s << true;
+
+    // ASCII
+    QTest::newRow("space") << u"/tmp/a%20b"_s << u"/tmp/a b"_s << true;
+    QTest::newRow("percent") << u"/tmp/100%25"_s << u"/tmp/100%"_s << true;
+    QTest::newRow("hash-question") << u"/a%23b%3Fc"_s << u"/a#b?c"_s << true;
+    QTest::newRow("control") << u"/a%01b%7F"_s << u"/a\x01" u"b\x7f"_s << true;
+    QTest::newRow("lowercase-hex") << u"/a%2fb"_s << QString() << false;
+    QTest::newRow("long") << u"/0123456789abcdef0123456789abcdef%20/0123456789abcdef0123456789"_s
+                          << u"/0123456789abcdef0123456789abcdef /0123456789abcdef0123456789"_s
+                          << true;
+
+    // forbidden decoded characters
+    QTest::newRow("nul") << u"/tmp/a%00b"_s << QString() << false;
+    QTest::newRow("nul-only") << u"%00"_s << QString() << false;
+    QTest::newRow("slash") << u"/tmp/a%2Fb"_s << QString() << false;
+    QTest::newRow("slash-only") << u"%2F"_s << QString() << false;
+    QTest::newRow("dotdot-slash") << u"/tmp/..%2F..%2Fetc"_s << QString() << false;
+    QTest::newRow("slash-after-long")
+            << u"/0123456789abcdef0123456789abcdef/0123456789abcdef%2F"_s << QString() << false;
+#ifdef Q_OS_WIN
+    QTest::newRow("backslash") << u"/tmp/a%5Cb"_s << QString() << false;
+#else
+    QTest::newRow("backslash") << u"/tmp/a%5Cb"_s << u"/tmp/a\\b"_s << true;
+#endif
+
+    // UTF-8
+    QTest::newRow("utf8-2") << u"/f%C3%A9"_s << u"/f\u00e9"_s << true;
+    QTest::newRow("utf8-3") << u"/%E2%82%AC"_s << u"/\u20ac"_s << true;
+    QTest::newRow("utf8-4") << u"/%F0%9F%98%80"_s << u"/\U0001F600"_s << true;
+    QTest::newRow("utf8-mixed") << u"%C3%A9%20%E2%82%AC/x"_s << u"\u00e9 \u20ac/x"_s << true;
+    QTest::newRow("overlong-slash") << u"/a%C0%AFb"_s << QString() << false;
+    QTest::newRow("overlong-nul") << u"/a%C0%80b"_s << QString() << false;
+    QTest::newRow("overlong-3-slash") << u"/a%E0%80%AFb"_s << QString() << false;
+    QTest::newRow("lone-continuation") << u"/a%80"_s << QString() << false;
+    QTest::newRow("truncated") << u"/a%E2%82"_s << QString() << false;
+    QTest::newRow("truncated-ascii") << u"/a%E2%82x"_s << QString() << false;
+    QTest::newRow("latin1") << u"/f%E9"_s << QString() << false;
+    QTest::newRow("surrogate") << u"/%ED%A0%80"_s << QString() << false;
+    QTest::newRow("too-big") << u"/%F4%90%80%80"_s << QString() << false;
+
+    // bad encoding: input is copied undecoded, as with QUrl::FullyDecoded
+    QTest::newRow("bad-encoding") << u"/a%zz"_s << u"/a%zz"_s << true;
+    QTest::newRow("bad-encoding-short") << u"/a%2"_s << u"/a%2"_s << true;
+    QTest::newRow("bad-encoding-after-slash") << u"%zz%2F"_s << u"%zz%2F"_s << true;
+}
+
+void tst_QUrlInternal::decodeForLocalFile()
+{
+    QFETCH(QString, input);
+    QFETCH(QString, expected);
+    QFETCH(bool, ok);
+
+    static_assert((QUrlDecodeForLocalFile & QUrl::FullyDecoded) == QUrl::FullyDecoded);
+
+    // prepend some data to be sure that it remains there (and is untouched on failure)
+    const QString dataTag = QTest::currentDataTag();
+    QString output = dataTag;
+
+    const qsizetype ret = qt_urlRecode(output, input, QUrlDecodeForLocalFile);
+    if (!ok) {
+        QCOMPARE_LT(ret, 0);
+        QCOMPARE(output, dataTag);
+        return;
+    }
+    QCOMPARE_GE(ret, 0);
+    QCOMPARE(output.size(), dataTag.size() + ret);
+    if (!ret)
+        output += input;
+    QCOMPARE(output, dataTag + expected);
+}
+
+void tst_QUrlInternal::decodeForLocalFileInvalidUtf8_data()
+{
+    QTest::addColumn<QByteArray>("utf8");
+    QTest::addColumn<QString>("utf16");
+
+    extern void loadInvalidUtf8Rows();
+    loadInvalidUtf8Rows();
+
+    QTest::newRow("utf8-mix-4") << QByteArray("\xE0.A2\x80");
+    QTest::newRow("utf8-mix-5") << QByteArray("\xE0\xA2.80");
+    QTest::newRow("utf8-mix-6") << QByteArray("\xE0\xA2\x33");
+}
+
+void tst_QUrlInternal::decodeForLocalFileInvalidUtf8()
+{
+    QFETCH(QByteArray, utf8);
+    const QString input = "/dir/"_L1 + utf8.toPercentEncoding() + "/file"_L1;
+
+    const QString dataTag = QTest::currentDataTag();
+    QString output = dataTag;
+    QCOMPARE_LT(qt_urlRecode(output, input, QUrlDecodeForLocalFile), 0);
+    QCOMPARE(output, dataTag);
+
+    // QUrl::FullyDecoded still succeeds, with replacement characters
+    QCOMPARE_GT(qt_urlRecode(output, input, QUrl::FullyDecoded), 0);
+    QVERIFY(output.contains(QChar::ReplacementCharacter));
+}
+
+void tst_QUrlInternal::decodeForLocalFileNonCharacters_data()
+{
+    QTest::addColumn<QByteArray>("utf8");
+    QTest::addColumn<QString>("utf16");
+
+    extern void loadNonCharactersRows();
+    loadNonCharactersRows();
+}
+
+void tst_QUrlInternal::decodeForLocalFileNonCharacters()
+{
+    QFETCH(QByteArray, utf8);
+    QFETCH(QString, utf16);
+    const QString input = "/dir/"_L1 + utf8.toPercentEncoding();
+
+    // non-characters are valid UTF-8, so they are decoded
+    const QString dataTag = QTest::currentDataTag();
+    QString output = dataTag;
+    QCOMPARE_GT(qt_urlRecode(output, input, QUrlDecodeForLocalFile), 0);
+    QCOMPARE(output, dataTag + "/dir/"_L1 + utf16);
+}
