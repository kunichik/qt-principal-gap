+void tst_QUrlInternal::decodeForLocalFile_data()
+{
+    QTest::addColumn<QString>("input");
+    QTest::addColumn<QString>("expected");   // null if the input must be refused
+
+    QTest::newRow("empty") << u""_s << u""_s;
+    QTest::newRow("no-percent") << u"/tmp/file"_s << u"/tmp/file"_s;
+    QTest::newRow("literal-slashes") << u"/a%20b/c"_s << u"/a b/c"_s;
+    QTest::newRow("percent") << u"100%25"_s << u"100%"_s;
+    QTest::newRow("reserved") << u"%3F%23%5B%5D%3A%40"_s << u"?#[]:@"_s;
+    QTest::newRow("control") << u"%01%1F%7F"_s << u"\x01\x1f\x7f"_s;
+    QTest::newRow("unicode-literal") << u"résumé%20"_s << u"résumé "_s;
+    QTest::newRow("utf8-2") << u"r%C3%A9sum%c3%a9"_s << u"résumé"_s;
+    QTest::newRow("utf8-3") << u"%E2%82%AC"_s << u"€"_s;
+    QTest::newRow("utf8-4") << u"%F0%9F%98%80"_s << u"\U0001F600"_s;
+    QTest::newRow("utf8-max") << u"%F4%8F%BF%BF"_s << u"\U0010FFFF"_s;
+    QTest::newRow("utf8-then-ascii") << u"%C3%A9%41"_s << u"éA"_s;
+
+    // bad percent-encoding is left undecoded, as in QUrl::FullyDecoded mode
+    QTest::newRow("bad-percent") << u"a%"_s << u"a%"_s;
+    QTest::newRow("bad-percent-after-valid") << u"%41%zz"_s << u"%41%zz"_s;
+
+    // unsafe characters
+    QTest::newRow("nul") << u"%00"_s << QString();
+    QTest::newRow("nul-middle") << u"/tmp/a%00b"_s << QString();
+    QTest::newRow("slash") << u"%2F"_s << QString();
+    QTest::newRow("slash-lowercase") << u"..%2f..%2fetc"_s << QString();
+    QTest::newRow("slash-after-decoding") << u"a%20b%2Fc"_s << QString();
+#ifdef Q_OS_WIN
+    QTest::newRow("backslash") << u"..%5C..%5Cwindows"_s << QString();
+    QTest::newRow("backslash-lowercase") << u"%5c"_s << QString();
+#else
+    QTest::newRow("backslash") << u"..%5C..%5Cetc"_s << u"..\\..\\etc"_s;
+    QTest::newRow("backslash-lowercase") << u"%5c"_s << u"\\"_s;
+#endif
+
+    // invalid UTF-8
+    QTest::newRow("continuation") << u"%80"_s << QString();
+    QTest::newRow("truncated-2") << u"a%C3"_s << QString();
+    QTest::newRow("truncated-3") << u"%E2%82"_s << QString();
+    QTest::newRow("truncated-by-ascii") << u"%C3A"_s << QString();
+    QTest::newRow("truncated-by-bad-percent") << u"%C3%zz"_s << QString();
+    QTest::newRow("bad-continuation") << u"%C3%28"_s << QString();
+    QTest::newRow("overlong-slash") << u"%C0%AF"_s << QString();
+    QTest::newRow("overlong-nul") << u"%C0%80"_s << QString();
+    QTest::newRow("overlong-3") << u"%E0%80%AF"_s << QString();
+    QTest::newRow("surrogate") << u"%ED%A0%80"_s << QString();
+    QTest::newRow("beyond-unicode") << u"%F4%90%80%80"_s << QString();
+    QTest::newRow("latin1") << u"r%E9sum%E9"_s << QString();
+}
