+void tst_QUrlInternal::decodeForLocalFile()
+{
+    QFETCH(QString, input);
+    QFETCH(QString, expected);
+
+    // prepend some data to be sure that it remains there
+    const QString dataTag = QTest::currentDataTag();
+    QString output = dataTag;
+    const qsizetype result = qt_urlRecode(output, input, QUrlDecodeForLocalFile);
+    if (expected.isNull()) {
+        QCOMPARE_LT(result, 0);
+        QCOMPARE(output, dataTag);
+
+        // an empty output becomes null
+        output = u""_s;
+        QVERIFY(!output.isNull());
+        QCOMPARE_LT(qt_urlRecode(output, input, QUrlDecodeForLocalFile), 0);
+        QVERIFY(output.isNull());
+
+        // other modes are not affected
+        output = dataTag;
+        QCOMPARE_GT(qt_urlRecode(output, input, QUrl::FullyDecoded), 0);
+        QCOMPARE_GE(qt_urlRecode(output, input, QUrl::PrettyDecoded), 0);
+        return;
+    }
+
+    QCOMPARE_GE(result, 0);
+    if (!result)
+        output += input;
+    QCOMPARE(output, dataTag + expected);
+
+    // starting from an empty string
+    output.clear();
+    if (!qt_urlRecode(output, input, QUrlDecodeForLocalFile))
+        output += input;
+    QCOMPARE(output, expected);
+}
