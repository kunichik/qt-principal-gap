+void tst_QUrlInternal::decodeForLocalFile_data()
+{
+    QTest::addColumn<QString>("input");
+    QTest::addColumn<QString>("expected");
+
+    QTest::newRow("empty") << QString() << QString();
+    QTest::newRow("plain") << u"/tmp/file.txt"_s << u"/tmp/file.txt"_s;
+    QTest::newRow("unencoded-unicode") << u"/tmp/f\u00e9"_s << u"/tmp/f\u00e9"_s;
+    QTest::newRow("space") << u"/tmp/a%20b"_s << u"/tmp/a b"_s;
+    QTest::newRow("percent") << u"/tmp/100%25"_s << u"/tmp/100%"_s;
+    QTest::newRow("lowercase-hex") << u"%3a%3f%23"_s << u":?#"_s;
+    QTest::newRow("delimiters") << u"%3A%3F%23%5B%5D%40"_s << u":?#[]@"_s;
+    QTest::newRow("control") << u"%01%1F%7F"_s << u"\x01\x1f\x7f"_s;
+#ifndef Q_OS_WIN
+    QTest::newRow("backslash") << u"/tmp/a%5Cb"_s << u"/tmp/a\\b"_s;
+#endif
+    QTest::newRow("utf8-2") << u"/tmp/f%C3%A9"_s << u"/tmp/f\u00e9"_s;
+    QTest::newRow("utf8-3") << u"%E2%82%AC"_s << u"\u20ac"_s;
+    QTest::newRow("utf8-4") << u"%F0%9F%98%80"_s << u"\U0001F600"_s;
+    QTest::newRow("utf8-max") << u"%F4%8F%BF%BF"_s << u"\U0010FFFF"_s;
+    QTest::newRow("utf8-mixed") << u"a%C3%A9b%20%E2%82%ACc"_s << u"a\u00e9b \u20acc"_s;
+
+    // badly-encoded input is copied verbatim, as with QUrl::FullyDecoded,
+    // regardless of where the bad sequence is
+    QTest::newRow("bad-%") << u"/tmp/%"_s << u"/tmp/%"_s;
+    QTest::newRow("bad-%z") << u"/tmp/%zz"_s << u"/tmp/%zz"_s;
+    QTest::newRow("bad-after-slash") << u"%2F%zz"_s << u"%2F%zz"_s;
+    QTest::newRow("bad-before-slash") << u"%zz%2F"_s << u"%zz%2F"_s;
+    QTest::newRow("bad-after-nul") << u"%00%"_s << u"%00%"_s;
+    QTest::newRow("bad-after-invalid-utf8") << u"%C3%"_s << u"%C3%"_s;
+}
+
+void tst_QUrlInternal::decodeForLocalFile()
+{
+    QFETCH(QString, input);
+    QFETCH(QString, expected);
+
+    // prepend some data to be sure that it remains there
+    QString output = QTest::currentDataTag();
+    expected.prepend(output);
+
+    const qsizetype r = qt_urlRecode(output, input, QUrlDecodeForLocalFile);
+    QCOMPARE_GE(r, 0);
+    if (!r)
+        output += input;
+    QCOMPARE(output, expected);
+}
+
+void tst_QUrlInternal::decodeForLocalFileNonCharacters_data()
+{
+    QTest::addColumn<QByteArray>("utf8");
+    QTest::addColumn<QString>("utf16");
+
+    extern void loadNonCharactersRows();
+    loadNonCharactersRows();
+}
+
+void tst_QUrlInternal::decodeForLocalFileNonCharacters()
+{
+    // non-characters are valid UTF-8 and therefore acceptable in a file name
+    QFETCH(QByteArray, utf8);
+    QFETCH(QString, utf16);
+    const QString input = QString::fromLatin1(utf8.toPercentEncoding());
+
+    QString output = QTest::currentDataTag();
+    QCOMPARE_GT(qt_urlRecode(output, input, QUrlDecodeForLocalFile), 0);
+    QCOMPARE(output, QTest::currentDataTag() + utf16);
+}
+
+void tst_QUrlInternal::decodeForLocalFileRefused_data()
+{
+    QTest::addColumn<QString>("input");
+
+    QTest::newRow("nul") << u"%00"_s;
+    QTest::newRow("nul-middle") << u"/tmp/a%00b"_s;
+    QTest::newRow("slash") << u"%2F"_s;
+    QTest::newRow("slash-lowercase") << u"%2f"_s;
+    QTest::newRow("slash-middle") << u"/tmp/..%2F..%2Fetc"_s;
+    QTest::newRow("slash-after-utf8") << u"%C3%A9%2F"_s;
+#ifdef Q_OS_WIN
+    QTest::newRow("backslash") << u"C:/tmp/..%5C..%5Cfile"_s;
+    QTest::newRow("backslash-lowercase") << u"%5c"_s;
+#endif
+    QTest::newRow("lone-continuation") << u"/tmp/%80"_s;
+    QTest::newRow("ff") << u"%FF"_s;
+    QTest::newRow("truncated-2") << u"%C3"_s;
+    QTest::newRow("truncated-3") << u"%E2%82"_s;
+    QTest::newRow("truncated-4") << u"%F0%9F%98"_s;
+    QTest::newRow("truncated-then-ascii") << u"%C3a"_s;
+    QTest::newRow("bad-continuation") << u"%C3%28"_s;
+    QTest::newRow("valid-then-truncated") << u"%C3%A9%C3"_s;
+    QTest::newRow("overlong-slash-2") << u"%C0%AF"_s;
+    QTest::newRow("overlong-slash-3") << u"%E0%80%AF"_s;
+    QTest::newRow("overlong-nul-2") << u"%C0%80"_s;
+    QTest::newRow("surrogate") << u"%ED%A0%80"_s;
+    QTest::newRow("above-max") << u"%F4%90%80%80"_s;
+    QTest::newRow("invalid-then-valid") << u"%80%C3%A9"_s;
+}
+
+static void checkDecodeForLocalFileRefused(const QString &input)
+{
+    // a non-empty appendTo is left unchanged
+    const QString prefix = QTest::currentDataTag();
+    QString output = prefix;
+    QCOMPARE_LT(qt_urlRecode(output, input, QUrlDecodeForLocalFile), 0);
+    QCOMPARE(output, prefix);
+
+    // an empty appendTo becomes null
+    output = u""_s;
+    QVERIFY(!output.isNull());
+    QCOMPARE_LT(qt_urlRecode(output, input, QUrlDecodeForLocalFile), 0);
+    QVERIFY(output.isNull());
+
+    // a null appendTo stays null
+    output = QString();
+    QCOMPARE_LT(qt_urlRecode(output, input, QUrlDecodeForLocalFile), 0);
+    QVERIFY(output.isNull());
+
+    // control: QUrl::FullyDecoded never refuses
+    output = prefix;
+    QCOMPARE_GE(qt_urlRecode(output, input, QUrl::FullyDecoded), 0);
+    QCOMPARE_GT(output.size(), prefix.size());
+}
+
+void tst_QUrlInternal::decodeForLocalFileRefused()
+{
+    QFETCH(QString, input);
+    checkDecodeForLocalFileRefused(input);
+    if (QTest::currentTestFailed())
+        return;
+
+    // the content around the bad sequence does not matter
+    checkDecodeForLocalFileRefused(u"/home/user/"_s + input + u"/file.txt"_s);
+}
+
+void tst_QUrlInternal::decodeForLocalFileRefusedInvalidUtf8_data()
+{
+    QTest::addColumn<QByteArray>("utf8");
+    QTest::addColumn<QString>("utf16");
+
+    extern void loadInvalidUtf8Rows();
+    loadInvalidUtf8Rows();
+
+    QTest::newRow("utf8-mix-4") << QByteArray("\xE0.A2\x80");
+    QTest::newRow("utf8-mix-5") << QByteArray("\xE0\xA2.80");
+    QTest::newRow("utf8-mix-6") << QByteArray("\xE0\xA2\x33");
+}
+
+void tst_QUrlInternal::decodeForLocalFileRefusedInvalidUtf8()
+{
+    QFETCH(QByteArray, utf8);
+    checkDecodeForLocalFileRefused(QString::fromLatin1(utf8.toPercentEncoding()));
+}
