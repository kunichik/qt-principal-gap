+void tst_QUrlInternal::decodeForLocalFileInvalidUtf8()
+{
+    QFETCH(QByteArray, utf8);
+    const QString input = utf8.toPercentEncoding();
+
+    const QString dataTag = QString::fromUtf8(QTest::currentDataTag());
+    QString output = dataTag;
+    QCOMPARE_LT(qt_urlRecode(output, input, QUrlDecodeForLocalFile), 0);
+    QCOMPARE(output, dataTag);
+
+    // also with valid data around it
+    output = dataTag;
+    QCOMPARE_LT(qt_urlRecode(output, "a%C3%A9" + input + "b%20", QUrlDecodeForLocalFile), 0);
+    QCOMPARE(output, dataTag);
+}
