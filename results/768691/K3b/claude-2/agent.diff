+void tst_QUrlInternal::decodeForLocalFile_data()
+{
+    QTest::addColumn<QString>("input");
+    QTest::addColumn<bool>("refused");
+    QTest::addColumn<QString>("expected");
+
+#ifdef Q_OS_WIN
+    constexpr bool OnWindows = true;
+#else
+    constexpr bool OnWindows = false;
+#endif
+
+    // same as QUrl::FullyDecoded
+    QTest::newRow("null") << QString() << false << QString();
+    QTest::newRow("empty") << u""_s << false << u""_s;
+    QTest::newRow("nothing-encoded") << u"/tmp/a b"_s << false << u"/tmp/a b"_s;
+    QTest::newRow("space") << u"/tmp/a%20b"_s << false << u"/tmp/a b"_s;
+    QTest::newRow("percent") << u"25%2525"_s << false << u"25%25"_s;
+    QTest::newRow("control") << u"%01%0D%0A%1F%7F"_s << false << u"\x01\r\n\x1f\x7f"_s;
+    QTest::newRow("delimiters") << u"%3A%3F%23%5B%5D%40"_s << false << u":?#[]@"_s;
+    QTest::newRow("lowercase-hex") << u"%3a%3f"_s << false << u":?"_s;
+    QTest::newRow("dots") << u"/tmp/%2E%2E/x"_s << false << u"/tmp/../x"_s;
+    QTest::newRow("unicode-decoded") << u"/tmp/R\u00e9sum\u00e9"_s << false << u"/tmp/R\u00e9sum\u00e9"_s;
+
+    // unlike QUrl::FullyDecoded, valid UTF-8 is decoded
+    QTest::newRow("utf8-2char") << u"R%C3%A9sum%C3%A9"_s << false << u"R\u00e9sum\u00e9"_s;
+    QTest::newRow("utf8-3char") << u"%E2%82%AC"_s << false << u"\u20ac"_s;
+    QTest::newRow("utf8-4char") << u"%F0%90%80%80"_s << false << u"\U00010000"_s;
+    QTest::newRow("utf8-4char-max") << u"%F4%8F%BF%BF"_s << false << u"\U0010FFFF"_s;
+    QTest::newRow("utf8-lowercase") << u"%c3%a9"_s << false << u"\u00e9"_s;
+    QTest::newRow("utf8-mixed") << u"%C3%A9%20%E2%82%AC/x"_s << false << u"\u00e9 \u20ac/x"_s;
+    QTest::newRow("utf8-fullwidth-solidus") << u"a%EF%BC%8Fb"_s << false << u"a\uff0fb"_s;
+
+    // unsafe decoded characters
+    QTest::newRow("nul") << u"a%00b"_s << true << QString();
+    QTest::newRow("nul-only") << u"%00"_s << true << QString();
+    QTest::newRow("slash") << u"a%2Fb"_s << true << QString();
+    QTest::newRow("slash-lowercase") << u"a%2fb"_s << true << QString();
+    QTest::newRow("slash-traversal") << u"..%2F..%2Fetc%2Fpasswd"_s << true << QString();
+    QTest::newRow("slash-after-valid") << u"%C3%A9%20%2F"_s << true << QString();
+    QTest::newRow("backslash") << u"a%5Cb"_s << OnWindows << (OnWindows ? QString() : u"a\\b"_s);
+
+    // invalid UTF-8 (more in decodeForLocalFileInvalidUtf8)
+    QTest::newRow("utf8-continuation") << u"%80"_s << true << QString();
+    QTest::newRow("utf8-ff") << u"%FF"_s << true << QString();
+    QTest::newRow("utf8-truncated") << u"a%C3"_s << true << QString();
+    QTest::newRow("utf8-truncated-before-ascii") << u"%C3a"_s << true << QString();
+    QTest::newRow("utf8-ascii-continuation") << u"%C3%28"_s << true << QString();
+    QTest::newRow("utf8-overlong-nul") << u"%C0%80"_s << true << QString();
+    QTest::newRow("utf8-overlong-slash") << u"%C0%AF"_s << true << QString();
+    QTest::newRow("utf8-overlong-slash-3") << u"%E0%80%AF"_s << true << QString();
+    QTest::newRow("utf8-surrogate") << u"%ED%A0%80"_s << true << QString();
+    QTest::newRow("utf8-above-max") << u"%F4%90%80%80"_s << true << QString();
+
+    // badly-encoded input is not decoded at all, as in QUrl::FullyDecoded mode,
+    // so there is nothing unsafe in the result
+    QTest::newRow("bad-encoding") << u"%zz"_s << false << u"%zz"_s;
+    QTest::newRow("bad-encoding-truncated") << u"a%2"_s << false << u"a%2"_s;
+    QTest::newRow("bad-encoding-after-slash") << u"%2F%zz"_s << false << u"%2F%zz"_s;
+    QTest::newRow("bad-encoding-after-nul") << u"%00a%2"_s << false << u"%00a%2"_s;
