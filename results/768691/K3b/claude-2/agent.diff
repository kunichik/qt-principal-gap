+void tst_QUrlInternal::decodeForLocalFile()
+{
+    QFETCH(QString, input);
+    QFETCH(bool, refused);
+    QFETCH(QString, expected);
+
+    // the mode is a variant of QUrl::FullyDecoded
+    QCOMPARE(QUrlDecodeForLocalFile & QUrl::FullyDecoded, QUrl::FullyDecoded);
+
+    // prepend some data to be sure that it remains there, even on refusal
+    const QString dataTag = QString::fromUtf8(QTest::currentDataTag());
+    QString output = dataTag;
+    qsizetype r = qt_urlRecode(output, input, QUrlDecodeForLocalFile);
+    if (refused) {
+        QCOMPARE_LT(r, 0);
+        QCOMPARE(output, dataTag);
+    } else {
+        QCOMPARE_GE(r, 0);
+        if (r == 0)
+            output += input;
+        QCOMPARE(output, dataTag + expected);
+        QCOMPARE(r, r ? expected.size() : 0);
+    }
+
+    // an empty appendTo must be null after a refusal
+    output = u""_s;
+    QVERIFY(!output.isNull());
+    r = qt_urlRecode(output, input, QUrlDecodeForLocalFile);
+    if (refused) {
+        QCOMPARE_LT(r, 0);
+        QVERIFY(output.isEmpty());
+        QVERIFY(output.isNull());
+    } else {
+        QCOMPARE_GE(r, 0);
+        if (r == 0)
+            output += input;
+        QCOMPARE(output, expected);
+    }
+
+    // QUrl::FullyDecoded never refuses
+    output = dataTag;
+    r = qt_urlRecode(output, input, QUrl::FullyDecoded);
+    QCOMPARE_GE(r, 0);
+}
