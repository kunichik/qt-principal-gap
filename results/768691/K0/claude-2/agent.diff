+void tst_QUrlInternal::decodeForLocalFile()
+{
+    QFETCH(QString, input);
+    QFETCH(QString, expected);
+    QFETCH(bool, success);
+
+    static_assert((QUrlDecodeForLocalFile & QUrl::FullyDecoded) == QUrl::FullyDecoded);
+
+    // prepend some data to be sure that it remains there
+    const QString dataTag = QTest::currentDataTag();
+    QString output = dataTag;
+
+    const qsizetype result = qt_urlRecode(output, input, QUrlDecodeForLocalFile);
+    if (!success) {
+        QCOMPARE_LT(result, 0);
+        QCOMPARE(output, dataTag);          // unchanged on failure
+        return;
+    }
+
+    QCOMPARE_GE(result, 0);
+    QCOMPARE(result, output.size() - dataTag.size());
+    if (result == 0)
+        output += input;
+    QCOMPARE(output, dataTag + expected);
+
+    // for pure ASCII results, this must be the same as QUrl::FullyDecoded
+    if (QtPrivate::isAscii(QStringView(expected))) {
+        QString fullyDecoded = dataTag;
+        if (!qt_urlRecode(fullyDecoded, input, QUrl::FullyDecoded))
+            fullyDecoded += input;
+        QCOMPARE(output, fullyDecoded);
+    }
+}
