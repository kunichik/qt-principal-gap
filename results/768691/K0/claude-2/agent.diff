+/*!
+    \internal
+
+    Decodes the percent-encoded string \a in for use as a local file path,
+    appending the result to \a appendTo, and returns the number of characters
+    appended (0 if \a in contains no percent-encoded sequences, in which case
+    nothing is appended). This is the implementation of QUrlDecodeForLocalFile.
+
+    Unlike decode(), every run of consecutive percent-encoded sequences is
+    decoded as UTF-8. This function fails, returning -1 and leaving \a appendTo
+    unchanged, if decoding would produce a character that is unsafe in a local
+    file path:
+
+    \list
+      \li a NUL character (%00);
+      \li a directory separator ('/' as %2F, and also '\\' as %5C on Windows);
+      \li percent-encoded bytes that do not form valid UTF-8.
+    \endlist
+
+    Like decode(), if \a in contains a '%' anywhere that is not followed by
+    two hexadecimal digits, \a in is appended undecoded and its size is
+    returned. Such a result contains no decoded characters, so it is not
+    unsafe.
+*/
+static qsizetype decodeForLocalFile(QString &appendTo, QStringView in)
+{
+    const char16_t *const begin = in.utf16();
+    const char16_t *const end = begin + in.size();
+    const char16_t *input = QtPrivate::qustrchr(in, '%');
+
+    if (Q_LIKELY(input == end))
+        return 0;           // nothing to do, it was already decoded!
+
+    const qsizetype origSize = appendTo.size();
+
+    // decoding never makes the string longer
+    appendTo.reserve(origSize + in.size());
+    appendTo.append(QStringView(begin, input));
+
+    // Don't stop at the first unsafe sequence: bad percent-encoding anywhere
+    // takes precedence, so the result does not depend on the order of the two.
+    bool unsafe = false;
+    QVarLengthArray<char, 64> bytes;
+    while (input != end) {
+        // decode a run of consecutive percent-encoded sequences
+        Q_ASSERT(*input == '%');
+        bytes.clear();
+        do {
+            if (Q_UNLIKELY(end - input < 3 || !isHex(input[1]) || !isHex(input[2]))) {
+                // badly-encoded data: same as decode(), copy the input verbatim
+                appendTo.truncate(origSize);
+                appendTo.append(in);
+                return in.size();
+            }
+
+            const char c = char(decodeNibble(input[1]) << 4 | decodeNibble(input[2]));
+            if (c == '\0' || c == '/')
+                unsafe = true;
+#ifdef Q_OS_WIN
+            if (c == '\\')
+                unsafe = true;
+#endif
+            bytes.append(c);
+            input += 3;
+        } while (input != end && *input == '%');
+
+        const QByteArrayView utf8(bytes.constData(), bytes.size());
+        if (!QUtf8::isValidUtf8(utf8).isValidUtf8) {
+            unsafe = true;
+        } else if (!unsafe) {
+            // keep a decoded U+FEFF, it's part of the file name
+            QStringConverter::State state(QStringConverter::Flag::Stateless
+                                          | QStringConverter::Flag::ConvertInitialBom);
+            appendTo += QUtf8::convertToUnicode(utf8, &state);
+        }
+
+        // copy up to the next percent
+        const char16_t *next = QtPrivate::qustrchr(QStringView(input, end), '%');
+        if (!unsafe)
+            appendTo.append(QStringView(input, next));
+        input = next;
+    }
+
+    if (unsafe) {
+        appendTo.truncate(origSize);
+        return -1;
+    }
+    return appendTo.size() - origSize;
+}
