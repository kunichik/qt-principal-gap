+namespace {
+struct QUrlLocalFileUtf8Traits : public QUrlUtf8Traits
+{
+    // Non-characters are valid UTF-8 and may appear in file names.
+    static const bool allowNonCharacters = true;
+};
+} // unnamed namespace
+
+static inline bool isUnsafeInLocalFile(char16_t c)
+{
+    if (c == u'\0' || c == u'/')
+        return true;
+#ifdef Q_OS_WIN
+    if (c == u'\\')
+        return true;
+#endif
+    return false;
+}
+
+/*!
+    \internal
+
+    Like decode(), but for QUrlDecodeForLocalFile: percent-encoded UTF-8
+    sequences are decoded to their UTF-16 equivalents. Returns -1, leaving \a
+    appendTo unchanged, if the decoded string would not be safe to use as a
+    local file path: that is, if a percent-encoded sequence decodes to NUL, to
+    a slash (or a backslash, on Windows), or the percent-encoded bytes are not
+    valid UTF-8 (this includes overlong sequences and encoded surrogates).
+
+    If the input contains a badly-encoded percent sequence, nothing is decoded
+    and the input is copied unchanged, as decode() does.
+*/
+static qsizetype decodeForLocalFile(QString &appendTo, QStringView in)
+{
+    const char16_t *begin = in.utf16();
+    const char16_t *end = begin + in.size();
+    const char16_t *input = QtPrivate::qustrchr(in, u'%');
+
+    if (Q_LIKELY(input == end))
+        return 0;           // nothing to do, it was already decoded!
+
+    // Check for bad encodings first, so the result doesn't depend on whether
+    // a bad sequence appears before or after one we'd reject.
+    for (const char16_t *ptr = input; ptr != end; ++ptr) {
+        if (*ptr == u'%' && (end - ptr < 3 || !isHex(ptr[1]) || !isHex(ptr[2])))
+            return decode(appendTo, in);
+    }
+
+    // decoding never makes the string longer
+    const qsizetype origSize = appendTo.size();
+    appendTo.resize(origSize + (end - begin));
+    char16_t *const start = reinterpret_cast<char16_t *>(appendTo.data()) + origSize;
+    char16_t *output = std::copy(begin, input, start);
+
+    while (input != end) {
+        if (*input != u'%') {
+            *output++ = *input++;
+            continue;
+        }
+
+        const char16_t decoded = decodePercentEncoding(input);
+        input += 3;
+        bool ok;
+        if (decoded < 0x80) {
+            ok = !isUnsafeInLocalFile(decoded);
+            *output++ = decoded;
+        } else {
+            ok = QUtf8Functions::fromUtf8<QUrlLocalFileUtf8Traits>(uchar(decoded), output,
+                                                                   input, end) >= 0;
+        }
+        if (Q_UNLIKELY(!ok)) {
+            appendTo.truncate(origSize);
+            return -1;
+        }
+    }
+
+    appendTo.truncate(origSize + (output - start));
+    return output - start;
+}
