+    QTest::newRow("empty") << u""_s << u""_s;
+    QTest::newRow("no-percent") << u"/tmp/a b/c"_s << u"/tmp/a b/c"_s;
+    QTest::newRow("unicode") << u"/tmp/é€"_s << u"/tmp/é€"_s;
+    QTest::newRow("ascii") << u"%41%62%7a"_s << u"Abz"_s;
+    QTest::newRow("percent") << u"%25"_s << u"%"_s;
+    QTest::newRow("percent-sequence") << u"%252F"_s << u"%2F"_s;
+    QTest::newRow("space") << u"/tmp/a%20b"_s << u"/tmp/a b"_s;
+    QTest::newRow("dots") << u"/tmp/%2E%2E/x"_s << u"/tmp/../x"_s;
+    QTest::newRow("delimiters") << u"%3A%3F%23%5B%5D%40"_s << u":?#[]@"_s;
+    QTest::newRow("control") << u"%01%1F%7F"_s << u"\x01\x1f\x7f"_s;
+#ifndef Q_OS_WIN
+    QTest::newRow("backslash") << u"a%5Cb"_s << u"a\\b"_s;
+#endif
+    QTest::newRow("unencoded-unicode-mixed") << u"é%41é"_s << u"éAé"_s;
+    QTest::newRow("utf8-2") << u"/tmp/%C3%A9"_s << u"/tmp/é"_s;
+    QTest::newRow("utf8-3") << u"%E2%82%AC/x"_s << u"€/x"_s;
+    QTest::newRow("utf8-4") << u"%F0%9F%98%80"_s << u"\U0001F600"_s;
+    QTest::newRow("utf8-lowercase") << u"%c3%a9"_s << u"é"_s;
+    QTest::newRow("utf8-adjacent") << u"%C3%A9%C3%A9"_s << u"éé"_s;
+    QTest::newRow("utf8-max") << u"%F4%8F%BF%BD"_s << u"\U0010FFFD"_s;
