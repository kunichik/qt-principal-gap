+void tst_QUrlInternal::decodeForLocalFileInvalidUtf8()
+{
+    QFETCH(QByteArray, utf8);
+    const QString input = QString::fromLatin1(utf8.toPercentEncoding());
+
+    QString output = QTest::currentDataTag();
+    QCOMPARE_LT(qt_urlRecode(output, input, QUrl::FullyDecoded | QUrlDecodeForLocalFile), 0);
+    QCOMPARE(output, QTest::currentDataTag());
+}
