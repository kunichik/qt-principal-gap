+void tst_QUrlInternal::decodeForLocalFile_data()
+{
+    QTest::addColumn<QString>("input");
+    QTest::addColumn<QString>("expected");  // null if the decoding must fail
+
+    QTest::newRow("empty") << "" << "";
+    QTest::newRow("nothing-encoded") << "/tmp/foo bar" << "/tmp/foo bar";
+    QTest::newRow("unicode-not-encoded") << u"/tmp/été"_s << u"/tmp/été"_s;
+    QTest::newRow("space") << "/tmp/foo%20bar" << "/tmp/foo bar";
+    QTest::newRow("percent") << "/tmp/100%25" << "/tmp/100%";
+    QTest::newRow("double-percent") << "/tmp/%2525" << "/tmp/%25";
+    QTest::newRow("reserved") << "/tmp/%3F%23%5B%5D%3A" << "/tmp/?#[]:";
+    QTest::newRow("control") << "/tmp/%01%1F%7F" << u"/tmp/\x01\x1f\x7f"_s;
+    QTest::newRow("lowercase-hex") << "/tmp/%c3%a9" << u"/tmp/é"_s;
+    QTest::newRow("dot") << "/tmp/%2E%2E" << "/tmp/..";
+#ifndef Q_OS_WIN
+    QTest::newRow("backslash") << "/tmp/a%5Cb" << "/tmp/a\\b";
+#endif
+
+    // bad percent-encoding is left alone, as in the regular FullyDecoded mode
+    QTest::newRow("bad-%") << "/tmp/%" << "/tmp/%";
+    QTest::newRow("bad-%z") << "/tmp/%zz%2F" << "/tmp/%zz%2F";
+
+    // valid UTF-8 is decoded
+    QTest::newRow("utf8-2") << "/tmp/%C3%A9t%C3%A9" << u"/tmp/été"_s;
+    QTest::newRow("utf8-3") << "/tmp/%E2%82%AC" << u"/tmp/€"_s;
+    QTest::newRow("utf8-4") << "/tmp/%F0%9F%98%80" << u"/tmp/\U0001F600"_s;
+    QTest::newRow("utf8-max") << "%F4%8F%BF%BF" << u"\U0010FFFF"_s;
+    QTest::newRow("utf8-noncharacter") << "%EF%BF%BF" << u"￿"_s;
+    QTest::newRow("utf8-then-ascii") << "%C3%A9%41" << u"éA"_s;
+
+    // forbidden characters
+    QTest::newRow("nul") << "/tmp/a%00b" << QString();
+    QTest::newRow("nul-only") << "%00" << QString();
+    QTest::newRow("slash") << "/tmp/a%2Fb" << QString();
+    QTest::newRow("slash-lowercase") << "/tmp/a%2fb" << QString();
+    QTest::newRow("slash-after-utf8") << "/tmp/%C3%A9%2F" << QString();
+#ifdef Q_OS_WIN
+    QTest::newRow("backslash") << "/tmp/a%5Cb" << QString();
+    QTest::newRow("backslash-lowercase") << "/tmp/a%5cb" << QString();
+#endif
+
+    // overlong encodings of the forbidden characters
+    QTest::newRow("overlong-nul") << "/tmp/%C0%80" << QString();
+    QTest::newRow("overlong-slash-2") << "/tmp/%C0%AF" << QString();
+    QTest::newRow("overlong-slash-3") << "/tmp/%E0%80%AF" << QString();
+    QTest::newRow("overlong-slash-4") << "/tmp/%F0%80%80%AF" << QString();
+    QTest::newRow("overlong-backslash") << "/tmp/%C1%9C" << QString();
+
+    // invalid UTF-8
+    QTest::newRow("lone-continuation") << "/tmp/%80" << QString();
+    QTest::newRow("latin1") << "/tmp/%E9t%E9" << QString();
+    QTest::newRow("truncated-2") << "/tmp/%C3" << QString();
+    QTest::newRow("truncated-3") << "/tmp/%E2%82" << QString();
+    QTest::newRow("truncated-before-ascii") << "/tmp/%E2%82x" << QString();
+    QTest::newRow("truncated-before-percent") << "/tmp/%E2%82%41" << QString();
+    QTest::newRow("surrogate") << "/tmp/%ED%A0%80" << QString();
+    QTest::newRow("above-max") << "/tmp/%F4%90%80%80" << QString();
+    QTest::newRow("bad-lead") << "/tmp/%FF" << QString();
+}
