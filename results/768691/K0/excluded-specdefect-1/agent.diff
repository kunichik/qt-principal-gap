+void tst_QUrlInternal::decodeForLocalFile()
+{
+    QFETCH(QString, input);
+    QFETCH(QString, expected);
+    const QUrl::ComponentFormattingOptions mode = QUrl::FullyDecoded | QUrlDecodeForLocalFile;
+
+    // prepend some data to be sure that it remains there
+    const QString dataTag = QString::fromUtf8(QTest::currentDataTag());
+    QString output = dataTag;
+
+    const qsizetype result = qt_urlRecode(output, input, mode);
+    if (expected.isNull()) {
+        QCOMPARE_LT(result, 0);
+        QCOMPARE(output, dataTag);
+        return;
+    }
+
+    QCOMPARE_GE(result, 0);
+    QCOMPARE(output.size(), dataTag.size() + result);
+    if (result == 0)
+        output += input;
+    QCOMPARE(output, dataTag + expected);
+
+    // the option has no effect unless combined with QUrl::FullyDecoded
+    output.clear();
+    QString control;
+    if (!qt_urlRecode(output, input, QUrlDecodeForLocalFile))
+        output = input;
+    if (!qt_urlRecode(control, input, QUrl::PrettyDecoded))
+        control = input;
+    QCOMPARE(output, control);
+}
