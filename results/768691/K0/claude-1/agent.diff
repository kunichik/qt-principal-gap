+void tst_QUrlInternal::decodeForLocalFile_data()
+{
+    QTest::addColumn<QString>("input");
+    QTest::addColumn<QString>("expected");
+
+    QTest::newRow("empty") << QString() << QString();
+    QTest::newRow("no-percent") << u"/tmp/file.txt"_s << u"/tmp/file.txt"_s;
+    QTest::newRow("literal-slashes") << u"/a/b/c"_s << u"/a/b/c"_s;
+    QTest::newRow("space") << u"/tmp/a%20b"_s << u"/tmp/a b"_s;
+    QTest::newRow("percent") << u"/tmp/100%25"_s << u"/tmp/100%"_s;
+    QTest::newRow("lowercase-hex") << u"%2a%7e"_s << u"*~"_s;
+    QTest::newRow("reserved") << u"%3A%3F%23%5B%5D%40"_s << u":?#[]@"_s;
+    QTest::newRow("control") << u"a%01b%1Fc%7F"_s << u"a\x01" "b\x1f" "c\x7f"_s;
+    QTest::newRow("dot-segments") << u"/%2E%2E/%2e"_s << u"/../."_s;
+#ifndef Q_OS_WIN
+    QTest::newRow("backslash") << u"a%5Cb"_s << u"a\\b"_s;
+#endif
+
+    // already-decoded Unicode is passed through
+    QTest::newRow("unicode-decoded") << u"/tmp/\u00e9\U0001F600"_s << u"/tmp/\u00e9\U0001F600"_s;
+
+    // percent-encoded UTF-8 is decoded
+    QTest::newRow("utf8-2") << u"%C3%A9"_s << u"\u00e9"_s;
+    QTest::newRow("utf8-3") << u"%E2%82%AC"_s << u"\u20ac"_s;
+    QTest::newRow("utf8-4") << u"%F0%9F%98%80"_s << u"\U0001F600"_s;
+    QTest::newRow("utf8-max") << u"%F4%8F%BF%BD"_s << u"\U0010FFFD"_s;
+    QTest::newRow("utf8-mixed") << u"/x%C3%A9y/%E2%82%ACz"_s << u"/x\u00e9y/\u20acz"_s;
+
+    // bad percent-encoding: like QUrl::FullyDecoded, nothing gets decoded
+    QTest::newRow("bad-percent") << u"%2F%"_s << u"%2F%"_s;
+    QTest::newRow("bad-percent-hex") << u"%2F%zz"_s << u"%2F%zz"_s;
+    QTest::newRow("bad-percent-utf8") << u"%C3%A"_s << u"%C3%A"_s;
+}
+
+void tst_QUrlInternal::decodeForLocalFile()
+{
+    QFETCH(QString, input);
+    QFETCH(QString, expected);
+
+    // prepend some data to be sure that it remains there
+    QString output = QTest::currentDataTag();
+    qsizetype ret = qt_urlRecode(output, input, QUrlDecodeForLocalFile);
+    QCOMPARE_GE(ret, 0);
+    if (!ret)
+        output += input;
+    QCOMPARE(output, QTest::currentDataTag() + expected);
+    if (ret)
+        QCOMPARE(ret, expected.size());
+}
+
