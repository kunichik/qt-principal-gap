+/*!
+    \internal
+
+    Like decode(), this function decodes the percent-encoded string \a in by
+    appending the result to \a appendTo, returning the number of characters
+    appended (0 if \a in contains nothing to decode). Unlike decode(), it is
+    meant to produce a string to be used as a local file path, so it returns
+    -1, leaving \a appendTo unchanged, if:
+
+    \list
+      \li the result would contain a NUL character, whether it was
+          percent-encoded or not;
+      \li a percent-encoded sequence decodes to a path separator ('/', and
+          also '\\' on Windows);
+      \li the percent-encoded sequences from %80 to %FF are not well-formed
+          UTF-8 (this includes overlong forms, surrogates and code points
+          above U+10FFFF).
+    \endlist
+
+    Bad percent-encoding is treated like decode() does: the input is copied
+    verbatim (subject to the NUL check above).
+*/
+static qsizetype decodeForLocalFile(QString &appendTo, QStringView in)
+{
+    const char16_t *begin = in.utf16();
+    const char16_t *end = begin + in.size();
+    bool hasPercent = false;
+    bool badEncoding = false;
+
+    // First pass: reject literal NULs and determine whether this is
+    // well-formed percent-encoding (if it isn't, we don't decode at all).
+    for (const char16_t *ptr = begin; ptr != end; ++ptr) {
+        if (*ptr == u'\0')
+            return -1;
+        if (*ptr != u'%')
+            continue;
+        hasPercent = true;
+        if (end - ptr < 3 || !isHex(ptr[1]) || !isHex(ptr[2]))
+            badEncoding = true;
+    }
+
+    if (!hasPercent)
+        return 0;           // nothing to do, it was already decoded!
+
+    if (badEncoding) {
+        // badly-encoded data
+        appendTo.append(in);
+        return in.size();
+    }
+
+    // decoding never makes the string longer
+    const qsizetype origSize = appendTo.size();
+    appendTo.resize(origSize + in.size());
+    char16_t *const outputStart = reinterpret_cast<char16_t *>(appendTo.data()) + origSize;
+    char16_t *output = outputStart;
+
+    for (const char16_t *input = begin; input != end; ) {
+        if (*input != u'%') {
+            *output++ = *input++;
+            continue;
+        }
+
+        const char16_t decoded = decodePercentEncoding(input);
+        input += 3;
+        if (decoded < 0x80) {
+            if (decoded == u'\0' || decoded == u'/')
+                goto fail;
+#ifdef Q_OS_WIN
+            if (decoded == u'\\')
+                goto fail;
+#endif
+            *output++ = decoded;
+        } else if (QUtf8Functions::fromUtf8<QUrlLocalFileUtf8Traits>(decoded, output, input,
+                                                                      end) < 0) {
+            goto fail;
+        }
+    }
+
+    appendTo.truncate(origSize + (output - outputStart));
+    return output - outputStart;
+
+fail:
+    appendTo.truncate(origSize);
+    return -1;
+}
