+    QTest::newRow("encoded-nul-at-end") << u"/tmp/a%00"_s;
+    QTest::newRow("literal-nul") << QStringLiteral("/tmp/a\0b");
+    QTest::newRow("literal-nul-with-percent") << QStringLiteral("/tmp/a%20\0b");
+    QTest::newRow("literal-nul-bad-percent") << QStringLiteral("/tmp/a%\0b");
+    QTest::newRow("encoded-slash") << u"/tmp/a%2Fb"_s;
+    QTest::newRow("encoded-slash-lowercase") << u"/tmp/a%2fb"_s;
+    QTest::newRow("encoded-slash-only") << u"%2F"_s;
+    QTest::newRow("encoded-slash-after-decoding") << u"/tmp/%C3%A9%2F..%2F"_s;
+    QTest::newRow("double-dot-traversal") << u"..%2F..%2Fetc%2Fpasswd"_s;
