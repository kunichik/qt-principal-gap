+void tst_QUrlInternal::decodeForLocalFile_data()
+{
+    QTest::addColumn<QString>("input");
+    QTest::addColumn<bool>("ok");
+    QTest::addColumn<QString>("expected");
+
+    QTest::newRow("empty") << QString() << true << QString();
+    QTest::newRow("plain") << u"foo"_s << true << u"foo"_s;
+    QTest::newRow("unencoded-slashes") << u"/foo/bar/"_s << true << u"/foo/bar/"_s;
+    QTest::newRow("space") << u"foo%20bar"_s << true << u"foo bar"_s;
+    QTest::newRow("percent") << u"100%25"_s << true << u"100%"_s;
+    QTest::newRow("encoded-percent-2F") << u"a%252Fb"_s << true << u"a%2Fb"_s;
+    QTest::newRow("encoded-percent-00") << u"a%2500b"_s << true << u"a%00b"_s;
+    QTest::newRow("delimiters") << u"%3A%3F%23%5B%5D%40"_s << true << u":?#[]@"_s;
+    QTest::newRow("control") << u"%01%1F%7F"_s << true << u"\x01\x1f\x7f"_s;
+    QTest::newRow("unencoded-unicode") << u"/r\u00e9sum\u00e9"_s << true << u"/r\u00e9sum\u00e9"_s;
+    QTest::newRow("utf8-2bytes") << u"r%C3%A9sum%c3%a9"_s << true << u"r\u00e9sum\u00e9"_s;
+    QTest::newRow("utf8-3bytes") << u"%E2%82%AC"_s << true << u"\u20ac"_s;
+    QTest::newRow("utf8-4bytes") << u"%F0%9F%98%80"_s << true << u"\U0001F600"_s;
+    QTest::newRow("utf8-replacement-char") << u"%EF%BF%BD"_s << true << u"\ufffd"_s;
+    QTest::newRow("utf8-max") << u"%F4%8F%BF%BF"_s << true << u"\U0010FFFF"_s;
+
+    // bad percent-encoding: copied undecoded, like QUrl::FullyDecoded
+    QTest::newRow("bad-encoding") << u"a%"_s << true << u"a%"_s;
+    QTest::newRow("bad-encoding-after-2F") << u"%2F%"_s << true << u"%2F%"_s;
+    QTest::newRow("bad-encoding-after-00") << u"%00%zz"_s << true << u"%00%zz"_s;
+    QTest::newRow("bad-encoding-after-bad-utf8") << u"%FF%G"_s << true << u"%FF%G"_s;
+    QTest::newRow("bad-encoding-in-utf8") << u"%C3%A"_s << true << u"%C3%A"_s;
+
+    // unsafe characters
+    QTest::newRow("nul") << u"a%00b"_s << false << QString();
+    QTest::newRow("nul-only") << u"%00"_s << false << QString();
+    QTest::newRow("slash") << u"a%2Fb"_s << false << QString();
+    QTest::newRow("slash-lowercase") << u"a%2fb"_s << false << QString();
+    QTest::newRow("slash-only") << u"%2F"_s << false << QString();
+    QTest::newRow("slash-at-end") << u"/foo/bar%2F"_s << false << QString();
+    QTest::newRow("dotdot-slash") << u"/foo/..%2F..%2Fetc"_s << false << QString();
+    QTest::newRow("slash-after-utf8") << u"%C3%A9%2F"_s << false << QString();
+    QTest::newRow("slash-before-safe") << u"%2F%20"_s << false << QString();
+#ifdef Q_OS_WIN
+    QTest::newRow("backslash") << u"a%5Cb"_s << false << QString();
+    QTest::newRow("backslash-lowercase") << u"a%5cb"_s << false << QString();
+#else
+    QTest::newRow("backslash") << u"a%5Cb"_s << true << u"a\\b"_s;
+    QTest::newRow("backslash-lowercase") << u"a%5cb"_s << true << u"a\\b"_s;
+#endif
+
+    // invalid UTF-8 (see also decodeForLocalFileInvalidUtf8)
+    QTest::newRow("lone-continuation") << u"a%80b"_s << false << QString();
+    QTest::newRow("lone-lead") << u"a%C3"_s << false << QString();
+    QTest::newRow("lead-then-unencoded") << u"%C3a"_s << false << QString();
+    QTest::newRow("lead-then-unencoded-continuation") << u"%C3\u00a9"_s << false << QString();
+    QTest::newRow("lead-then-ascii") << u"%C3%41"_s << false << QString();
+    QTest::newRow("overlong-slash") << u"%C0%AF"_s << false << QString();
+    QTest::newRow("overlong-slash-3bytes") << u"%E0%80%AF"_s << false << QString();
+    QTest::newRow("overlong-nul") << u"%C0%80"_s << false << QString();
+    QTest::newRow("surrogate") << u"%ED%A0%80"_s << false << QString();
+    QTest::newRow("beyond-unicode") << u"%F4%90%80%80"_s << false << QString();
+    QTest::newRow("ff") << u"%FF"_s << false << QString();
