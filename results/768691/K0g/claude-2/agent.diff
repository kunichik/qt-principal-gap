+void tst_QUrlInternal::decodeForLocalFile()
+{
+    QFETCH(QString, input);
+    QFETCH(bool, ok);
+    QFETCH(QString, expected);
+
+    static_assert((QUrlDecodeForLocalFile & QUrl::FullyDecoded) == QUrl::FullyDecoded);
+
+    // prepend some data to be sure that it remains there
+    const QString dataTag = QString::fromLatin1(QTest::currentDataTag());
+    QString output = dataTag;
+
+    qsizetype result = qt_urlRecode(output, input, QUrlDecodeForLocalFile);
+    if (ok) {
+        QCOMPARE_GE(result, 0);
+        QCOMPARE(output.size(), dataTag.size() + result);
+        if (result == 0)
+            output += input;
+        QCOMPARE(output, dataTag + expected);
+    } else {
+        QCOMPARE_LT(result, 0);
+        QCOMPARE(output, dataTag);
+    }
+
+    // QUrl::FullyDecoded never fails
+    output = dataTag;
+    QCOMPARE_GE(qt_urlRecode(output, input, QUrl::FullyDecoded), 0);
+}
+
+void tst_QUrlInternal::decodeForLocalFileInvalidUtf8_data()
+{
+    QTest::addColumn<QByteArray>("utf8");
+
+    extern void loadInvalidUtf8Rows();
+    loadInvalidUtf8Rows();
+
+    QTest::newRow("utf8-mix-4") << QByteArray("\xE0.A2\x80");
+    QTest::newRow("utf8-mix-5") << QByteArray("\xE0\xA2.80");
+    QTest::newRow("utf8-mix-6") << QByteArray("\xE0\xA2\x33");
+}
+
+void tst_QUrlInternal::decodeForLocalFileInvalidUtf8()
+{
+    QFETCH(QByteArray, utf8);
+    const QString input = QString::fromLatin1(utf8.toPercentEncoding());
+
+    const QString dataTag = QString::fromLatin1(QTest::currentDataTag());
+    QString output = dataTag;
+    QCOMPARE_LT(qt_urlRecode(output, input, QUrlDecodeForLocalFile), 0);
+    QCOMPARE(output, dataTag);
+
+    // same with valid data before and after
+    output = dataTag;
+    QCOMPARE_LT(qt_urlRecode(output, u"%C3%A9" + input + u"%20x", QUrlDecodeForLocalFile), 0);
+    QCOMPARE(output, dataTag);
+}
+
+void tst_QUrlInternal::decodeForLocalFileNonCharacters_data()
+{
+    QTest::addColumn<QByteArray>("utf8");
+    QTest::addColumn<QString>("utf16");
+
+    extern void loadNonCharactersRows();
+    loadNonCharactersRows();
+}
+
+void tst_QUrlInternal::decodeForLocalFileNonCharacters()
+{
+    // non-characters are valid UTF-8, so they must be decoded
+    QFETCH(QByteArray, utf8);
+    QFETCH(QString, utf16);
+    const QString input = QString::fromLatin1(utf8.toPercentEncoding());
+
+    const QString dataTag = QString::fromLatin1(QTest::currentDataTag());
+    QString output = dataTag;
+    QCOMPARE_GT(qt_urlRecode(output, input, QUrlDecodeForLocalFile), 0);
+    QCOMPARE(output, dataTag + utf16);
+}
