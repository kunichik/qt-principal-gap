+void tst_QUrlInternal::decodeForLocalFile()
+{
+    QFETCH(QString, input);
+    QFETCH(QString, expected);
+
+    QVERIFY((QUrlDecodeForLocalFile & QUrl::FullyDecoded) == QUrl::FullyDecoded);
+
+    // prepend some data to be sure that it remains there
+    const QString prefix = QString::fromLatin1(QTest::currentDataTag());
+    QString output = prefix;
+
+    const qsizetype ret = qt_urlRecode(output, input, QUrlDecodeForLocalFile);
+    if (expected.isNull()) {
+        QCOMPARE_LT(ret, 0);
+        QCOMPARE(output, prefix);
+        return;
+    }
+
+    QCOMPARE_GE(ret, 0);
+    QCOMPARE(output.size(), prefix.size() + ret);
+    if (ret == 0)
+        output += input;
+    QCOMPARE(output, prefix + expected);
+
+    // the result must agree with FullyDecoded for anything without UTF-8
+    bool hasUtf8 = false;
+    for (qsizetype i = 0; i + 1 < input.size(); ++i) {
+        if (input.at(i) == u'%' && input.at(i + 1).unicode() >= u'8')
+            hasUtf8 = true;
+    }
+    if (!hasUtf8) {
+        QString fullyDecoded = prefix;
+        if (!qt_urlRecode(fullyDecoded, input, QUrl::FullyDecoded))
+            fullyDecoded += input;
+        QCOMPARE(output, fullyDecoded);
+    }
+}
