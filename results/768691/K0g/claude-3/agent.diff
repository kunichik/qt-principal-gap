+static inline bool isUnsafeForLocalFile(char16_t c)
+{
+    if (c == u'\0' || c == u'/')
+        return true;
+#ifdef Q_OS_WIN
+    if (c == u'\\')
+        return true;
+#endif
+    return false;
+}
+
+/*!
+    \internal
+
+    Like decode(), this function decodes a percent-encoded string located in
+    \a in by appending each character to \a appendTo, but it is meant for
+    strings that will be used as local file paths. It returns the number of
+    characters appended, or 0 if \a in contains nothing to decode.
+
+    Unlike decode(), percent-encoded sequences of bytes from %80 to %FF are
+    decoded as UTF-8. Non-characters are accepted, since they are valid UTF-8.
+
+    It returns -1 and leaves \a appendTo unchanged if decoding would produce
+    a string that is not safe to use as a local file path, that is, if any of
+    the percent-encoded sequences:
+    \list
+      \li decodes to NUL (%00) or a slash (%2F);
+      \li decodes to a backslash (%5C), on Windows only;
+      \li is not part of a valid UTF-8 sequence (including overlong forms,
+          surrogates and sequences that are truncated or interrupted by
+          non-encoded characters).
+    \endlist
+
+    Characters that were not percent-encoded in \a in are never a reason for
+    failure.
+
+    If \a in contains a '%' that does not start a valid percent-encoded
+    sequence, nothing is decoded and \a in is appended unchanged, as with
+    decode(). This takes precedence over the failure conditions above, since
+    no decoded character is produced in that case.
+*/
+static qsizetype decodeForLocalFile(QString &appendTo, QStringView in)
+{
+    const char16_t *begin = in.utf16();
+    const char16_t *end = begin + in.size();
+    const char16_t *input = QtPrivate::qustrchr(in, u'%');
+
+    if (Q_LIKELY(input == end))
+        return 0;           // nothing to do, it was already decoded!
+
+    // decoding never makes the string longer
+    const qsizetype origSize = appendTo.size();
+    appendTo.resize(origSize + (end - begin));
+    char16_t *const outputBegin = reinterpret_cast<char16_t *>(appendTo.data()) + origSize;
+    char16_t *output = std::copy(begin, input, outputBegin);
+
+    // keep going after finding something unsafe, as a badly-encoded sequence
+    // further on means we don't decode anything at all
+    bool unsafe = false;
+    while (input != end) {
+        Q_ASSERT(*input == u'%');
+        if (Q_UNLIKELY(end - input < 3 || !isHex(input[1]) || !isHex(input[2]))) {
+            // badly-encoded data
+            appendTo.truncate(origSize);
+            appendTo += in;
+            return in.size();
+        }
+
+        const char16_t decoded = decodeNibble(input[1]) << 4 | decodeNibble(input[2]);
+        input += 3;
+        if (decoded < 0x80) {
+            unsafe |= isUnsafeForLocalFile(decoded);
+            *output++ = decoded;
+        } else if (QUtf8Functions::fromUtf8<QUrlLocalFileUtf8Traits>(uchar(decoded), output,
+                                                                     input, end) < 0) {
+            // not UTF-8; fromUtf8() didn't advance input or output
+            unsafe = true;
+        }
+
+        // copy until the next percent
+        const char16_t *next = QtPrivate::qustrchr(QStringView(input, end), u'%');
+        output = std::copy(input, next, output);
+        input = next;
+    }
+
+    if (unsafe) {
+        appendTo.truncate(origSize);
+        return -1;
+    }
+
+    const qsizetype len = output - outputBegin;
+    appendTo.truncate(origSize + len);
+    return len;
+}
