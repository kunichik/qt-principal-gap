+    // nothing to decode
+    QTest::newRow("empty") << u""_s << u""_s;
+    QTest::newRow("no-percent") << u"/tmp/foo bar"_s << u"/tmp/foo bar"_s;
+    QTest::newRow("unicode") << u"/tmp/\u00e9\U0001F600"_s << u"/tmp/\u00e9\U0001F600"_s;
+
+    // regular decoding
+    QTest::newRow("ascii") << u"/tmp/%41%62c"_s << u"/tmp/Abc"_s;
+    QTest::newRow("lowercase-hex") << u"%7e%7E"_s << u"~~"_s;
+    QTest::newRow("space") << u"/a%20b"_s << u"/a b"_s;
+    QTest::newRow("percent") << u"/100%25"_s << u"/100%"_s;
+    QTest::newRow("decoded-once") << u"/a%252Fb"_s << u"/a%2Fb"_s;
+    QTest::newRow("reserved") << u"%3A%3F%23%5B%5D%40"_s << u":?#[]@"_s;
+    QTest::newRow("control") << u"%01%1F%7F"_s << u"\x01\x1f\x7f"_s;
+    QTest::newRow("dot-segments") << u"/a/%2E%2E/b"_s << u"/a/../b"_s;
+
+    // UTF-8 is decoded
+    QTest::newRow("utf8-2") << u"/caf%C3%A9"_s << u"/caf\u00e9"_s;
+    QTest::newRow("utf8-2-lowercase") << u"/caf%c3%a9"_s << u"/caf\u00e9"_s;
