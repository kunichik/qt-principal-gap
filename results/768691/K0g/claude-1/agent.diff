+static bool hasBadPercentEncoding(const char16_t *input, const char16_t *end)
+{
+    for ( ; input != end; ++input) {
+        if (*input != '%')
+            continue;
+        if (end - input < 3 || !isHex(input[1]) || !isHex(input[2]))
+            return true;
+        input += 2;
+    }
+    return false;
+}
+
+/*
+ * Decodes one percent-encoded sequence at \a input (which must be a valid %XX
+ * sequence) for use in a local file path, writing it to \a output. If the
+ * sequence starts a multi-byte UTF-8 sequence, the subsequent percent-encoded
+ * bytes are consumed too.
+ *
+ * Returns false, without writing anything, if the decoded data would be
+ * unsafe in a local file path: NUL, the directory separator ('/' and, on
+ * Windows, '\\') or percent-encoded bytes that are not valid UTF-8.
+ */
+static bool decodeForLocalFile(QChar *&output, const char16_t *&input, const char16_t *end)
+{
+    const char16_t decoded = decodePercentEncoding(input);
+    if (decoded < 0x80) {
+        if (decoded == '\0' || decoded == '/')
+            return false;
+#ifdef Q_OS_WIN
+        if (decoded == '\\')
+            return false;
+#endif
+        *output++ = QChar(decoded);
+        input += 3;
+        return true;
+    }
+
+    char32_t ucs4;
+    char32_t *dst = &ucs4;
+    const char16_t *src = input + 3;    // skip the %XX that yielded decoded
+    if (QUtf8Functions::fromUtf8<QUrlLocalFileUtf8Traits>(uchar(decoded), dst, src, end) < 0)
+        return false;
+
+    if (QChar::requiresSurrogates(ucs4)) {
+        *output++ = QChar(QChar::highSurrogate(ucs4));
+        *output++ = QChar(QChar::lowSurrogate(ucs4));
+    } else {
+        *output++ = QChar(char16_t(ucs4));
+    }
+    input = src;
+    return true;
+}
