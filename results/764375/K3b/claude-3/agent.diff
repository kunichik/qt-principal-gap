+    ~RunFunctionTaskBase() override
+    {
+        // The task may be deleted without having been run, e.g. when it is
+        // removed from the thread pool's queue by QThreadPool::clear().
+        // Cancel and finish the future so that waiting on it doesn't block forever.
+        if (!promise.isFinished()) {
+            promise.reportCanceled();
+            promise.reportFinished();
