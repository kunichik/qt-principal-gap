+void tst_QtConcurrentRun::clearedFromThreadPool()
+{
+    QThreadPool pool;
+    pool.setMaxThreadCount(1);
+
+    // Occupy the only thread so that subsequent tasks stay queued
+    QSemaphore started;
+    QSemaphore release;
+    auto blocker = run(&pool, [&] {
+        started.release();
+        release.acquire();
+    });
+    // Unblock the pool on every exit path, so a failing check doesn't hang
+    auto cleanup = qScopeGuard([&] {
+        release.release();
+        pool.waitForDone();
+    });
+    QVERIFY(started.tryAcquire(1, 10s));
+
+    bool ran = false;
+    auto f = run(&pool, [&ran] { ran = true; return 42; });
+    bool canceledCalled = false;
+    auto cont = f.onCanceled([&canceledCalled] { canceledCalled = true; return -1; });
+    auto withPromise = run(&pool, [&ran](QPromise<int> &) { ran = true; });
+    QVERIFY(f.isRunning());
+    QVERIFY(withPromise.isRunning());
+
+    pool.clear();
+
+    QVERIFY(f.isCanceled());
+    QVERIFY(f.isFinished());
+    f.waitForFinished(); // must not hang
+    QVERIFY(canceledCalled);
+    QCOMPARE(cont.result(), -1);
+    QVERIFY(withPromise.isCanceled());
+    QVERIFY(withPromise.isFinished());
+
+    cleanup.dismiss();
+    release.release();
+    blocker.waitForFinished();
+    QVERIFY(pool.waitForDone());
+    QVERIFY(!ran);
+}
+
 QTEST_MAIN(tst_QtConcurrentRun)
