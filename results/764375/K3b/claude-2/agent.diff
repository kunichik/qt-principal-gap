+void tst_QtConcurrentRun::clearThreadPool()
+{
+    QThreadPool pool;
+    pool.setMaxThreadCount(1);
+
+    QSemaphore started;
+    QSemaphore blocker;
+    auto blocking = run(&pool, [&] { started.release(); blocker.acquire(); });
+    started.acquire();
+
+    std::atomic<bool> isInvoked = false;
+    auto future = run(&pool, [&] { isInvoked = true; return 42; });
+    auto withPromise = run(&pool, [&](QPromise<int> &) { isInvoked = true; });
+    std::atomic<bool> canceledHandlerCalled = false;
+    auto continuation = run(&pool, [&] { isInvoked = true; })
+            .onCanceled([&] { canceledHandlerCalled = true; });
+
+    pool.clear();
+    blocker.release();
+
+    QTRY_VERIFY(blocking.isFinished());
+    QVERIFY(!blocking.isCanceled());
+
+    QTRY_VERIFY(future.isFinished());
+    QVERIFY(future.isCanceled());
+
+    QTRY_VERIFY(withPromise.isFinished());
+    QVERIFY(withPromise.isCanceled());
+
+    QTRY_VERIFY(continuation.isFinished());
+    QVERIFY(canceledHandlerCalled);
+
+    QVERIFY(pool.waitForDone());
+    QVERIFY(!isInvoked);
+}
+
 QTEST_MAIN(tst_QtConcurrentRun)
 #include "tst_qtconcurrentrun.moc"
