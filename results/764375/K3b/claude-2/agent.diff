@@ -47,6 +47,17 @@ template <typename T>
 class RunFunctionTaskBase : public QRunnable
 {
 public:
+    ~RunFunctionTaskBase() override
+    {
+        // The task may be deleted without having run, e.g. when it is removed
+        // from the pool's queue by QThreadPool::clear(). Finish the future in
+        // that case, so that nobody waits on it forever.
+        if (!promise.isFinished()) {
+            promise.reportCanceled();
+            promise.reportFinished();
+        }
+    }
+
     QFuture<T> start()
     {
         return start(TaskStartParameters());
