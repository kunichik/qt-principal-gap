+void tst_QtConcurrentRun::clearThreadPool()
+{
+    QThreadPool pool;
+    pool.setMaxThreadCount(1);
+
+    // Occupy the only thread, so that the following tasks stay queued
+    QSemaphore started;
+    QSemaphore release;
+    // Don't block the pool's destructor if the test fails
+    auto releaseGuard = qScopeGuard([&] { release.release(); });
+    auto blocker = run(&pool, [&] {
+        started.release();
+        release.acquire();
+    });
+    QVERIFY(started.tryAcquire(1, 5000));
+
+    std::atomic<bool> isInvoked = false;
+    auto future = run(&pool, [&] { isInvoked = true; return 42; });
+    auto futureWithPromise = run(&pool, [&](QPromise<int> &promise) {
+        isInvoked = true;
+        promise.addResult(42);
+    });
+    bool canceledHandlerCalled = false;
+    auto continuation = run(&pool, [&] { isInvoked = true; })
+            .onCanceled([&] { canceledHandlerCalled = true; });
+    {
+        auto lifetimeFuture = run(&pool, LifetimeChecker());
+        QCOMPARE(LifetimeChecker::count, 1);
+        pool.clear();
+        QCOMPARE(LifetimeChecker::count, 0);
+        QVERIFY(lifetimeFuture.isFinished());
+        QVERIFY(lifetimeFuture.isCanceled());
+    }
+
+    QVERIFY(future.isFinished());
+    QVERIFY(future.isCanceled());
+    future.waitForFinished();
+
+    QVERIFY(futureWithPromise.isFinished());
+    QVERIFY(futureWithPromise.isCanceled());
+    futureWithPromise.waitForFinished();
+
+    QVERIFY(continuation.isFinished());
+    continuation.waitForFinished();
+    QVERIFY(canceledHandlerCalled);
+
+    releaseGuard.dismiss();
+    release.release();
+    blocker.waitForFinished();
+    QVERIFY(!blocker.isCanceled());
+    QVERIFY(pool.waitForDone(5000));
+    QVERIFY(!isInvoked);
+}
+
 QTEST_MAIN(tst_QtConcurrentRun)
 #include "tst_qtconcurrentrun.moc"
