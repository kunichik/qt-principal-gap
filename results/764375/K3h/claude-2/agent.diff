+void tst_QtConcurrentMap::clearedThreadPool()
+{
+    QThreadPool pool;
+    pool.setMaxThreadCount(1);
+
+    // Occupy the only thread so that the engines stay queued.
+    QSemaphore blockerStarted;
+    QSemaphore releaseBlocker;
+    pool.start([&] {
+        blockerStarted.release();
+        releaseBlocker.acquire();
+    });
+    blockerStarted.acquire();
+
+    std::atomic<int> invocations = 0;
+    std::atomic<bool> onCanceledInvoked = false;
+    QList<int> list { 1, 2, 3 };
+    auto mapFuture = QtConcurrent::map(&pool, list, [&](int &) { ++invocations; });
+    auto canceled = mapFuture.onCanceled([&] { onCanceledInvoked = true; });
+    auto mappedFuture = QtConcurrent::mapped(&pool, list, [&](int i) { ++invocations; return i; });
+    auto filteredFuture = QtConcurrent::filtered(&pool, list, [&](int) { ++invocations; return true; });
+
+    pool.clear();
+
+    QVERIFY(mapFuture.isFinished());
+    QVERIFY(mapFuture.isCanceled());
+    QVERIFY(canceled.isFinished());
+    QVERIFY(onCanceledInvoked);
+    QVERIFY(mappedFuture.isFinished());
+    QVERIFY(mappedFuture.isCanceled());
+    QVERIFY(filteredFuture.isFinished());
+    QVERIFY(filteredFuture.isCanceled());
+
+    releaseBlocker.release();
+    QVERIFY(pool.waitForDone());
+    QCOMPARE(invocations, 0);
+}
+
 QTEST_MAIN(tst_QtConcurrentMap)
 #include "tst_qtconcurrentmap.moc"
