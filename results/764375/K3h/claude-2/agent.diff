+/*
+    The thread pool may destroy a queued runnable without running it (for
+    instance in QThreadPool::clear()). The engine is not auto-deleting, so it
+    is never queued directly; instead each thread start queues a runner that
+    gives back the barrier slot it holds if it is destroyed without having run.
+*/
+class ThreadEngineRunner : public QRunnable
+{
+public:
+    explicit ThreadEngineRunner(ThreadEngineBase *engine) : engine(engine) {}
+
+    ~ThreadEngineRunner() override
+    {
+        if (!engine)
+            return;
+
+        // Other threads are still running the engine and will finish it.
+        if (engine->barrier.releaseUnlessLast())
+            return;
+
+        // Nobody else is going to run the engine. Cancel it before finishing,
+        // like run() does for a canceled engine, so that the future does not
+        // look as if it completed normally.
+        if (engine->futureInterface)
+            engine->futureInterface->reportCanceled();
+        engine->threadExit();
+    }
+
+    void run() override { std::exchange(engine, nullptr)->run(); }
+
+    void disarm() { engine = nullptr; }
+
+private:
+    ThreadEngineBase *engine;
+};
