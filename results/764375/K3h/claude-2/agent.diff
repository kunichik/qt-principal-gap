+void tst_QtConcurrentRun::clearedThreadPool()
+{
+    QThreadPool pool;
+    pool.setMaxThreadCount(1);
+
+    // Occupy the only thread so that the next tasks stay queued.
+    QSemaphore blockerStarted;
+    QSemaphore releaseBlocker;
+    auto blocker = run(&pool, [&] {
+        blockerStarted.release();
+        releaseBlocker.acquire();
+    });
+    blockerStarted.acquire();
+
+    std::atomic<bool> isInvoked = false;
+    std::atomic<bool> onCanceledInvoked = false;
+    {
+        auto future = run(&pool, [&] { isInvoked = true; return 42; });
+        auto canceled = future.onCanceled([&] { onCanceledInvoked = true; return -1; });
+        auto withPromise = run(&pool, [&](QPromise<int> &) { isInvoked = true; });
+        auto withLifetime = run(&pool, LifetimeChecker());
+
+        pool.clear();
+
+        QVERIFY(future.isFinished());
+        QVERIFY(future.isCanceled());
+        QVERIFY(canceled.isFinished());
+        QCOMPARE(canceled.result(), -1);
+        QVERIFY(onCanceledInvoked);
+        QVERIFY(withPromise.isFinished());
+        QVERIFY(withPromise.isCanceled());
+        withLifetime.waitForFinished();
+        QVERIFY(withLifetime.isCanceled());
+    }
+    QCOMPARE(LifetimeChecker::count, 0);
+
+    releaseBlocker.release();
+    blocker.waitForFinished();
+    QVERIFY(pool.waitForDone());
+    QVERIFY(!isInvoked);
+}
+
 QTEST_MAIN(tst_QtConcurrentRun)
