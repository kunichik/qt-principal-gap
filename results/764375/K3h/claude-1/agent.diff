+// Auto-deleting runnable used for the initial asynchronous start of a
+// ThreadEngine. The engine itself is not auto-deleting, so if it was queued
+// directly and then removed from the queue, e.g. by QThreadPool::clear(), it
+// would never finish its future and never delete itself. If this task gets
+// destroyed without having run, it cancels and finishes the engine instead.
+class ThreadEngineStartTask : public QRunnable
+{
+public:
+    explicit ThreadEngineStartTask(ThreadEngineBase *engine) : engine(engine) {}
+
+    ~ThreadEngineStartTask() override
+    {
+        if (engine) {
+            if (engine->futureInterface)
+                engine->futureInterface->reportCanceled();
+            engine->threadExit(); // may delete the engine
+        }
+    }
+
+    void run() override
+    {
+        // The engine may delete itself in run()
+        std::exchange(engine, nullptr)->run();
+    }
+
+private:
+    ThreadEngineBase *engine;
+};
+
+void ThreadEngineBase::startInThreadPool()
+{
+    threadPool->start(new ThreadEngineStartTask(this));
+}
+
 void ThreadEngineBase::startThread()
 {
     startThreadInternal();
