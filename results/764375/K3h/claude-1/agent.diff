+void tst_QtConcurrentRun::clearThreadPool()
+{
+    QThreadPool pool;
+    pool.setMaxThreadCount(1);
+
+    // Block the only thread, so that the next tasks stay in the queue
+    QSemaphore started;
+    QSemaphore release;
+    auto blocker = run(&pool, [&] { started.release(); release.acquire(); });
+    started.acquire();
+
+    std::atomic<bool> isInvoked = false;
+    bool canceledCalled = false;
+    auto future = run(&pool, [&] { isInvoked = true; return 42; });
+    auto canceled = future.onCanceled([&] { canceledCalled = true; return -1; });
+    auto promiseFuture = run(&pool, [&](QPromise<int> &p) { isInvoked = true; p.addResult(1); });
+    {
+        auto lifetimeFuture = run(&pool, LifetimeChecker());
+        QCOMPARE(LifetimeChecker::count, 1);
+        pool.clear();
+        QVERIFY(lifetimeFuture.isFinished());
+        QVERIFY(lifetimeFuture.isCanceled());
+    }
+    QCOMPARE(LifetimeChecker::count, 0);
+
+    QVERIFY(future.isFinished());
+    QVERIFY(future.isCanceled());
+    future.waitForFinished(); // must not hang
+    QVERIFY(canceledCalled);
+    QCOMPARE(canceled.result(), -1);
+
+    QVERIFY(promiseFuture.isFinished());
+    QVERIFY(promiseFuture.isCanceled());
+    promiseFuture.waitForFinished();
+
+    release.release();
+    blocker.waitForFinished();
+    QVERIFY(!isInvoked);
+}
+
 QTEST_MAIN(tst_QtConcurrentRun)
 #include "tst_qtconcurrentrun.moc"
