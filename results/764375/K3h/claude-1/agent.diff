+void tst_QtConcurrentMap::mappedClearThreadPool()
+{
+    QThreadPool pool;
+    pool.setMaxThreadCount(1);
+
+    // Block the only thread, so that the map engine stays in the queue
+    QSemaphore started;
+    QSemaphore release;
+    pool.start([&] { started.release(); release.acquire(); });
+    started.acquire();
+
+    std::atomic<bool> isInvoked = false;
+    const QList<int> list { 1, 2, 3 };
+    QFuture<int> future = QtConcurrent::mapped(&pool, list, [&](int i) {
+        isInvoked = true;
+        return i * 2;
+    });
+    bool canceledCalled = false;
+    auto canceled = future.onCanceled([&] { canceledCalled = true; return -1; });
+
+    pool.clear();
+
+    QVERIFY(future.isFinished());
+    QVERIFY(future.isCanceled());
+    future.waitForFinished(); // must not hang
+    QVERIFY(canceledCalled);
+
+    QFuture<int> reduced = QtConcurrent::mappedReduced(&pool, list,
+            [&](int i) { isInvoked = true; return i; },
+            [](int &sum, int i) { sum += i; });
+    pool.clear();
+    QVERIFY(reduced.isFinished());
+    QVERIFY(reduced.isCanceled());
+
+    release.release();
+    QVERIFY(pool.waitForDone());
+    QVERIFY(!isInvoked);
+}
+
 QTEST_MAIN(tst_QtConcurrentMap)
 #include "tst_qtconcurrentmap.moc"
