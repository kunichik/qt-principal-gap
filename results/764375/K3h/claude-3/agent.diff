+struct CountedMapper
+{
+    CountedMapper() { ++count; }
+    CountedMapper(const CountedMapper &) { ++count; }
+    ~CountedMapper() { --count; }
+
+    int operator()(int x) const { return 2 * x; }
+
+    static std::atomic<int> count;
+};
+std::atomic<int> CountedMapper::count = 0;
+
+using namespace std::chrono_literals;
+
+void tst_QtConcurrentMap::clearThreadPool()
+{
+    QThreadPool pool;
+    pool.setMaxThreadCount(1);
+    QSemaphore blockerStarted;
+    QSemaphore unblock;
+    pool.start([&] {
+        blockerStarted.release();
+        unblock.acquire();
+    });
+    QVERIFY(blockerStarted.tryAcquire(1, 10s));
+    // don't block the pool's destructor if a check fails
+    auto releaseBlocker = qScopeGuard([&] { unblock.release(); });
+
+    const QList<int> list { 1, 2, 3 };
+    bool onCanceledCalled = false;
+    {
+        QFuture<int> future = QtConcurrent::mapped(&pool, list, CountedMapper());
+        auto continuation = future.onCanceled([&] { onCanceledCalled = true; return 0; });
+
+        pool.clear();
+
+        QVERIFY(future.isFinished());
+        QVERIFY(future.isCanceled());
+        future.waitForFinished(); // must not hang
+        continuation.waitForFinished();
+        QVERIFY(onCanceledCalled);
+    }
+    // the thread engine must not leak
+    QCOMPARE(CountedMapper::count, 0);
+}
+
 QTEST_MAIN(tst_QtConcurrentMap)
