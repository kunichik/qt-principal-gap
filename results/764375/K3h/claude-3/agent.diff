+// Auto-deleting QRunnable that is handed to a QThreadPool in place of a task
+// that reports to a future. If the pool discards it without running it (e.g.
+// in QThreadPool::clear()), the future is canceled and the task is run so that
+// it can finish in its canceled state; otherwise the future would never finish.
+class Q_CORE_EXPORT QFutureRunnableGuard : public QRunnable
+{
+public:
+    QFutureRunnableGuard(QRunnable *task, QFutureInterfaceBase *future)
+        : task(task), future(future)
+    {
+        Q_ASSERT(task);
+        Q_ASSERT(future);
+    }
+    ~QFutureRunnableGuard() override;
+
+    void run() override;
+    // Gives up the task without running it, e.g. when QThreadPool::tryStart() failed
+    void release() { task = nullptr; }
+
+private:
+    void runTask();
+
+    QRunnable *task;
+    QFutureInterfaceBase *future;
+};
