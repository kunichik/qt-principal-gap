+/*!
+    \internal
+
+    Returns an auto-deleting runnable that runs \a task, to be passed to a
+    QThreadPool instead of \a task. If the thread pool discards the returned
+    runnable without running it (for example, in QThreadPool::clear()), this
+    future is canceled and \a task is run anyway, so that it can report this
+    future as finished. \a task is deleted after running if it is
+    auto-deleting.
+
+    \a task must keep this object alive until it has run.
+*/
+QRunnable *QFutureInterfaceBase::guardRunnable(QRunnable *task)
+{
+    return new QFutureRunnableGuard(task, this);
+}
+
+QFutureRunnableGuard::~QFutureRunnableGuard()
+{
+    if (task) {
+        // Discarded by the thread pool. Cancel first, the same way it is done
+        // when there is no thread pool, so that the task finishes as canceled.
+        future->reportCanceled();
+        runTask();
+    }
+}
+
+void QFutureRunnableGuard::run()
+{
+    runTask();
+}
+
+void QFutureRunnableGuard::runTask()
+{
+    QRunnable *r = std::exchange(task, nullptr);
+    // If autoDelete() is false, r might already be deleted after run(), so check status now.
+    const bool del = r->autoDelete();
+    r->run();
+    if (del)
+        delete r;
+}
+
 void QFutureInterfaceBase::setThreadPool(QThreadPool *pool)
 {
     d->m_pool = pool;
