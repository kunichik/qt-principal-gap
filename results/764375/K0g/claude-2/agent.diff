+void tst_QtConcurrentRun::clearedThreadPool()
+{
+    QThreadPool pool;
+    pool.setMaxThreadCount(1);
+
+    QSemaphore started;
+    QSemaphore release;
+    auto blocker = run(&pool, [&] { started.release(); release.acquire(); });
+    started.acquire();
+    auto releaseBlocker = qScopeGuard([&] { release.release(); });
+
+    // These are queued behind the blocker and get removed by clear()
+    bool ran = false;
+    auto f1 = run(&pool, [&] { ran = true; });
+    auto f2 = run(&pool, [&] { ran = true; return 42; });
+    auto f3 = run(&pool, [&](QPromise<int> &p) { ran = true; p.addResult(42); });
+    bool continuationCalled = false;
+    auto cont = f1.then([&] { continuationCalled = true; })
+                    .onCanceled([&] { continuationCalled = true; });
+
+    pool.clear();
+
+    QVERIFY(f1.isFinished());
+    QVERIFY(f1.isCanceled());
+    QVERIFY(f2.isFinished());
+    QVERIFY(f2.isCanceled());
+    QVERIFY(f3.isFinished());
+    QVERIFY(f3.isCanceled());
+    f1.waitForFinished();
+    f2.waitForFinished();
+    f3.waitForFinished();
+    QVERIFY(cont.isFinished());
+    QVERIFY(continuationCalled);
+
+    releaseBlocker.dismiss();
+    release.release();
+    blocker.waitForFinished();
+    QVERIFY(!ran);
+}
+
 QTEST_MAIN(tst_QtConcurrentRun)
 #include "tst_qtconcurrentrun.moc"
