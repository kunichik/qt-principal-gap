 class RunFunctionTaskBase : public QRunnable
 {
 public:
+    ~RunFunctionTaskBase() override
+    {
+        // If the task is destroyed without having run (e.g. it was removed
+        // from the pool's queue by QThreadPool::clear()), cancel and finish
+        // the future, so that waiters don't block forever.
+        if (!promise.isFinished()) {
+            promise.reportCanceled();
+            promise.reportFinished();
+        }
+    }
+
     QFuture<T> start()
