+void tst_QtConcurrentRun::clearedFromPool()
+{
+    QThreadPool pool;
+    pool.setMaxThreadCount(1);
+
+    QSemaphore started;
+    QSemaphore release;
+    auto blocker = run(&pool, [&] {
+        started.release();
+        release.acquire();
+    });
+    started.acquire();
+
+    // Queued behind the blocker; removed by clear() before it gets to run
+    std::atomic<bool> isInvoked = false;
+    auto future = run(&pool, [&] { isInvoked = true; return 42; });
+    auto futureWithPromise = run(&pool, [&](QPromise<int> &) { isInvoked = true; });
+    QVERIFY(future.isRunning());
+
+    pool.clear();
+    release.release();
+
+    QTRY_VERIFY(future.isFinished());
+    QVERIFY(future.isCanceled());
+    QTRY_VERIFY(futureWithPromise.isFinished());
+    QVERIFY(futureWithPromise.isCanceled());
+    future.waitForFinished();
+    futureWithPromise.waitForFinished();
+    blocker.waitForFinished();
+    QVERIFY(!isInvoked);
+}
+
 QTEST_MAIN(tst_QtConcurrentRun)
 #include "tst_qtconcurrentrun.moc"
