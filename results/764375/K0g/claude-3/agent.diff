@@ -47,6 +47,18 @@ template <typename T>
 class RunFunctionTaskBase : public QRunnable
 {
 public:
+    ~RunFunctionTaskBase() override
+    {
+        // The task may be destroyed without having run, e.g. when it is
+        // removed from the pool's queue by QThreadPool::clear(). Don't leave
+        // the future in the running state forever in that case.
+        promise.setRunnable(nullptr);
+        if (!promise.isFinished()) {
+            promise.reportCanceled();
+            promise.reportFinished();
+        }
+    }
+
     QFuture<T> start()
     {
         return start(TaskStartParameters());
