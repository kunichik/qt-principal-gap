+void tst_QtConcurrentRun::clearedFromThreadPool()
+{
+    QThreadPool pool;
+    pool.setMaxThreadCount(1);
+
+    QSemaphore started;
+    QSemaphore release;
+    auto blocker = run(&pool, [&] { started.release(); release.acquire(); });
+    started.acquire();
+
+    // These are still queued while the only thread is busy
+    bool ran = false;
+    auto queued = run(&pool, [&] { ran = true; return 42; });
+    auto queuedWithPromise = run(&pool, [&](QPromise<int> &p) { ran = true; p.addResult(42); });
+    bool continuationCalled = false;
+    auto continuation = queued.then([](int) {}).onCanceled([&] { continuationCalled = true; });
+
+    pool.clear();
+
+    QVERIFY(queued.isFinished());
+    QVERIFY(queued.isCanceled());
+    QVERIFY(queuedWithPromise.isFinished());
+    QVERIFY(queuedWithPromise.isCanceled());
+    queued.waitForFinished();
+    queuedWithPromise.waitForFinished();
+    continuation.waitForFinished();
+    QVERIFY(continuationCalled);
+
+    release.release();
+    blocker.waitForFinished();
+    QVERIFY(pool.waitForDone());
+    QVERIFY(!ran);
+}
+
 QTEST_MAIN(tst_QtConcurrentRun)
 #include "tst_qtconcurrentrun.moc"
