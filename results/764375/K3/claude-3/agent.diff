+// Called by QThreadPool::clear() for each queued run of the engine that was removed.
+// Each such run holds a barrier count acquired when it was started.
+void ThreadEngineBase::discardQueuedRun(void *context)
+{
+    auto *engine = static_cast<ThreadEngineBase *>(context);
+    // Other runs are still active (or also being discarded); the last one finishes.
+    if (engine->barrier.releaseUnlessLast())
+        return;
+    // Nothing else will run the engine. Cancel the future before finishing it, so
+    // that the remaining work is not reported as done and .onCanceled() runs.
+    engine->futureInterface->reportCanceled();
+    engine->threadExit();
+}
