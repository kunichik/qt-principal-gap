+void tst_QtConcurrentMap::clearThreadPool()
+{
+    QThreadPool pool;
+    pool.setMaxThreadCount(1);
+
+    QSemaphore blockerStarted;
+    QSemaphore releaseBlocker;
+    pool.start([&] {
+        blockerStarted.release();
+        releaseBlocker.acquire();
+    });
+    blockerStarted.acquire();
+
+    QList<int> list { 1, 2, 3 };
+    bool canceledHandlerCalled = false;
+    auto future = QtConcurrent::map(&pool, list, [](int &x) { x *= 10; });
+    auto continuation = future.onCanceled([&] { canceledHandlerCalled = true; });
+    auto mapped = QtConcurrent::mapped(&pool, list, [](int x) { return x * 10; });
+    QVERIFY(future.isRunning());
+    QVERIFY(mapped.isRunning());
+
+    pool.clear();
+
+    // The removed engines are canceled and finished, not left running forever
+    QVERIFY(future.isFinished());
+    QVERIFY(future.isCanceled());
+    future.waitForFinished();
+    QVERIFY(canceledHandlerCalled);
+    QCOMPARE(list, QList<int>({ 1, 2, 3 }));
+    QVERIFY(mapped.isFinished());
+    QVERIFY(mapped.isCanceled());
+    QCOMPARE(mapped.resultCount(), 0);
+
+    releaseBlocker.release();
+    pool.waitForDone();
+
+    // The pool still works afterwards
+    QCOMPARE(QtConcurrent::mapped(&pool, list, [](int x) { return x * 10; }).results(),
+             QList<int>({ 10, 20, 30 }));
+}
+
 QTEST_MAIN(tst_QtConcurrentMap)
