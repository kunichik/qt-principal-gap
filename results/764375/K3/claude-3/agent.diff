+void tst_QtConcurrentRun::clearThreadPool()
+{
+    QThreadPool pool;
+    pool.setMaxThreadCount(1);
+
+    QSemaphore blockerStarted;
+    QSemaphore releaseBlocker;
+    auto blocker = run(&pool, [&] {
+        blockerStarted.release();
+        releaseBlocker.acquire();
+    });
+    blockerStarted.acquire();
+
+    {
+        bool ran = false;
+        bool canceledHandlerCalled = false;
+        auto future = run(&pool, [&] { ran = true; });
+        auto continuation = future.onCanceled([&] { canceledHandlerCalled = true; });
+        auto promiseFuture = run(&pool, [](QPromise<int> &promise) { promise.addResult(42); });
+        auto lifetimeFuture = run(&pool, LifetimeChecker());
+        QVERIFY(future.isRunning());
+        QVERIFY(promiseFuture.isRunning());
+        QVERIFY(lifetimeFuture.isRunning());
+
+        pool.clear();
+
+        // The removed tasks are canceled and finished, not left running forever
+        QVERIFY(future.isFinished());
+        QVERIFY(future.isCanceled());
+        future.waitForFinished();
+        QVERIFY(!ran);
+        QVERIFY(canceledHandlerCalled);
+        QVERIFY(promiseFuture.isFinished());
+        QVERIFY(promiseFuture.isCanceled());
+        QCOMPARE(promiseFuture.resultCount(), 0);
+        QVERIFY(lifetimeFuture.isFinished());
+        QVERIFY(lifetimeFuture.isCanceled());
+    }
+    QCOMPARE(LifetimeChecker::count, 0);
+
+    releaseBlocker.release();
+    blocker.waitForFinished();
+    QVERIFY(!blocker.isCanceled());
+
+    // The pool still works afterwards
+    QCOMPARE(run(&pool, [] { return 7; }).result(), 7);
+}
+
 QTEST_MAIN(tst_QtConcurrentRun)
 #include "tst_qtconcurrentrun.moc"
