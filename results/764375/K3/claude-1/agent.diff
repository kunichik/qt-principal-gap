+struct CountingMapper
+{
+    CountingMapper() { ++count; }
+    CountingMapper(const CountingMapper &) { ++count; }
+    ~CountingMapper() { --count; }
+
+    int operator()(int x) const { ++calls; return x * 2; }
+
+    static std::atomic<int> count;
+    static std::atomic<int> calls;
+};
+std::atomic<int> CountingMapper::count = 0;
+std::atomic<int> CountingMapper::calls = 0;
+
+void tst_QtConcurrentMap::clearedFromThreadPool()
+{
+    QThreadPool pool;
+    pool.setMaxThreadCount(1);
+    QSemaphore blockerStarted;
+    QSemaphore releaseBlocker;
+    pool.start([&] {
+        blockerStarted.release();
+        releaseBlocker.acquire();
+    });
+    blockerStarted.acquire();
+    auto cleanup = qScopeGuard([&] {
+        releaseBlocker.release();
+        pool.waitForDone();
+    });
+
+    const QList<int> list { 1, 2, 3, 4 };
+    {
+        auto future = QtConcurrent::mapped(&pool, list, CountingMapper());
+        bool canceledRan = false;
+        auto continuation = future.onCanceled([&canceledRan] {
+            canceledRan = true;
+            return 0;
+        });
+        QVERIFY(future.isRunning());
+
+        pool.clear();
+
+        QVERIFY(future.isFinished());
+        QVERIFY(future.isCanceled());
+        future.waitForFinished();
+        continuation.waitForFinished();
+        QVERIFY(canceledRan);
+    }
+    {
+        QList<int> copy = list;
+        auto future = QtConcurrent::map(&pool, copy, [](int &x) { x *= 2; });
+        pool.clear();
+        QVERIFY(future.isFinished());
+        QVERIFY(future.isCanceled());
+        QCOMPARE(copy, list);
+    }
+    // The thread engines (and the functor copies they hold) must not leak.
+    QCOMPARE(CountingMapper::count, 0);
+    QCOMPARE(CountingMapper::calls, 0);
+
+}
+
 QTEST_MAIN(tst_QtConcurrentMap)
