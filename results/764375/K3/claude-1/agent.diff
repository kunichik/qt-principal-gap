+// A QRunnable that also (publicly) derives from this class is notified by
+// QThreadPool::clear() for each queued start of it that gets discarded
+// without having been run. The notification happens before an auto-deleting
+// runnable is deleted, and with no thread pool lock held.
+class Q_CORE_EXPORT QRunnableDiscardHandler
+{
+    Q_DISABLE_COPY_MOVE(QRunnableDiscardHandler)
+public:
+    virtual void runnableDiscarded() = 0;
+protected:
+    constexpr QRunnableDiscardHandler() noexcept = default;
+    virtual ~QRunnableDiscardHandler();
+};
