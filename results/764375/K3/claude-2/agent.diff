+/*
+    The engine is not auto-deleting and is run by several pool threads at once,
+    so each start hands the pool an auto-deleting PoolTask instead. If the pool
+    drops the task without running it (QThreadPool::clear()), the thread that
+    was accounted for in the barrier will never run; the task's destructor then
+    cancels the computation and exits that thread on its behalf, so the future
+    still gets finished and the engine is still deleted.
+*/
+class ThreadEngineBase::PoolTask : public QRunnable
+{
+public:
+    explicit PoolTask(ThreadEngineBase *engine) : engine(engine) {}
+
+    ~PoolTask() override
+    {
+        if (!engine)
+            return;
+        if (engine->futureInterface)
+            engine->futureInterface->reportCanceled();
+        engine->threadExit();
+    }
+
+    // The engine may delete itself in run(), so release it first.
+    void run() override { std::exchange(engine, nullptr)->run(); }
+
+    ThreadEngineBase *engine;
+};
