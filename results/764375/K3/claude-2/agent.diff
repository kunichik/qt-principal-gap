+void tst_QtConcurrentRun::clearThreadPool()
+{
+    QThreadPool pool;
+    pool.setMaxThreadCount(1);
+    QSemaphore blocker;
+    pool.start([&blocker] { blocker.acquire(); });
+
+    bool ran = false;
+    auto future = QtConcurrent::run(&pool, [&ran] { ran = true; return 42; });
+    bool canceledHandlerCalled = false;
+    auto continuation = future.onCanceled([&canceledHandlerCalled] {
+        canceledHandlerCalled = true;
+        return -1;
+    });
+
+    pool.clear();
+
+    QVERIFY(future.isFinished());
+    QVERIFY(future.isCanceled());
+    future.waitForFinished();
+    QVERIFY(continuation.isFinished());
+    QVERIFY(canceledHandlerCalled);
+    QCOMPARE(continuation.result(), -1);
+
+    blocker.release();
+    QVERIFY(pool.waitForDone());
+    QVERIFY(!ran);
+}
+
 QTEST_MAIN(tst_QtConcurrentRun)
 #include "tst_qtconcurrentrun.moc"
