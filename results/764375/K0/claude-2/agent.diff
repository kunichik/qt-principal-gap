+void tst_QtConcurrentRun::clearThreadPool()
+{
+    QThreadPool pool;
+    pool.setMaxThreadCount(1);
+
+    // Occupy the only thread, so that subsequent tasks stay queued.
+    QSemaphore started;
+    QSemaphore release;
+    auto blocker = run(&pool, [&] {
+        started.release();
+        release.acquire();
+    });
+    started.acquire();
+    auto releaser = qScopeGuard([&] { release.release(); });
+
+    bool ran = false;
+    auto future = run(&pool, [&] { ran = true; return 42; });
+    auto promiseFuture = run(&pool, [&](QPromise<int> &p) { ran = true; p.addResult(42); });
+    bool continuationRan = false;
+    auto continuation = run(&pool, [&] { ran = true; })
+            .onCanceled([&] { continuationRan = true; });
+
+    pool.clear();
+
+    // The removed tasks must not leave their futures running forever.
+    QVERIFY(future.isFinished());
+    QVERIFY(future.isCanceled());
+    future.waitForFinished();
+    QVERIFY(promiseFuture.isFinished());
+    QVERIFY(promiseFuture.isCanceled());
+    promiseFuture.waitForFinished();
+    continuation.waitForFinished();
+    QVERIFY(continuationRan);
+
+    releaser.dismiss();
+    release.release();
+    blocker.waitForFinished();
+    QVERIFY(pool.waitForDone());
+    QVERIFY(!ran);
+}
+
 QTEST_MAIN(tst_QtConcurrentRun)
 #include "tst_qtconcurrentrun.moc"
