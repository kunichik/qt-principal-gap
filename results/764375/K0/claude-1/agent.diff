+void tst_QtConcurrentRun::clearThreadPool()
+{
+    QThreadPool pool;
+    pool.setMaxThreadCount(1);
+
+    QSemaphore blockerStarted;
+    QSemaphore unblock;
+    // Occupy the only thread so that the following tasks stay queued
+    auto blocker = run(&pool, [&] {
+        blockerStarted.release();
+        unblock.acquire();
+    });
+    blockerStarted.acquire();
+
+    bool ran = false;
+    auto voidFuture = run(&pool, [&ran] { ran = true; });
+    auto intFuture = run(&pool, [&ran] { ran = true; return 42; });
+    auto promiseFuture = run(&pool, [&ran](QPromise<int> &p) { ran = true; p.addResult(1); });
+
+    pool.clear();
+    unblock.release();
+    blocker.waitForFinished();
+
+    for (QFuture<void> f : { QFuture<void>(voidFuture), QFuture<void>(intFuture),
+                             QFuture<void>(promiseFuture) }) {
+        QVERIFY(f.isFinished());
+        QVERIFY(f.isCanceled());
+        QVERIFY(!f.isRunning());
+        f.waitForFinished(); // must not hang
+    }
+    QVERIFY(!ran);
+    QCOMPARE(intFuture.resultCount(), 0);
+}
+
 QTEST_MAIN(tst_QtConcurrentRun)
