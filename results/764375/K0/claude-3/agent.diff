+void tst_QtConcurrentRun::clearedFromThreadPool()
+{
+    QThreadPool pool;
+    pool.setMaxThreadCount(1);
+
+    QSemaphore started;
+    QSemaphore release;
+    auto blocker = run(&pool, [&] {
+        started.release();
+        release.acquire();
+    });
+    auto cleanup = qScopeGuard([&] {
+        release.release();
+        blocker.waitForFinished();
+    });
+    started.acquire();
+
+    // These tasks are queued behind the blocker and will be removed by clear()
+    QFuture<void> voidFuture = run(&pool, [] {});
+    QFuture<int> intFuture = run(&pool, [] { return 42; });
+    QFuture<int> promiseFuture = run(&pool, [](QPromise<int> &p) { p.addResult(42); });
+    bool continuationCalled = false;
+    QFuture<void> continuation = run(&pool, [] {}).then(QtFuture::Launch::Sync,
+                                                         [&] { continuationCalled = true; });
+
+    pool.clear();
+
+    QVERIFY(voidFuture.isFinished());
+    QVERIFY(voidFuture.isCanceled());
+    QVERIFY(intFuture.isFinished());
+    QVERIFY(intFuture.isCanceled());
+    QVERIFY(promiseFuture.isFinished());
+    QVERIFY(promiseFuture.isCanceled());
+    QVERIFY(continuation.isFinished());
+    QVERIFY(!continuationCalled);
+
+    // must not hang
+    voidFuture.waitForFinished();
+    intFuture.waitForFinished();
+}
+
 QTEST_MAIN(tst_QtConcurrentRun)
 #include "tst_qtconcurrentrun.moc"
