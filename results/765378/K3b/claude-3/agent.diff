+void tst_QCoreApplication::postEventFromEventDestructorAtExit()
+{
+    // An event still pending when the application is destroyed must be
+    // allowed to post new events from its destructor without deadlocking.
+    static int destroyed = 0;
+    destroyed = 0;
+    class PostingEvent : public QEvent
+    { public:
+        QObject *target;
+        QObject *toDelete;
+        PostingEvent(QObject *target, QObject *toDelete)
+            : QEvent(QEvent::Type(QEvent::User + 1)), target(target), toDelete(toDelete) {}
+        ~PostingEvent()
+        {
+            ++destroyed;
+            QCoreApplication::postEvent(target, new QEvent(QEvent::Type(QEvent::User + 2)));
+            if (toDelete)
+                toDelete->deleteLater();
+        }
+    };
+
+    QObject receiver;
+    QPointer<QObject> doomed = new QObject;
+    {
+        int argc = 1;
+        char *argv[] = { const_cast<char*>(QTest::currentAppName()) };
+        TestApplication app(argc, argv);
+        QCoreApplication::postEvent(&receiver, new PostingEvent(&receiver, doomed));
+    }
+    QCOMPARE(destroyed, 1);
+    // the events posted from the destructor were cleaned up, too
+    QCOMPARE(QObjectPrivate::get(&receiver)->postedEvents.loadRelaxed(), 0);
+    QVERIFY(doomed);
+    delete doomed;
+}
+
+void tst_QCoreApplication::endlesslyRepostingEventAtExit()
+{
+    // An event whose destructor always posts another such event must not
+    // make the application's destruction loop forever.
+    static int destroyed = 0;
+    destroyed = 0;
+    class RepostingEvent : public QEvent
+    { public:
+        QObject *target;
+        explicit RepostingEvent(QObject *target)
+            : QEvent(QEvent::Type(QEvent::User + 1)), target(target) {}
+        ~RepostingEvent()
+        {
+            ++destroyed;
+            QCoreApplication::postEvent(target, new RepostingEvent(target));
+        }
+    };
+
+    QObject receiver;
+    {
+        int argc = 1;
+        char *argv[] = { const_cast<char*>(QTest::currentAppName()) };
+        TestApplication app(argc, argv);
+        QCoreApplication::postEvent(&receiver, new RepostingEvent(&receiver));
+        QTest::ignoreMessage(QtWarningMsg,
+                             QRegularExpression("leaking 1 remaining event"));
+    }
+    QVERIFY(destroyed > 1);
+    QCOMPARE(QObjectPrivate::get(&receiver)->postedEvents.loadRelaxed(), 0);
+}
