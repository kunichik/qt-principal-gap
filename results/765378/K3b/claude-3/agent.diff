+    // ~QEvent() may run arbitrary code, including posting new events (e.g.
+    // deleteLater()), so we must not hold the mutex while deleting, and we
+    // need to repeat until the list stays empty -- but not forever.
+    constexpr int MaxPasses = 16;
+    for (int pass = 0; ; ++pass) {
+        QList<QPostEvent> events;
+        {
+            const auto locker = qt_scoped_lock(postEventList.mutex);
+            events.swap(static_cast<QList<QPostEvent> &>(postEventList));
+            postEventList.recursion = 0;
+            postEventList.startOffset = 0;
+            postEventList.insertionOffset = 0;
+
+            // Unpost the whole batch before deleting any of it: a destructor
+            // may destroy another receiver in the same batch.
+            for (const QPostEvent &pe : std::as_const(events)) {
+                if (pe.event) {
+                    pe.receiver->d_func()->postedEvents.fetchAndSubAcquire(1);
+                    pe.event->m_posted = false;
+                }
+            }
         }
+
+        if (events.isEmpty())
+            return;
+
+        if (pass == MaxPasses) {
+            qWarning("QThreadData: events kept being posted while clearing the event queue; "
+                     "leaking %lld remaining event(s)", qlonglong(events.size()));
+            return;
+        }
+
+        for (const QPostEvent &pe : std::as_const(events))
+            delete pe.event;
     }
-    postEventList.clear();
