+void tst_QCoreApplication::postFromPendingEventDestructorOnExit()
+{
+    // Events still pending when the application is destroyed must be deleted
+    // without holding the post event list mutex, or a destructor that posts
+    // events (directly or via deleteLater()) deadlocks.
+    static int destroyedCount;
+    destroyedCount = 0;
+    struct Receiver : QObject
+    {
+        ~Receiver() override { ++destroyedCount; }
+    };
+    class PostingEvent : public QEvent
+    {
+    public:
+        PostingEvent(QObject *later, QObject *other, QObject *receiver)
+            : QEvent(QEvent::User), later(later), other(other), receiver(receiver) {}
+        ~PostingEvent() override
+        {
+            later->deleteLater();
+            QCoreApplication::postEvent(receiver, new QEvent(QEvent::Type(QEvent::User + 1)));
+            delete other; // also has an event pending in the same batch
+            delete receiver;
+        }
+    private:
+        QObject *later;
+        QObject *other;
+        QObject *receiver;
+    };
+
+    auto later = new Receiver;
+    {
+        int argc = 1;
+        char *argv[] = { const_cast<char*>(QTest::currentAppName()) };
+        TestApplication app(argc, argv);
+
+        auto other = new Receiver;
+        auto receiver = new Receiver;
+        QCoreApplication::postEvent(&app, new PostingEvent(later, other, receiver));
+        QCoreApplication::postEvent(other, new QEvent(QEvent::Type(QEvent::User + 2)));
+    }
+    QCOMPARE(destroyedCount, 2);
+    delete later; // its DeferredDelete was discarded, not delivered
+    QCOMPARE(destroyedCount, 3);
+}
+
+void tst_QCoreApplication::endlessPostingFromPendingEventDestructorOnExit()
+{
+    // An event that keeps re-posting itself on destruction must not make
+    // application shutdown loop forever.
+    class ReplicatingEvent : public QEvent
+    {
+    public:
+        explicit ReplicatingEvent(QObject *target) : QEvent(QEvent::User), target(target) {}
+        ~ReplicatingEvent() override
+        {
+            QCoreApplication::postEvent(target, new ReplicatingEvent(target));
+        }
+    private:
+        QObject *target;
+    };
+
+    QObject target;
+    int argc = 1;
+    char *argv[] = { const_cast<char*>(QTest::currentAppName()) };
+    {
+        TestApplication app(argc, argv);
+        QCoreApplication::postEvent(&target, new ReplicatingEvent(&target));
+        QTest::ignoreMessage(QtWarningMsg,
+                             QRegularExpression("leaking 1 remaining event"));
+    }
+    // A new application must start with a clean event queue.
+    TestApplication app(argc, argv);
+    EventSpy spy;
+    app.installEventFilter(&spy);
+    QCoreApplication::processEvents();
+    QVERIFY(!spy.recordedEvents.contains(QEvent::User));
+}
