+    // ~QEvent() may run arbitrary code, including posting new events (e.g.
+    // deleteLater()), so we must not hold the mutex while deleting, and we
+    // need to repeat until the list stays empty. Limit the number of passes
+    // so that an event that always posts a new one can't loop forever.
+    constexpr int MaxPasses = 16;
+    for (int pass = 0; ; ++pass) {
+        QList<QPostEvent> events;
+        {
+            const auto locker = qt_scoped_lock(postEventList.mutex);
+            events.swap(postEventList);
+            postEventList.startOffset = 0;
+            postEventList.insertionOffset = 0;
+
+            // unpost the whole batch before deleting any of it, as an event's
+            // destructor may destroy the receiver of another event
+            for (const QPostEvent &pe : std::as_const(events)) {
+                if (pe.event) {
+                    pe.receiver->d_func()->postedEvents.fetchAndSubAcquire(1);
+                    pe.event->m_posted = false;
+                }
+            }
         }
+        if (events.isEmpty())
+            return;
+        if (pass == MaxPasses) {
+            qWarning("QThreadData::clearEvents: events keep being posted while clearing the "
+                     "event queue; giving up after %d passes and leaking %lld event(s)",
+                     MaxPasses, qlonglong(events.size()));
+            return;
+        }
+        for (const QPostEvent &pe : std::as_const(events))
+            delete pe.event;
