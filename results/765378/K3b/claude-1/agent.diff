+void tst_QCoreApplication::postFromEventDestructorOnAppDestruction()
+{
+    struct PostingEvent : QEvent
+    {
+        PostingEvent(QObject *target, int *reposts)
+            : QEvent(QEvent::User), target(target), reposts(reposts) {}
+        ~PostingEvent() override
+        {
+            if (*reposts > 0) {
+                --*reposts;
+                QCoreApplication::postEvent(target, new PostingEvent(target, reposts));
+            }
+            target->deleteLater();
+        }
+        QObject *target;
+        int *reposts;
+    };
+
+    // pending events whose destructor posts new ones must not deadlock
+    // while the application is destroyed, and must all be destroyed
+    {
+        int reposts = 3;
+        QObject *receiver = nullptr;
+        {
+            int argc = 1;
+            char *argv[] = { const_cast<char*>(QTest::currentAppName()) };
+            TestApplication app(argc, argv);
+            receiver = new QObject;
+            QCoreApplication::postEvent(receiver, new PostingEvent(receiver, &reposts));
+        }
+        QCOMPARE(reposts, 0);
+        QCOMPARE(QObjectPrivate::get(receiver)->postedEvents.loadRelaxed(), 0);
+        delete receiver;
+    }
+
+    // an event that always reposts must not loop forever
+    {
+        int reposts = std::numeric_limits<int>::max();
+        QObject *receiver = nullptr;
+        {
+            int argc = 1;
+            char *argv[] = { const_cast<char*>(QTest::currentAppName()) };
+            TestApplication app(argc, argv);
+            receiver = new QObject;
+            QCoreApplication::postEvent(receiver, new PostingEvent(receiver, &reposts));
+            QTest::ignoreMessage(QtWarningMsg,
+                                 QRegularExpression("QThreadData::clearEvents: .*giving up"));
+        }
+        QVERIFY(reposts > 0);
+        QCOMPARE(QObjectPrivate::get(receiver)->postedEvents.loadRelaxed(), 0);
+        delete receiver;
+    }
+}
+
+void tst_QCoreApplication::eventDestructorDeletesOtherReceiverOnAppDestruction()
+{
+    struct DeletingEvent : QEvent
+    {
+        explicit DeletingEvent(QObject *victim) : QEvent(QEvent::User), victim(victim) {}
+        ~DeletingEvent() override { delete victim; }
+        QObject *victim;
+    };
+
+    int argc = 1;
+    char *argv[] = { const_cast<char*>(QTest::currentAppName()) };
+    QPointer<QObject> first, second;
+    {
+        TestApplication app(argc, argv);
+        first = new QObject;
+        second = new QObject;
+        // destroying the first event deletes the receiver of the second one
+        QCoreApplication::postEvent(first, new DeletingEvent(second));
+        QCoreApplication::postEvent(second, new DeletingEvent(first));
+    }
+    QVERIFY(!first);
+    QVERIFY(!second);
+}
