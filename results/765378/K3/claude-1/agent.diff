+void tst_QCoreApplication::pendingEventDestructorPostsOnAppExit()
+{
+    // A pending event whose destructor posts events or calls deleteLater()
+    // must not deadlock when the application is destroyed.
+    class MyEvent : public QEvent
+    { public:
+        MyEvent(QObject *o, int depth) : QEvent(QEvent::Type(QEvent::User + 1)), obj(o), depth(depth) {}
+        ~MyEvent() {
+            obj->deleteLater();
+            if (depth > 0)
+                QCoreApplication::postEvent(obj, new MyEvent(obj, depth - 1));
+        }
+        QObject *obj;
+        int depth;
+    };
+
+    QObject obj;
+    {
+        int argc = 1;
+        char *argv[] = { const_cast<char*>(QTest::currentAppName()) };
+        TestApplication app(argc, argv);
+        QCoreApplication::postEvent(&obj, new MyEvent(&obj, 3));
+        QCoreApplication::postEvent(&app, new QEvent(QEvent::Type(QEvent::User + 2)));
+    }
+    // everything posted from the destructors was discarded as well
+    QCOMPARE(QObjectPrivate::get(&obj)->postedEvents.loadRelaxed(), 0);
+}
