diff --git a/tests/auto/corelib/kernel/qcoreapplication/tst_qcoreapplication.cpp b/tests/auto/corelib/kernel/qcoreapplication/tst_qcoreapplication.cpp
index a06b883b..08aa309c 100644
--- a/tests/auto/corelib/kernel/qcoreapplication/tst_qcoreapplication.cpp
+++ b/tests/auto/corelib/kernel/qcoreapplication/tst_qcoreapplication.cpp
@@ -1235,6 +1235,87 @@ void tst_QCoreApplication::QTBUG31606_QEventDestructorDeadLock()
     QVERIFY(spy.recordedEvents.contains(QEvent::User + 2));
 }
 
+namespace {
+struct PostingEventCounters
+{
+    int destroyedEvents = 0;
+};
+
+// An event whose destructor posts another event (up to a depth) and
+// schedules an object for deletion. Both need the post-event-list mutex.
+class PostingInDestructorEvent : public QEvent
+{
+public:
+    PostingInDestructorEvent(QObject *receiver, PostingEventCounters *counters, int depth)
+        : QEvent(QEvent::User), receiver(receiver), counters(counters), depth(depth)
+    {}
+    ~PostingInDestructorEvent() override
+    {
+        ++counters->destroyedEvents;
+        (new QObject)->deleteLater();
+        if (depth > 0) {
+            QCoreApplication::postEvent(receiver,
+                                        new PostingInDestructorEvent(receiver, counters, depth - 1));
+        }
+    }
+
+private:
+    QObject *receiver;
+    PostingEventCounters *counters;
+    int depth;
+};
+} // unnamed namespace
+
+void tst_QCoreApplication::eventDestructorPostsEventsOnApplicationExit()
+{
+    PostingEventCounters counters;
+    QObject receiver;
+    {
+        int argc = 1;
+        char *argv[] = { const_cast<char*>(QTest::currentAppName()) };
+        TestApplication app(argc, argv);
+
+        QCoreApplication::postEvent(&receiver, new PostingInDestructorEvent(&receiver, &counters, 2));
+        QCoreApplication::postEvent(&app, new PostingInDestructorEvent(&app, &counters, 0));
+        // destroying the application with these events pending used to deadlock
+    }
+    QCOMPARE(counters.destroyedEvents, 4);
+}
+
+void tst_QCoreApplication::applicationDeletedDuringPostedEventDelivery()
+{
+    class Deleter : public QObject
+    {
+    public:
+        QCoreApplication *app = nullptr;
+        int userEvents = 0;
+        bool event(QEvent *e) override
+        {
+            if (e->type() == QEvent::User) {
+                ++userEvents;
+                delete std::exchange(app, nullptr);
+                return true;
+            }
+            return QObject::event(e);
+        }
+    };
+
+    int argc = 1;
+    char *argv[] = { const_cast<char*>(QTest::currentAppName()) };
+    Deleter deleter;
+    deleter.app = new TestApplication(argc, argv);
+
+    QCoreApplication::postEvent(&deleter, new QEvent(QEvent::User));
+    QCoreApplication::postEvent(&deleter, new QEvent(QEvent::User));
+    QCoreApplication::postEvent(&deleter, new QEvent(QEvent::User));
+
+    // The first event deletes the application, which discards the remaining
+    // events; the outer sendPostedEvents() must then cope with the emptied list.
+    QCoreApplication::sendPostedEvents();
+    QCOMPARE(deleter.userEvents, 1);
+    QCOMPARE(QCoreApplication::instance(), nullptr);
+}
+
