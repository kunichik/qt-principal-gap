+namespace {
+// An event whose destructor posts more events, like the ones from the
+// Windows Media Foundation backend. Deleting such an event while the post
+// event list's mutex is held deadlocks.
+class PostingFromDestructorEvent : public QEvent
+{
+public:
+    PostingFromDestructorEvent(QObject *target, int depth, int *liveCount)
+        : QEvent(QEvent::Type(QEvent::User + 1)), target(target), depth(depth),
+          liveCount(liveCount)
+    { ++*liveCount; }
+    ~PostingFromDestructorEvent() override
+    {
+        --*liveCount;
+        if (depth > 0) {
+            QCoreApplication::postEvent(target,
+                    new PostingFromDestructorEvent(target, depth - 1, liveCount));
+        }
+        target->deleteLater();
+    }
+
+    QObject *target;
+    int depth;
+    int *liveCount;
+};
+} // unnamed namespace
+
+void tst_QCoreApplication::postEventFromEventDestructorAtExit()
+{
+    int liveCount = 0;
+    QObject target;
+    {
+        int argc = 1;
+        char *argv[] = { const_cast<char*>(QTest::currentAppName()) };
+        TestApplication app(argc, argv);
+        QCoreApplication::postEvent(&target, new PostingFromDestructorEvent(&target, 3, &liveCount));
+        QCOMPARE(liveCount, 1);
+    }   // must not deadlock
+    QCOMPARE(liveCount, 0);
+    QCOMPARE(QObjectPrivate::get(&target)->postedEvents.loadRelaxed(), 0);
+}
+
+void tst_QCoreApplication::postEventFromEventDestructorAtThreadExit()
+{
+#if !QT_CONFIG(thread)
+    QSKIP("This test requires thread support");
+#else
+    int argc = 1;
+    char *argv[] = { const_cast<char*>(QTest::currentAppName()) };
+    TestApplication app(argc, argv);
+
+    int liveCount = 0;
+    auto *thread = new QThread;
+    QObject *target = new QObject;
+    target->moveToThread(thread);
+    QCoreApplication::postEvent(target, new PostingFromDestructorEvent(target, 3, &liveCount));
+    QCOMPARE(liveCount, 1);
+    // the thread never ran, so the events are destroyed with its QThreadData
+    delete thread;
+    QCOMPARE(liveCount, 0);
+    QCOMPARE(QObjectPrivate::get(target)->postedEvents.loadRelaxed(), 0);
+    delete target;
+#endif
+}
+
+void tst_QCoreApplication::destroyApplicationDuringEventDelivery()
+{
+    class DeleterObject : public QObject
+    {
+    public:
+        bool event(QEvent *e) override
+        {
+            if (e->type() == QEvent::User) {
+                delete QCoreApplication::instance();
+                return true;
+            }
+            return QObject::event(e);
+        }
+    };
+
+    int liveCount = 0;
+    DeleterObject deleter;
+    QObject target;
+    int argc = 1;
+    char *argv[] = { const_cast<char*>(QTest::currentAppName()) };
+    new TestApplication(argc, argv);
+    QCoreApplication::postEvent(&target, new PostingFromDestructorEvent(&target, 1, &liveCount));
+    QCoreApplication::postEvent(&deleter, new QEvent(QEvent::User), Qt::HighEventPriority);
+    QCoreApplication::postEvent(&target, new PostingFromDestructorEvent(&target, 1, &liveCount));
+    QCoreApplication::sendPostedEvents();
+    QVERIFY(!QCoreApplication::instance());
+    QCOMPARE(liveCount, 0);
+    QCOMPARE(QObjectPrivate::get(&target)->postedEvents.loadRelaxed(), 0);
+
+    // a new application must start out with a sane post event list
+    TestApplication app(argc, argv);
+    QCoreApplication::postEvent(&target, new QEvent(QEvent::User));
+    QCOMPARE(QObjectPrivate::get(&target)->postedEvents.loadRelaxed(), 1);
+    QCoreApplication::sendPostedEvents();
+    QCOMPARE(QObjectPrivate::get(&target)->postedEvents.loadRelaxed(), 0);
+}
