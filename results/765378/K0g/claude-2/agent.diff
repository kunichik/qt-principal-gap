+void tst_QCoreApplication::QEventDestructorDeadLockOnExit()
+{
+    // Pending events are deleted when the application is destroyed; their
+    // destructors must be able to post events without deadlocking.
+    class MyEvent : public QEvent
+    { public:
+        MyEvent(QObject *target, bool *destroyed)
+            : QEvent(QEvent::Type(QEvent::User + 1)), target(target), destroyed(destroyed) {}
+        ~MyEvent() {
+            target->deleteLater();
+            QCoreApplication::postEvent(target, new QEvent(QEvent::Type(QEvent::User + 2)));
+            *destroyed = true;
+        }
+        QObject *target;
+        bool *destroyed;
+    };
+
+    QObject receiver;
+    QObject target;
+    bool destroyed = false;
+    {
+        int argc = 1;
+        char *argv[] = { const_cast<char*>(QTest::currentAppName()) };
+        TestApplication app(argc, argv);
+
+        QCoreApplication::postEvent(&receiver, new MyEvent(&target, &destroyed));
+        QVERIFY(!destroyed);
+    }
+    QVERIFY(destroyed);
+}
