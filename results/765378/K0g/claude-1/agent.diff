+void tst_QCoreApplication::pendingEventDestructorPostsOnExit()
+{
+    // An event still pending when the application is destroyed is deleted
+    // during cleanup; its destructor posting events or calling deleteLater()
+    // must not deadlock.
+    class PostingEvent : public QEvent
+    {
+    public:
+        PostingEvent(QObject *target, QObject *toDelete)
+            : QEvent(QEvent::Type(QEvent::User + 1)), target(target), toDelete(toDelete) {}
+        ~PostingEvent() override
+        {
+            QCoreApplication::postEvent(target, new QEvent(QEvent::Type(QEvent::User + 2)));
+            toDelete->deleteLater();
+        }
+        QObject *target;
+        QObject *toDelete;
+    };
+
+    QObject target;
+    QPointer<QObject> toDelete = new QObject;
+    {
+        int argc = 1;
+        char *argv[] = { const_cast<char*>(QTest::currentAppName()) };
+        TestApplication app(argc, argv);
+        QCoreApplication::postEvent(&target, new PostingEvent(&target, toDelete));
+        // leave the event pending while the application is destroyed
+    }
+    QVERIFY(toDelete); // DeferredDelete event was discarded, not delivered
+    delete toDelete.data();
+}
