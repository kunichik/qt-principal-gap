+void tst_QCoreApplication::postEventFromPendingEventDestructorOnExit()
+{
+    static int liveEvents = 0;
+    class CountedEvent : public QEvent
+    { public:
+        CountedEvent() : QEvent(QEvent::Type(QEvent::User + 2)) { ++liveEvents; }
+        ~CountedEvent() { --liveEvents; }
+    };
+    class MyEvent : public QEvent
+    { public:
+        MyEvent(QObject *receiver, QObject *toDelete)
+            : QEvent(QEvent::Type(QEvent::User + 1)), receiver(receiver), toDelete(toDelete)
+        { ++liveEvents; }
+        ~MyEvent() {
+            --liveEvents;
+            // Must not deadlock when run while the posted event list is being cleared
+            QCoreApplication::postEvent(receiver, new CountedEvent);
+            toDelete->deleteLater();
+        }
+        QObject *receiver;
+        QObject *toDelete;
+    };
+
+    QObject receiver;
+    std::unique_ptr<QObject> toDelete;
+    {
+        int argc = 1;
+        char *argv[] = { const_cast<char*>(QTest::currentAppName()) };
+        TestApplication app(argc, argv);
+
+        toDelete.reset(new QObject);
+        QCoreApplication::postEvent(&receiver, new MyEvent(&receiver, toDelete.get()));
+        QCOMPARE(liveEvents, 1);
+        // destroy the application with the event still pending
+    }
+    // events posted while cleaning up have been cleaned up as well
+    QCOMPARE(liveEvents, 0);
+    QCOMPARE(QObjectPrivate::get(&receiver)->postedEvents.loadRelaxed(), 0);
+    QCOMPARE(QObjectPrivate::get(toDelete.get())->postedEvents.loadRelaxed(), 0);
+}
