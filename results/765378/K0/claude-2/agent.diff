+void tst_QCoreApplication::eventDestructorPostsEventAtExit()
+{
+    // The destructor of an event that is still pending when the application
+    // is destroyed posts new events. This must not deadlock.
+    class MyEvent : public QEvent
+    { public:
+        MyEvent(QObject *receiver, QObject *toDelete)
+            : QEvent(QEvent::Type(QEvent::User + 1)), receiver(receiver), toDelete(toDelete) {}
+        ~MyEvent() override
+        {
+            QCoreApplication::postEvent(receiver, new QEvent(QEvent::Type(QEvent::User + 2)));
+            toDelete->deleteLater();
+        }
+        QObject *receiver;
+        QObject *toDelete;
+    };
+
+    QObject receiver;
+    QObject *toDelete = new QObject;
+    QPointer<QObject> guard(toDelete);
+    {
+        int argc = 1;
+        char *argv[] = { const_cast<char*>(QTest::currentAppName()) };
+        TestApplication app(argc, argv);
+
+        QCoreApplication::postEvent(&receiver, new MyEvent(&receiver, toDelete));
+    }
+
+    // The events posted from the destructor were discarded as well.
+    QVERIFY(guard);
+    QCOMPARE(QObjectPrivate::get(&receiver)->postedEvents.loadRelaxed(), 0);
+    QCOMPARE(QObjectPrivate::get(toDelete)->postedEvents.loadRelaxed(), 0);
+    delete toDelete;
+}
