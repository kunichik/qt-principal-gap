+void tst_QCoreApplication::pendingEventDestructorPostsOnExit()
+{
+    // An event still pending when the application is destroyed gets deleted
+    // during cleanup; its destructor must be able to post events and call
+    // deleteLater() without deadlocking.
+    static int destroyed = 0;
+    destroyed = 0;
+
+    class MyEvent : public QEvent
+    { public:
+        MyEvent(QObject *obj, int depth)
+            : QEvent(QEvent::Type(QEvent::User + 1)), obj(obj), depth(depth) {}
+        ~MyEvent() override {
+            ++destroyed;
+            obj->deleteLater();
+            if (depth > 0)
+                QCoreApplication::postEvent(obj, new MyEvent(obj, depth - 1));
+        }
+        QObject *obj;
+        int depth;
+    };
+
+    std::unique_ptr<QObject> obj;
+    {
+        int argc = 1;
+        char *argv[] = { const_cast<char*>(QTest::currentAppName()) };
+        TestApplication app(argc, argv);
+        obj = std::make_unique<QObject>();
+        QCoreApplication::postEvent(obj.get(), new MyEvent(obj.get(), 2));
+    }
+    QCOMPARE(destroyed, 3);
+}
