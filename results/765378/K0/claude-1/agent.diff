+void tst_QCoreApplication::pendingEventDestructorPostsEventOnExit()
+{
+    // Pending events are deleted when the application is destroyed; this
+    // must not deadlock if their destructors post further events.
+    class MyEvent : public QEvent
+    { public:
+        MyEvent(QObject *target) : QEvent(QEvent::Type(QEvent::User + 1)), target(target) {}
+        ~MyEvent() {
+            QCoreApplication::postEvent(target, new QEvent(QEvent::Type(QEvent::User + 2)));
+            target->deleteLater();
+        }
+        QObject *target;
+    };
+
+    int argc = 1;
+    char *argv[] = { const_cast<char*>(QTest::currentAppName()) };
+    QObject *target = nullptr;
+    QPointer<QObject> guard;
+    {
+        TestApplication app(argc, argv);
+        target = new QObject;
+        guard = target;
+        QCoreApplication::postEvent(&app, new MyEvent(target));
+    }
+    // The events posted from the destructor were discarded as well
+    QVERIFY(guard);
+    QCOMPARE(QObjectPrivate::get(target)->postedEvents.loadRelaxed(), 0);
+    delete target;
+}
+
+void tst_QCoreApplication::pendingEventDestructorPostsEventOnThreadExit()
+{
+    class MyEvent : public QEvent
+    { public:
+        MyEvent(QObject *target) : QEvent(QEvent::Type(QEvent::User + 1)), target(target) {}
+        ~MyEvent() {
+            for (int i = 0; i < 100; ++i)
+                QCoreApplication::postEvent(target, new QEvent(QEvent::Type(QEvent::User + 2)));
+        }
+        QObject *target;
+    };
+
+    int argc = 1;
+    char *argv[] = { const_cast<char*>(QTest::currentAppName()) };
+    TestApplication app(argc, argv);
+
+    QObject *target = nullptr;
+    // No event loop runs in the thread, so the event is still pending when
+    // the thread finishes.
+    std::unique_ptr<QThread> thread(QThread::create([&] {
+        target = new QObject;
+        QCoreApplication::postEvent(target, new MyEvent(target));
+    }));
+    thread->start();
+    QVERIFY(thread->wait(30000));
+    QVERIFY(target);
+    // pending events are deleted together with the thread
+    thread.reset();
+    QCOMPARE(QObjectPrivate::get(target)->postedEvents.loadRelaxed(), 0);
+    delete target;
+}
