+namespace ConnectRegistersTypes {
+struct Gadget
+{
+    Q_GADGET
+public:
+    int value = 0;
+};
+
+struct PlainValue
+{
+    int value = 0;
+};
+
+class Object : public QObject
+{
+    Q_OBJECT
+public:
+    enum Enum { A, B };
+    Q_ENUM(Enum)
+};
+
+class Sender : public QObject
+{
+    Q_OBJECT
+signals:
+    void gadgetSignal(ConnectRegistersTypes::Gadget);
+    void enumSignal(ConnectRegistersTypes::Object::Enum);
+    void pointerSignal(ConnectRegistersTypes::Object *);
+    void constPointerSignal(const ConnectRegistersTypes::Object *);
+    void plainSignal(const ConnectRegistersTypes::PlainValue &);
+};
+} // namespace ConnectRegistersTypes
+
+void tst_QObject::connectQueuedRegistersArgumentTypes()
+{
+    using namespace ConnectRegistersTypes;
+    const char *names[] = {
+        "ConnectRegistersTypes::Gadget",
+        "ConnectRegistersTypes::Object::Enum",
+        "ConnectRegistersTypes::Object*",
+        "const ConnectRegistersTypes::Object*",
+        "ConnectRegistersTypes::PlainValue",
+    };
+    for (const char *name : names)
+        QVERIFY2(!QMetaType::fromName(name).isValid(), name);
+
+    Sender sender;
+    QEventLoop loop;
+    int count = 0;
+    auto slot = [&](auto &&...) { if (++count == 5) loop.quit(); };
+    QVERIFY(connect(&sender, &Sender::gadgetSignal, this, slot, Qt::QueuedConnection));
+    QVERIFY(connect(&sender, &Sender::enumSignal, this, slot, Qt::QueuedConnection));
+    QVERIFY(connect(&sender, &Sender::pointerSignal, this, slot, Qt::QueuedConnection));
+    QVERIFY(connect(&sender, &Sender::constPointerSignal, this, slot, Qt::QueuedConnection));
+    QVERIFY(connect(&sender, &Sender::plainSignal, this, slot, Qt::QueuedConnection));
+
+    QCOMPARE(QMetaType::fromName(names[0]), QMetaType::fromType<Gadget>());
+    QCOMPARE(QMetaType::fromName(names[1]), QMetaType::fromType<Object::Enum>());
+    QCOMPARE(QMetaType::fromName(names[2]), QMetaType::fromType<Object *>());
+    QCOMPARE(QMetaType::fromName(names[3]), QMetaType::fromType<const Object *>());
+    QCOMPARE(QMetaType::fromName(names[4]), QMetaType::fromType<PlainValue>());
+
+    Object o;
+    emit sender.gadgetSignal(Gadget());
+    emit sender.enumSignal(Object::B);
+    emit sender.pointerSignal(&o);
+    emit sender.constPointerSignal(&o);
+    emit sender.plainSignal(PlainValue());
+    QCOMPARE(count, 0);
+    QTimer::singleShot(5000, &loop, &QEventLoop::quit);
+    loop.exec();
+    QCOMPARE(count, 5);
+}
+
 void tst_QObject::connectFunctorWithContext()
 {
     int status = 1;
