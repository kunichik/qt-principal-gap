diff --git a/src/corelib/kernel/qobject_impl.h b/src/corelib/kernel/qobject_impl.h
index 1c27e5fb..eefe68d1 100644
--- a/src/corelib/kernel/qobject_impl.h
+++ b/src/corelib/kernel/qobject_impl.h
@@ -20,22 +20,58 @@ namespace QtPrivate {
         ConnectionTypes<FunctionPointer<Signal>::Arguments>::types() returns an array
         of int that is suitable for the types arguments of the connection functions.
 
-        The array only exist of all the types are declared as a metatype
-        (detected using the TypesAreDeclaredMetaType helper struct)
-        If one of the type is not declared, the function return 0 and the signal
-        cannot be used in queued connection.
+        The array only exists if a meta type can be created for all the types,
+        that is, if they are declared as a metatype (Q_DECLARE_METATYPE) or are
+        complete, non-reference types (Q_GADGET, Q_ENUM, pointers to QObject,
+        etc.). Creating the array registers the types with the meta type system.
+        If that is not possible for one of the types, the function returns
+        nullptr and the types are looked up from the signal's signature when it
+        is emitted.
+
+        The completeness of a type can differ between translation units, so the
+        check is done with a type that is unique to each translation unit, the
+        same way moc-generated code does it with qTryMetaTypeInterfaceForType().
     */
-    template <typename ArgList> struct TypesAreDeclaredMetaType { enum { Value = false }; };
-    template <> struct TypesAreDeclaredMetaType<List<>> { enum { Value = true }; };
-    template <typename Arg, typename... Tail> struct TypesAreDeclaredMetaType<List<Arg, Tail...> >
-    { enum { Value = QMetaTypeId2<Arg>::Defined && TypesAreDeclaredMetaType<List<Tail...>>::Value }; };
-
-    template <typename ArgList, bool Declared = TypesAreDeclaredMetaType<ArgList>::Value > struct ConnectionTypes
-    { static const int *types() { return nullptr; } };
-    template <> struct ConnectionTypes<List<>, true>
-    { static const int *types() { return nullptr; } };
-    template <typename... Args> struct ConnectionTypes<List<Args...>, true>
-    { static const int *types() { static const int t[sizeof...(Args) + 1] = { (QtPrivate::QMetaTypeIdHelper<Args>::qt_metatype_id())..., 0 }; return t; } };
+    namespace { // allow different TUs to see different completeness of the arguments
+    struct ConnectionTypesUniqueTag {};
+    }
+
+    template <typename Unique, typename Arg>
+    constexpr bool connectionTypeIsMetaType()
+    {
+        if constexpr (bool(QMetaTypeId2<Arg>::Defined))
+            return true;
+        else
+            return qTryMetaTypeInterfaceForType<Unique, Arg>() != nullptr;
+    }
+
+    template <typename Unique, typename Arg>
+    int connectionTypeId()
+    {
+        if constexpr (bool(QMetaTypeId2<Arg>::Defined)) {
+            // may register a name that differs from the type's (typedefs)
+            return QMetaTypeIdHelper<Arg>::qt_metatype_id();
+        } else {
+            return QMetaType(qTryMetaTypeInterfaceForType<Unique, Arg>()).id();
+        }
+    }
+
+    template <typename ArgList, typename Unique = ConnectionTypesUniqueTag> struct ConnectionTypes;
+    template <typename Unique, typename... Args> struct ConnectionTypes<List<Args...>, Unique>
+    {
+        static const int *types()
+        {
+            if constexpr (sizeof...(Args) != 0
+                          && (connectionTypeIsMetaType<Unique, Args>() && ...)) {
+                static const int t[sizeof...(Args) + 1] = {
+                    connectionTypeId<Unique, Args>()..., 0
+                };
+                return t;
+            } else {
+                return nullptr;
+            }
+        }
+    };
 }
 
 
