+namespace ConnectRegistersArgumentMetaTypes {
+class Gadget
+{
+    Q_GADGET
+public:
+    int value = 0;
+};
+
+struct Plain
+{
+    int value = 0;
+};
+
+class Sender : public QObject
+{
+    Q_OBJECT
+public:
+    enum Enum { Zero, One, Two };
+    Q_ENUM(Enum)
+signals:
+    void gadgetSignal(const Gadget &, Enum);
+    void pointerSignal(Sender *, const Sender *);
+    void plainSignal(Plain);
+};
+} // namespace ConnectRegistersArgumentMetaTypes
+
+void tst_QObject::connectRegistersArgumentMetaTypes()
+{
+    using namespace ConnectRegistersArgumentMetaTypes;
+    const char *names[] = {
+        "ConnectRegistersArgumentMetaTypes::Gadget",
+        "ConnectRegistersArgumentMetaTypes::Sender::Enum",
+        "ConnectRegistersArgumentMetaTypes::Sender*",
+        "const ConnectRegistersArgumentMetaTypes::Sender*",
+        "ConnectRegistersArgumentMetaTypes::Plain",
+    };
+    for (const char *name : names)
+        QVERIFY2(!QMetaType::fromName(name).isValid(), name);
+
+    Sender sender;
+    int gadgetValue = -1;
+    Sender::Enum enumValue = Sender::Zero;
+    Sender *pointer = nullptr;
+    const Sender *constPointer = nullptr;
+    int plainValue = -1;
+    QVERIFY(connect(&sender, &Sender::gadgetSignal, this, [&](const Gadget &g, Sender::Enum e) {
+        gadgetValue = g.value;
+        enumValue = e;
+    }, Qt::QueuedConnection));
+    QVERIFY(connect(&sender, &Sender::pointerSignal, this, [&](Sender *p, const Sender *cp) {
+        pointer = p;
+        constPointer = cp;
+    }, Qt::QueuedConnection));
+    QVERIFY(connect(&sender, &Sender::plainSignal, this, [&](Plain p) {
+        plainValue = p.value;
+    }, Qt::QueuedConnection));
+
+    // connect() must have registered the argument types
+    for (const char *name : names)
+        QVERIFY2(QMetaType::fromName(name).isValid(), name);
+    QCOMPARE(QMetaType::fromName(names[0]), QMetaType::fromType<Gadget>());
+    QCOMPARE(QMetaType::fromName(names[1]), QMetaType::fromType<Sender::Enum>());
+    QCOMPARE(QMetaType::fromName(names[2]), QMetaType::fromType<Sender *>());
+    QCOMPARE(QMetaType::fromName(names[3]), QMetaType::fromType<const Sender *>());
+    QCOMPARE(QMetaType::fromName(names[4]), QMetaType::fromType<Plain>());
+
+    Gadget g;
+    g.value = 42;
+    emit sender.gadgetSignal(g, Sender::Two);
+    emit sender.pointerSignal(&sender, &sender);
+    emit sender.plainSignal(Plain{17});
+    QCOMPARE(gadgetValue, -1);
+    QTRY_COMPARE(gadgetValue, 42);
+    QCOMPARE(enumValue, Sender::Two);
+    QTRY_COMPARE(pointer, &sender);
+    QCOMPARE(constPointer, &sender);
+    QTRY_COMPARE(plainValue, 17);
+}
+
 void tst_QObject::connectFunctorWithContext()
 {
     int status = 1;
