+    template <typename... Args, typename Unique> struct ConnectionTypes<List<Args...>, Unique>
+    {
+        static const int *types()
+        {
+            if constexpr ((isConnectionTypeUsable<Unique, Args>() && ...)) {
+                static const int t[sizeof...(Args) + 1] = { connectionTypeId<Unique, Args>()..., 0 };
+                return t;
+            } else {
+                return nullptr;
+            }
+        }
+    };
