+namespace QueuedRegistration {
+struct Plain { int i = 0; };
+class Gadget
+{
+    Q_GADGET
+public:
+    int i = 0;
+};
+class Object : public QObject
+{
+    Q_OBJECT
+};
+class Sender : public QObject
+{
+    Q_OBJECT
+public:
+    enum class Enum { A, B };
+    Q_ENUM(Enum)
+signals:
+    void plainSignal(QueuedRegistration::Plain);
+    void gadgetSignal(const QueuedRegistration::Gadget &);
+    void enumSignal(QueuedRegistration::Sender::Enum);
+    void objectSignal(QueuedRegistration::Object *);
+    void constObjectSignal(const QueuedRegistration::Object *);
+};
+} // namespace QueuedRegistration
+
+void tst_QObject::connectQueuedRegistersArgumentTypes()
+{
+    using namespace QueuedRegistration;
+    const char *names[] = {
+        "QueuedRegistration::Plain",
+        "QueuedRegistration::Gadget",
+        "QueuedRegistration::Sender::Enum",
+        "QueuedRegistration::Object*",
+        "const QueuedRegistration::Object*",
+    };
+    for (const char *name : names)
+        QVERIFY2(!QMetaType::fromName(name).isValid(), name);
+
+    Sender sender;
+    auto noop = [] {};
+    connect(&sender, &Sender::plainSignal, this, noop, Qt::QueuedConnection);
+    connect(&sender, &Sender::gadgetSignal, this, noop, Qt::QueuedConnection);
+    connect(&sender, &Sender::enumSignal, this, noop, Qt::QueuedConnection);
+    connect(&sender, &Sender::objectSignal, this, noop, Qt::QueuedConnection);
+    connect(&sender, &Sender::constObjectSignal, this, noop, Qt::QueuedConnection);
+
+    for (const char *name : names)
+        QVERIFY2(QMetaType::fromName(name).isValid(), name);
+    QCOMPARE(QMetaType::fromName("QueuedRegistration::Gadget"),
+             QMetaType::fromType<Gadget>());
+    QCOMPARE(QMetaType::fromName("QueuedRegistration::Object*"),
+             QMetaType::fromType<Object *>());
+    QCOMPARE(QMetaType::fromName("const QueuedRegistration::Object*"),
+             QMetaType::fromType<const Object *>());
+
+    // queued delivery works
+    int received = 0;
+    QEventLoop e;
+    connect(&sender, &Sender::gadgetSignal, this, [&](const Gadget &g) {
+        received = g.i;
+        e.quit();
+    }, Qt::QueuedConnection);
+    Gadget g;
+    g.i = 42;
+    emit sender.gadgetSignal(g);
+    e.exec();
+    QCOMPARE(received, 42);
+}
+
 void tst_QObject::connectFunctorWithContext()
 {
     int status = 1;
