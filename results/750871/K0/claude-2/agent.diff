+namespace ConnectRegistration {
+class Gadget
+{
+    Q_GADGET
+public:
+    int value = 0;
+};
+
+class Object : public QObject
+{
+    Q_OBJECT
+public:
+    enum Enum { A, B };
+    Q_ENUM(Enum)
+};
+
+struct Plain
+{
+    int value = 0;
+};
+
+class Sender : public QObject
+{
+    Q_OBJECT
+signals:
+    void gadgetSignal(ConnectRegistration::Gadget);
+    void enumSignal(ConnectRegistration::Object::Enum);
+    void objectSignal(ConnectRegistration::Object *);
+    void constObjectSignal(const ConnectRegistration::Object *);
+    void plainSignal(const ConnectRegistration::Plain &);
+};
+} // namespace ConnectRegistration
+
+void tst_QObject::connectRegistersMetaTypes()
+{
+    using namespace ConnectRegistration;
+    const char *names[] = {
+        "ConnectRegistration::Gadget",
+        "ConnectRegistration::Object::Enum",
+        "ConnectRegistration::Object*",
+        "const ConnectRegistration::Object*",
+        "ConnectRegistration::Plain",
+    };
+    for (const char *name : names)
+        QVERIFY2(!QMetaType::fromName(name).isValid(), name);
+
+    Sender sender;
+    QObject receiver;
+    Gadget gadget;
+    Object::Enum e = Object::A;
+    Object *object = nullptr;
+    const Object *constObject = nullptr;
+    Plain plain;
+    QVERIFY(connect(&sender, &Sender::gadgetSignal, &receiver,
+                    [&](Gadget g) { gadget = g; }, Qt::QueuedConnection));
+    QVERIFY(connect(&sender, &Sender::enumSignal, &receiver,
+                    [&](Object::Enum v) { e = v; }, Qt::QueuedConnection));
+    QVERIFY(connect(&sender, &Sender::objectSignal, &receiver,
+                    [&](Object *o) { object = o; }, Qt::QueuedConnection));
+    QVERIFY(connect(&sender, &Sender::constObjectSignal, &receiver,
+                    [&](const Object *o) { constObject = o; }, Qt::QueuedConnection));
+    QVERIFY(connect(&sender, &Sender::plainSignal, &receiver,
+                    [&](const Plain &p) { plain = p; }, Qt::QueuedConnection));
+
+    QCOMPARE(QMetaType::fromName(names[0]), QMetaType::fromType<Gadget>());
+    QCOMPARE(QMetaType::fromName(names[1]), QMetaType::fromType<Object::Enum>());
+    QCOMPARE(QMetaType::fromName(names[2]), QMetaType::fromType<Object *>());
+    QCOMPARE(QMetaType::fromName(names[3]), QMetaType::fromType<const Object *>());
+    QCOMPARE(QMetaType::fromName(names[4]), QMetaType::fromType<Plain>());
+    QCOMPARE_NE(QMetaType::fromName(names[2]), QMetaType::fromName(names[3]));
+
+    Object obj;
+    emit sender.gadgetSignal(Gadget{42});
+    emit sender.enumSignal(Object::B);
+    emit sender.objectSignal(&obj);
+    emit sender.constObjectSignal(&obj);
+    emit sender.plainSignal(Plain{7});
+    QCoreApplication::processEvents();
+    QCOMPARE(gadget.value, 42);
+    QCOMPARE(e, Object::B);
+    QCOMPARE(object, &obj);
+    QCOMPARE(constObject, &obj);
+    QCOMPARE(plain.value, 7);
+}
