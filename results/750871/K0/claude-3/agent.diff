+namespace AutoRegistration {
+Q_NAMESPACE
+
+enum class Color { Red, Green };
+Q_ENUM_NS(Color)
+
+class Gadget
+{
+    Q_GADGET
+public:
+    int value = 0;
+};
+
+class PointedGadget
+{
+    Q_GADGET
+};
+
+struct Plain
+{
+    int value = 0;
+};
+
+class Object : public QObject
+{
+    Q_OBJECT
+};
+
+class ConstObject : public QObject
+{
+    Q_OBJECT
+};
+
+class Sender : public QObject
+{
+    Q_OBJECT
+signals:
+    void gadgetSignal(const AutoRegistration::Gadget &);
+    void pointerToGadgetSignal(AutoRegistration::PointedGadget *);
+    void enumSignal(AutoRegistration::Color);
+    void objectSignal(AutoRegistration::Object *);
+    void constObjectSignal(const AutoRegistration::ConstObject *);
+    void plainSignal(AutoRegistration::Plain);
+};
+} // namespace AutoRegistration
+
+void tst_QObject::connectRegistersArgumentTypes()
+{
+    using namespace AutoRegistration;
+    const QByteArrayList names = {
+        "AutoRegistration::Gadget",
+        "AutoRegistration::PointedGadget*",
+        "AutoRegistration::Color",
+        "AutoRegistration::Object*",
+        "const AutoRegistration::ConstObject*",
+        "AutoRegistration::Plain",
+    };
+    for (const QByteArray &name : names)
+        QVERIFY2(!QMetaType::fromName(name).isValid(), name.constData());
+
+    Sender sender;
+    QObject context;
+    const auto queued = Qt::QueuedConnection;
+    QVERIFY(connect(&sender, &Sender::gadgetSignal, &context, [](const Gadget &) {}, queued));
+    QVERIFY(connect(&sender, &Sender::pointerToGadgetSignal, &context, [](PointedGadget *) {}, queued));
+    QVERIFY(connect(&sender, &Sender::enumSignal, &context, [](Color) {}, queued));
+    QVERIFY(connect(&sender, &Sender::objectSignal, &context, [](Object *) {}, queued));
+    QVERIFY(connect(&sender, &Sender::constObjectSignal, &context, [](const ConstObject *) {}, queued));
+    QVERIFY(connect(&sender, &Sender::plainSignal, &context, [](Plain) {}, queued));
+
+    QCOMPARE(QMetaType::fromName("AutoRegistration::Gadget"), QMetaType::fromType<Gadget>());
+    QCOMPARE(QMetaType::fromName("AutoRegistration::PointedGadget*"), QMetaType::fromType<PointedGadget *>());
+    QCOMPARE(QMetaType::fromName("AutoRegistration::Color"), QMetaType::fromType<Color>());
+    QCOMPARE(QMetaType::fromName("AutoRegistration::Object*"), QMetaType::fromType<Object *>());
+    QCOMPARE(QMetaType::fromName("const AutoRegistration::ConstObject*"),
+             QMetaType::fromType<const ConstObject *>());
+    QCOMPARE(QMetaType::fromName("AutoRegistration::Plain"), QMetaType::fromType<Plain>());
+
+    // and the queued connections actually deliver the arguments
+    Gadget receivedGadget;
+    Plain receivedPlain;
+    QVERIFY(connect(&sender, &Sender::gadgetSignal, &context,
+                    [&](const Gadget &g) { receivedGadget = g; }, queued));
+    QVERIFY(connect(&sender, &Sender::plainSignal, &context,
+                    [&](Plain p) { receivedPlain = p; }, queued));
+    emit sender.gadgetSignal(Gadget{42});
+    emit sender.plainSignal(Plain{17});
+    QTRY_COMPARE(receivedGadget.value, 42);
+    QTRY_COMPARE(receivedPlain.value, 17);
+}
