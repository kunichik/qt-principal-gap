+namespace ConnectRegistration {
+struct RegGadget
+{
+    Q_GADGET
+public:
+    int value = 0;
+};
+
+class RegEnumHolder : public QObject
+{
+    Q_OBJECT
+public:
+    enum RegEnum { A, B };
+    Q_ENUM(RegEnum)
+};
+
+class RegObject : public QObject
+{
+    Q_OBJECT
+};
+
+class RegConstObject : public QObject
+{
+    Q_OBJECT
+};
+
+struct RegPlain
+{
+    int value = 0;
+};
+
+class RegSender : public QObject
+{
+    Q_OBJECT
+signals:
+    void gadgetSignal(ConnectRegistration::RegGadget);
+    void enumSignal(ConnectRegistration::RegEnumHolder::RegEnum);
+    void objectSignal(ConnectRegistration::RegObject *);
+    void constObjectSignal(const ConnectRegistration::RegConstObject *);
+    void plainSignal(const ConnectRegistration::RegPlain &);
+};
+} // namespace ConnectRegistration
+
+void tst_QObject::connectFunctorRegistersArgumentTypes()
+{
+    using namespace ConnectRegistration;
+    const char *names[] = {
+        "ConnectRegistration::RegGadget",
+        "ConnectRegistration::RegEnumHolder::RegEnum",
+        "ConnectRegistration::RegObject*",
+        "const ConnectRegistration::RegConstObject*",
+        "ConnectRegistration::RegPlain",
+    };
+    for (const char *name : names)
+        QVERIFY2(!QMetaType::fromName(name).isValid(), name);
+
+    RegSender sender;
+    QObject receiver;
+    QVERIFY(QObject::connect(&sender, &RegSender::gadgetSignal, &receiver,
+                             [](RegGadget) {}, Qt::QueuedConnection));
+    QVERIFY(QObject::connect(&sender, &RegSender::enumSignal, &receiver,
+                             [](RegEnumHolder::RegEnum) {}, Qt::QueuedConnection));
+    QVERIFY(QObject::connect(&sender, &RegSender::objectSignal, &receiver,
+                             [](RegObject *) {}, Qt::QueuedConnection));
+    QVERIFY(QObject::connect(&sender, &RegSender::constObjectSignal, &receiver,
+                             [](const RegConstObject *) {}, Qt::QueuedConnection));
+    QVERIFY(QObject::connect(&sender, &RegSender::plainSignal, &receiver,
+                             [](const RegPlain &) {}, Qt::QueuedConnection));
+
+    QCOMPARE(QMetaType::fromName(names[0]), QMetaType::fromType<RegGadget>());
+    QCOMPARE(QMetaType::fromName(names[1]), QMetaType::fromType<RegEnumHolder::RegEnum>());
+    QCOMPARE(QMetaType::fromName(names[2]), QMetaType::fromType<RegObject *>());
+    QCOMPARE(QMetaType::fromName(names[3]), QMetaType::fromType<const RegConstObject *>());
+    QCOMPARE(QMetaType::fromName(names[4]), QMetaType::fromType<RegPlain>());
+}
