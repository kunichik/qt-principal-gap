+namespace ConnectRegistersTypes {
+class Gadget
+{
+    Q_GADGET
+public:
+    int value = 0;
+};
+
+class EnumHolder : public QObject
+{
+    Q_OBJECT
+public:
+    enum Enum { A, B };
+    Q_ENUM(Enum)
+};
+
+class PointerTarget : public QObject
+{
+    Q_OBJECT
+};
+
+class ConstPointerTarget : public QObject
+{
+    Q_OBJECT
+};
+
+struct Plain
+{
+    int value = 0;
+};
+
+class Sender : public QObject
+{
+    Q_OBJECT
+signals:
+    void gadget(const ConnectRegistersTypes::Gadget &);
+    void enumeration(ConnectRegistersTypes::EnumHolder::Enum);
+    void pointer(ConnectRegistersTypes::PointerTarget *);
+    void constPointer(const ConnectRegistersTypes::ConstPointerTarget *);
+    void plain(ConnectRegistersTypes::Plain);
+};
+} // namespace ConnectRegistersTypes
+
+void tst_QObject::connectFunctorQueuedRegistersTypes()
+{
+    using namespace ConnectRegistersTypes;
+    const char *const names[] = {
+        "ConnectRegistersTypes::Gadget",
+        "ConnectRegistersTypes::EnumHolder::Enum",
+        "ConnectRegistersTypes::PointerTarget*",
+        "const ConnectRegistersTypes::ConstPointerTarget*",
+        "ConnectRegistersTypes::Plain",
+    };
+    for (const char *name : names)
+        QVERIFY2(!QMetaType::fromName(name).isValid(), name);
+
+    Sender sender;
+    Gadget receivedGadget;
+    Plain receivedPlain;
+    connect(&sender, &Sender::gadget, this,
+            [&](const Gadget &g) { receivedGadget = g; }, Qt::QueuedConnection);
+    connect(&sender, &Sender::enumeration, this, [](EnumHolder::Enum) {}, Qt::QueuedConnection);
+    connect(&sender, &Sender::pointer, this, [](PointerTarget *) {}, Qt::QueuedConnection);
+    connect(&sender, &Sender::constPointer, this, [](const ConstPointerTarget *) {},
+            Qt::QueuedConnection);
+    connect(&sender, &Sender::plain, this,
+            [&](Plain p) { receivedPlain = p; }, Qt::QueuedConnection);
+
+    for (const char *name : names)
+        QVERIFY2(QMetaType::fromName(name).isValid(), name);
+    QCOMPARE(QMetaType::fromName("ConnectRegistersTypes::Gadget"), QMetaType::fromType<Gadget>());
+    QCOMPARE(QMetaType::fromName("ConnectRegistersTypes::EnumHolder::Enum"),
+             QMetaType::fromType<EnumHolder::Enum>());
+    QCOMPARE(QMetaType::fromName("ConnectRegistersTypes::PointerTarget*"),
+             QMetaType::fromType<PointerTarget *>());
+    QCOMPARE(QMetaType::fromName("const ConnectRegistersTypes::ConstPointerTarget*"),
+             QMetaType::fromType<const ConstPointerTarget *>());
+    // registering the const pointer must not register the non-const one (QTBUG-147588)
+    QVERIFY(!QMetaType::fromName("ConnectRegistersTypes::ConstPointerTarget*").isValid());
+    QCOMPARE(QMetaType::fromName("ConnectRegistersTypes::Plain"), QMetaType::fromType<Plain>());
+
+    emit sender.gadget(Gadget{42});
+    emit sender.plain(Plain{17});
+    QCOMPARE(receivedGadget.value, 0);
+    QCOMPARE(receivedPlain.value, 0);
+    QCoreApplication::processEvents();
+    QCOMPARE(receivedGadget.value, 42);
+    QCOMPARE(receivedPlain.value, 17);
+}
