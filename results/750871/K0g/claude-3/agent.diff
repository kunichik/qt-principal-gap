diff --git a/src/corelib/kernel/qobject.cpp b/src/corelib/kernel/qobject.cpp
index d99593c4..7ee4a70c 100644
--- a/src/corelib/kernel/qobject.cpp
+++ b/src/corelib/kernel/qobject.cpp
@@ -5604,6 +5604,18 @@ QMetaObject::Connection QObjectPrivate::connectImpl(const QObject *sender, int s
 
     QMetaMethod method = QMetaObjectPrivate::signal(senderMetaObject, signal_index);
     Q_ASSERT(method.isValid());
+
+    // The caller could only compute the argument types if all of them are
+    // declared metatypes (see QtPrivate::ConnectionTypes). Otherwise, register
+    // the types moc recorded for the signal's arguments now, so they are
+    // available by name (e.g. via QMetaType::fromName()) once connected, like
+    // for the string-based connect(). The types array itself is still computed
+    // lazily on the first queued activation.
+    if (!types && (type == Qt::QueuedConnection || type == Qt::BlockingQueuedConnection)) {
+        for (int i = 0, count = method.parameterCount(); i < count; ++i)
+            method.parameterMetaType(i); // registers the type
+    }
+
     s->connectNotify(method);
 
     return ret;
