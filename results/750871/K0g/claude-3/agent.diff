+namespace ConnectRegistersMetaTypes {
+struct Gadget
+{
+    Q_GADGET
+public:
+    int i = 0;
+};
+struct Complete
+{
+    int i = 0;
+};
+class Object : public QObject
+{
+    Q_OBJECT
+};
+class Sender : public QObject
+{
+    Q_OBJECT
+public:
+    enum class Enum { A, B };
+    Q_ENUM(Enum)
+signals:
+    void gadgetSignal(const ConnectRegistersMetaTypes::Gadget &);
+    void enumSignal(ConnectRegistersMetaTypes::Sender::Enum);
+    void objectSignal(ConnectRegistersMetaTypes::Object *);
+    void constObjectSignal(const ConnectRegistersMetaTypes::Object *);
+    void completeSignal(const ConnectRegistersMetaTypes::Complete &);
+};
+} // namespace ConnectRegistersMetaTypes
+
+void tst_QObject::connectFunctorQueuedRegistersMetaTypes()
+{
+    using namespace ConnectRegistersMetaTypes;
+    const char *names[] = {
+        "ConnectRegistersMetaTypes::Gadget",
+        "ConnectRegistersMetaTypes::Sender::Enum",
+        "ConnectRegistersMetaTypes::Object*",
+        "const ConnectRegistersMetaTypes::Object*",
+        "ConnectRegistersMetaTypes::Complete",
+    };
+    for (const char *name : names)
+        QVERIFY2(!QMetaType::fromName(name).isValid(), name);
+
+    Sender s;
+    QVERIFY(connect(&s, &Sender::gadgetSignal, this, [] {}, Qt::QueuedConnection));
+    QVERIFY(connect(&s, &Sender::enumSignal, this, [] {}, Qt::QueuedConnection));
+    QVERIFY(connect(&s, &Sender::objectSignal, this, [] {}, Qt::QueuedConnection));
+    QVERIFY(connect(&s, &Sender::constObjectSignal, this, [] {}, Qt::QueuedConnection));
+    QVERIFY(connect(&s, &Sender::completeSignal, this, [] {}, Qt::QueuedConnection));
+
+    QCOMPARE(QMetaType::fromName(names[0]), QMetaType::fromType<Gadget>());
+    QCOMPARE(QMetaType::fromName(names[1]), QMetaType::fromType<Sender::Enum>());
+    QCOMPARE(QMetaType::fromName(names[2]), QMetaType::fromType<Object *>());
+    QCOMPARE(QMetaType::fromName(names[3]), QMetaType::fromType<const Object *>());
+    QCOMPARE(QMetaType::fromName(names[4]), QMetaType::fromType<Complete>());
+}
