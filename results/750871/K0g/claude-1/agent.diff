+struct ConnectAutoRegGadget
+{
+    Q_GADGET
+public:
+    int value = 0;
+};
+
+struct ConnectAutoRegComplete
+{
+    int value = 0;
+};
+
+class ConnectAutoRegObject : public QObject
+{
+    Q_OBJECT
+public:
+    enum AutoRegEnum { AutoRegA, AutoRegB };
+    Q_ENUM(AutoRegEnum)
+signals:
+    void gadgetSignal(ConnectAutoRegGadget);
+    void gadgetRefSignal(const ConnectAutoRegGadget &);
+    void enumSignal(ConnectAutoRegObject::AutoRegEnum);
+    void objectPtrSignal(ConnectAutoRegObject *);
+    void constObjectPtrSignal(const ConnectAutoRegObject *);
+    void completeSignal(ConnectAutoRegComplete);
+};
+
+void tst_QObject::connectRegistersArgumentTypes()
+{
+    // Connecting must register the signal's argument types, even when they
+    // were not declared with Q_DECLARE_METATYPE.
+    ConnectAutoRegObject o;
+    auto connectQueued = [&o](auto signal) {
+        return bool(connect(&o, signal, &o, [](auto) {}, Qt::QueuedConnection));
+    };
+
+    QVERIFY(!QMetaType::fromName("ConnectAutoRegGadget").isValid());
+    QVERIFY(connectQueued(&ConnectAutoRegObject::gadgetSignal));
+    QCOMPARE(QMetaType::fromName("ConnectAutoRegGadget"),
+             QMetaType::fromType<ConnectAutoRegGadget>());
+
+    QVERIFY(!QMetaType::fromName("ConnectAutoRegObject::AutoRegEnum").isValid());
+    QVERIFY(connectQueued(&ConnectAutoRegObject::enumSignal));
+    QCOMPARE(QMetaType::fromName("ConnectAutoRegObject::AutoRegEnum"),
+             QMetaType::fromType<ConnectAutoRegObject::AutoRegEnum>());
+
+    QVERIFY(!QMetaType::fromName("ConnectAutoRegObject*").isValid());
+    QVERIFY(connectQueued(&ConnectAutoRegObject::objectPtrSignal));
+    QCOMPARE(QMetaType::fromName("ConnectAutoRegObject*"),
+             QMetaType::fromType<ConnectAutoRegObject *>());
+
+    QVERIFY(!QMetaType::fromName("const ConnectAutoRegObject*").isValid());
+    QVERIFY(connectQueued(&ConnectAutoRegObject::constObjectPtrSignal));
+    QCOMPARE(QMetaType::fromName("const ConnectAutoRegObject*"),
+             QMetaType::fromType<const ConnectAutoRegObject *>());
+
+    QVERIFY(!QMetaType::fromName("ConnectAutoRegComplete").isValid());
+    QVERIFY(connectQueued(&ConnectAutoRegObject::completeSignal));
+    QCOMPARE(QMetaType::fromName("ConnectAutoRegComplete"),
+             QMetaType::fromType<ConnectAutoRegComplete>());
+
+    QVERIFY(connectQueued(&ConnectAutoRegObject::gadgetRefSignal));
+
+    // and the queued connections deliver
+    int received = 0;
+    connect(&o, &ConnectAutoRegObject::gadgetRefSignal, &o,
+            [&](const ConnectAutoRegGadget &g) { received = g.value; }, Qt::QueuedConnection);
+    ConnectAutoRegComplete c;
+    c.value = 7;
+    connect(&o, &ConnectAutoRegObject::completeSignal, &o,
+            [&](ConnectAutoRegComplete v) { received += v.value; }, Qt::QueuedConnection);
+    ConnectAutoRegGadget g;
+    g.value = 35;
+    emit o.gadgetRefSignal(g);
+    emit o.completeSignal(c);
+    QTRY_COMPARE(received, 42);
+}
