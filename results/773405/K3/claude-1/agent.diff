+void tst_QCborStreamReader::floatingPoint()
+{
+    QFETCH_GLOBAL(bool, useDevice);
+    QFETCH(QByteArray, data);
+    QFETCH(double, expectedValue);
+    QFETCH(CborType, expectedType);
+
+    QBuffer buffer(&data);
+    QCborStreamReader reader(useDevice ? QByteArray() : data);
+    if (useDevice) {
+        buffer.open(QIODevice::ReadOnly);
+        reader.setDevice(&buffer);
+    }
+    QVERIFY(reader.isValid());
+    QCOMPARE(reader.lastError(), QCborError::NoError);
+    QCOMPARE(reader.isFloat16(), expectedType == CborHalfFloatType);
+    QCOMPARE(reader.isFloat(), expectedType == CborFloatType);
+    QCOMPARE(reader.isDouble(), expectedType == CborDoubleType);
+    QVERIFY(!reader.isInteger());
+    QVERIFY(reader.isNumber());
+
+    // QCOMPARE treats NaN as equal to NaN
+    QCOMPARE(reader.toNumber(), expectedValue);
+    if (reader.isFloat16())
+        QCOMPARE(reader.toNumber(), double(reader.toFloat16()));
+    else if (reader.isFloat())
+        QCOMPARE(reader.toNumber(), double(reader.toFloat()));
+    else
+        QCOMPARE(reader.toNumber(), reader.toDouble());
+}
