+
+    QBuffer buffer(&data);
+    QCborStreamReader reader(useDevice ? QByteArray() : data);
+    if (useDevice) {
+        buffer.open(QIODevice::ReadOnly);
+        reader.setDevice(&buffer);
+    }
+    QVERIFY(reader.isValid());
+    QCOMPARE(reader.lastError(), QCborError::NoError);
+    QVERIFY(reader.isNumber());
+    // QCOMPARE_EQ doesn't do fuzzy comparisons
+    QCOMPARE_EQ(reader.toNumber(), expectedValue);
+    QCOMPARE(std::signbit(reader.toNumber()), std::signbit(expectedValue));
+
+    // reading doesn't advance
+    QCOMPARE_EQ(reader.toNumber(), expectedValue);
