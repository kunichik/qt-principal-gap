+void tst_QCborStreamReader::numbers_data()
+{
+    QTest::addColumn<QByteArray>("data");
+    QTest::addColumn<double>("expectedValue");
+
+    // integers that are not exactly representable in double, including those
+    // outside of the qint64 range
+    QTest::newRow("2^53+1") << raw("\x1b\0\x20\0\0""\0\0\0\1") << 0x1p53;
+    QTest::newRow("2^53+3") << raw("\x1b\0\x20\0\0""\0\0\0\3") << 0x1p53 + 4;
+    QTest::newRow("-2^53-1") << raw("\x3b\0\x20\0\0""\0\0\0\0") << -0x1p53;
+    QTest::newRow("-2^53-2") << raw("\x3b\0\x20\0\0""\0\0\0\1") << -0x1p53 - 2;
+    QTest::newRow("-2^53-3") << raw("\x3b\0\x20\0\0""\0\0\0\2") << -0x1p53 - 4;
+    QTest::newRow("INT64_MAX") << raw("\x1b\x7f\xff\xff\xff""\xff\xff\xff\xff") << 0x1p63;
+    QTest::newRow("INT64_MIN") << raw("\x3b\x7f\xff\xff\xff""\xff\xff\xff\xff") << -0x1p63;
+    QTest::newRow("INT64_MIN-1") << raw("\x3b\x80\0\0\0""\0\0\0\0") << -0x1p63;
+    QTest::newRow("-2^63-2^11") << raw("\x3b\x80\0\0\0""\0\0\x07\xff") << -0x1p63 - 0x1p11;
+    QTest::newRow("UINT64_MAX") << raw("\x1b\xff\xff\xff\xff""\xff\xff\xff\xff") << 0x1p64;
+    QTest::newRow("-UINT64_MAX") << raw("\x3b\xff\xff\xff\xff""\xff\xff\xff\xfe") << -0x1p64;
+    QTest::newRow("-2^64") << raw("\x3b\xff\xff\xff\xff""\xff\xff\xff\xff") << -0x1p64;
+
+    // floating point that isn't an integer
+    QTest::newRow("1.5f16") << raw("\xf9\x3e\0") << 1.5;
+    QTest::newRow("0.1f") << raw("\xfa\x3d\xcc\xcc\xcd") << double(0.1f);
+    QTest::newRow("0.1") << raw("\xfb\x3f\xb9\x99\x99""\x99\x99\x99\x9a") << 0.1;
