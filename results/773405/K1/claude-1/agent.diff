 /*!
    \fn bool QCborStreamReader::isSimpleType() const
 
@@ -1297,6 +1310,50 @@ bool QCborStreamReader::leaveContainer()
    \sa isDouble(), toFloat16(), toFloat()
  */
 
+/*!
+   \since 6.13
+
+   Returns the value of the current element as a double-precision floating
+   point, whichever CBOR numeric type it is encoded as: unsigned or negative
+   integer, or half-, single- or double-precision floating point.
+
+   Floating point values of lower precision are converted to double without
+   loss. Integers whose magnitude exceeds 2\sup{53} may not be exactly
+   representable in a double and are rounded to the nearest representable
+   value. Unlike toInteger(), this function produces the correct value for
+   the whole range of CBOR integers, from -2\sup{64} to 2\sup{64} - 1.
+
+   This function does not perform any type conversions from non-numeric types,
+   including from boolean, null or CBOR tag (such as the bignum tags).
+   Therefore, it may only be called if isNumber() is true; calling it in any
+   other condition is an error.
+
+   \sa isNumber(), toInteger(), toFloat16(), toFloat(), toDouble()
+ */
+double QCborStreamReader::toNumber() const
+{
+    Q_ASSERT(isNumber());
+    switch (type()) {
+    case UnsignedInteger:
+        return double(value64);
+    case NegativeInteger:
+        // the value is -1 - value64; avoid rounding twice by not subtracting
+        // after the conversion to double
+        if (Q_UNLIKELY(value64 == std::numeric_limits<quint64>::max()))
+            return -0x1p64;
+        return -double(value64 + 1);
+    case Float16:
+        return float(toFloat16());
+    case Float:
+        return toFloat();
+    case Double:
+        return toDouble();
+    default:
+        break;
+    }
+    Q_UNREACHABLE_RETURN(qt_qnan());
+}
