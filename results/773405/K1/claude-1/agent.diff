+void tst_QCborStreamReader::numbers()
+{
+    QFETCH_GLOBAL(bool, useDevice);
+    QFETCH(QByteArray, data);
+    QFETCH(bool, isNumber);
+    QFETCH(double, expected);
+
+    QBuffer buffer(&data);
+    QCborStreamReader reader(useDevice ? QByteArray() : data);
+    if (useDevice) {
+        buffer.open(QIODevice::ReadOnly);
+        reader.setDevice(&buffer);
+    }
+    QVERIFY(reader.isValid());
+    QCOMPARE(reader.lastError(), QCborError::NoError);
+    QCOMPARE(reader.isNumber(), isNumber);
+    QCOMPARE(reader.isNumber(), reader.isInteger() || reader.isFloat16() || reader.isFloat()
+                                        || reader.isDouble());
+    if (!isNumber)
+        return;
+
+    double value = reader.toNumber();
+    if (qIsNaN(expected)) {
+        QVERIFY(qIsNaN(value));
+    } else {
+        // compare exactly, including the sign of zero
+        quint64 valueBits;
+        quint64 expectedBits;
+        memcpy(&valueBits, &value, sizeof(value));
+        memcpy(&expectedBits, &expected, sizeof(expected));
+        QCOMPARE(valueBits, expectedBits);
+        QCOMPARE(value, expected);
+    }
+
+    // the specific accessors must agree
+    if (reader.isInteger() && qAbs(expected) < 0x1p63)
+        QCOMPARE(double(reader.toInteger()), value);
+    else if (reader.isFloat16())
+        QCOMPARE(double(float(reader.toFloat16())), value);
+    else if (reader.isFloat())
+        QCOMPARE(double(reader.toFloat()), value);
+    else if (reader.isDouble())
+        QCOMPARE(reader.toDouble(), value);
+
+    QVERIFY(reader.next());
+    QVERIFY(!reader.hasNext());
+}
