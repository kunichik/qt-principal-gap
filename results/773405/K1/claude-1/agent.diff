+    addRow("65535", "\x19\xff\xff", 65535);
+    addRow("2^53", QByteArray("\x1b\x00\x20\x00\x00\x00\x00\x00\x00", 9), 0x1p53);
+    addRow("2^63", QByteArray("\x1b\x80\x00\x00\x00\x00\x00\x00\x00", 9), 0x1p63);
