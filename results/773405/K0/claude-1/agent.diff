@@ -1297,6 +1312,49 @@ bool QCborStreamReader::leaveContainer()
    \sa isDouble(), toFloat16(), toFloat()
  */
 
+/*!
+   \since 6.13
+
+   Returns the numeric value of the current element as a \c double, whatever
+   its CBOR type: unsigned or negative integer, or half-, single- or
+   double-precision floating point.
+
+   Floating point values are converted without loss, including infinities and
+   NaN. Integers whose magnitude exceeds 2\sup{53} may not be exactly
+   representable as a \c double; they are rounded to the nearest
+   representable value. If exact integer values are required, use
+   toInteger(), toUnsignedInteger() or toNegativeInteger() instead.
+
+   This function does not perform any other type conversions, including from
+   boolean or CBOR tag. Therefore, it may only be called if isNumber() is
+   true; calling it in any other condition is an error.
+
+   \sa isNumber(), toInteger(), toFloat16(), toFloat(), toDouble()
+ */
+double QCborStreamReader::toNumber() const
+{
+    Q_ASSERT(isNumber());
+    switch (type()) {
+    case UnsignedInteger:
+        return double(value64);
+    case NegativeInteger:
+        // the value is -1 - value64; avoid double rounding by negating first,
+        // except for -2^64, which can't be represented in a quint64
+        if (value64 == std::numeric_limits<quint64>::max())
+            return -0x1p64;
+        return -double(value64 + 1);
+    case Float16:
+        return double(toFloat16());
+    case Float:
+        return double(toFloat());
+    case Double:
+        return toDouble();
+    default:
+        break;
+    }
+    return qQNaN();
+}
