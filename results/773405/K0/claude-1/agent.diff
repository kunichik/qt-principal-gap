+void tst_QCborStreamReader::numbers_data()
+{
+    QTest::addColumn<QByteArray>("data");
+    QTest::addColumn<QCborStreamReader::Type>("expectedType");
+    QTest::addColumn<double>("expectedValue");
+
+    auto addRow = [](const char *name, const QByteArray &data, QCborStreamReader::Type type,
+                     double value) {
+        QTest::newRow(name) << data << type << value;
+    };
+    constexpr auto Unsigned = QCborStreamReader::UnsignedInteger;
+    constexpr auto Negative = QCborStreamReader::NegativeInteger;
+    constexpr auto Float16 = QCborStreamReader::Float16;
+    constexpr auto Float = QCborStreamReader::Float;
+    constexpr auto Double = QCborStreamReader::Double;
+
+    // integers
+    addRow("0", raw("\x00"), Unsigned, 0.);
+    addRow("1", raw("\x01"), Unsigned, 1.);
+    addRow("UINT32_MAX", raw("\x1a\xff\xff\xff\xff"), Unsigned, 4294967295.);
+    addRow("2^53", raw("\x1b\0\x20\0\0\0\0\0\0"), Unsigned, 0x1p53);
+    addRow("2^53+1", raw("\x1b\0\x20\0\0\0\0\0\1"), Unsigned, 0x1p53);
+    addRow("INT64_MAX", raw("\x1b\x7f\xff\xff\xff\xff\xff\xff\xff"), Unsigned, 0x1p63);
+    addRow("UINT64_MAX", raw("\x1b\xff\xff\xff\xff\xff\xff\xff\xff"), Unsigned, 0x1p64);
+    addRow("-1", raw("\x20"), Negative, -1.);
+    addRow("-UINT32_MAX-1", raw("\x3a\xff\xff\xff\xff"), Negative, -4294967296.);
+    // raw value 2^53+1, so the value is -(2^53+2), which is exactly representable
+    addRow("-2^53-2", raw("\x3b\0\x20\0\0\0\0\0\1"), Negative, -0x1p53 - 2);
+    addRow("INT64_MIN", raw("\x3b\x7f\xff\xff\xff\xff\xff\xff\xff"), Negative, -0x1p63);
+    addRow("-2^64", raw("\x3b\xff\xff\xff\xff\xff\xff\xff\xff"), Negative, -0x1p64);
+
+    // half-precision
+    addRow("0.f16", raw("\xf9\0\0"), Float16, 0.);
+    addRow("-1.f16", raw("\xf9\xbc\x00"), Float16, -1.);
+    addRow("0.5f16", raw("\xf9\x38\0"), Float16, 0.5);
+    addRow("65504.f16", raw("\xf9\x7b\xff"), Float16, 65504.);
+    addRow("+inf_f16", raw("\xf9\x7c\x00"), Float16, qInf());
+    addRow("-inf_f16", raw("\xf9\xfc\x00"), Float16, -qInf());
+    addRow("nan_f16", raw("\xf9\x7e\x00"), Float16, qQNaN());
+
+    // single-precision
+    addRow("0.f", raw("\xfa\0\0\0\0"), Float, 0.);
+    addRow("-1.f", raw("\xfa\xbf\x80\0\0"), Float, -1.);
+    addRow("0.1f", raw("\xfa\x3d\xcc\xcc\xcd"), Float, double(0.1f));
+    addRow("16777215.f", raw("\xfa\x4b\x7f\xff\xff"), Float, 16777215.);
+    addRow("+inf_f", raw("\xfa\x7f\x80\0\0"), Float, qInf());
+    addRow("nan_f", raw("\xfa\x7f\xc0\0\0"), Float, qQNaN());
+
+    // double-precision
+    addRow("0.", raw("\xfb\0\0\0\0\0\0\0\0"), Double, 0.);
+    addRow("-1.", raw("\xfb\xbf\xf0\0\0\0\0\0\0"), Double, -1.);
+    addRow("0.1", raw("\xfb\x3f\xb9\x99\x99\x99\x99\x99\x9a"), Double, 0.1);
+    addRow("2.^53-1", raw("\xfb\x43\x3f\xff\xff\xff\xff\xff\xff"), Double, 0x1p53 - 1);
+    addRow("-inf", raw("\xfb\xff\xf0\0\0\0\0\0\0"), Double, -qInf());
+    addRow("nan", raw("\xfb\x7f\xf8\0\0\0\0\0\0"), Double, qQNaN());
