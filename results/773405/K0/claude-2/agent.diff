+    add("f32:1", QByteArray::fromHex("fa3f800000"), 1);
+    add("f32:0.1", QByteArray::fromHex("fa3dcccccd"), double(0.1f));
+    add("f32:max", QByteArray::fromHex("fa7f7fffff"), double(std::numeric_limits<float>::max()));
+    add("f32:min_denorm", QByteArray::fromHex("fa00000001"), 0x1p-149);
+    add("f32:inf", QByteArray::fromHex("fa7f800000"), qInf());
+    add("f32:-inf", QByteArray::fromHex("faff800000"), -qInf());
+    add("f32:nan", QByteArray::fromHex("fa7fc00000"), qQNaN());
+
+    // double precision
+    add("f64:0", QByteArray::fromHex("fb0000000000000000"), 0);
