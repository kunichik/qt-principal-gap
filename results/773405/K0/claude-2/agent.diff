+/*!
+   \since 6.13
+
+   Returns the value of the current element as a \c double, whatever its CBOR
+   numeric type: unsigned integer, negative integer, or half-, single- or
+   double-precision floating point.
+
+   Integers whose magnitude exceeds 2\sup{53} may not be exactly representable
+   as a \c double and are rounded to the nearest representable value. This
+   includes the full range of CBOR integers, from -2\sup{64} to
+   2\sup{64} - 1, which toInteger() cannot represent. Floating point values,
+   including infinities and NaN, are converted without loss of precision.
+
+   This function does not perform any type conversions from non-numeric types,
+   such as booleans or CBOR tags. Therefore, it may only be called if
+   isNumber() is true; calling it in any other condition is an error.
+
+   \sa isNumber(), toInteger(), toUnsignedInteger(), toNegativeInteger(),
+       toFloat16(), toFloat(), toDouble()
+ */
+double QCborStreamReader::toNumber() const
+{
+    Q_ASSERT(isNumber());
+    switch (type()) {
+    case UnsignedInteger:
+        return double(value64);
+    case NegativeInteger:
+        // The value is -1 - value64. Compute the magnitude in integer
+        // arithmetic so it is rounded only once; it only overflows for
+        // -2^64, which is exactly representable.
+        if (value64 == std::numeric_limits<quint64>::max())
+            return -0x1p64;
+        return -double(value64 + 1);
+    case Float16:
+        return double(toFloat16());
+    case Float:
+        return double(toFloat());
+    case Double:
+        return toDouble();
+    default:
+        break;
+    }
+    return qQNaN();
+}
