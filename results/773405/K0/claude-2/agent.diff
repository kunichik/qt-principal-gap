+        QTest::newRow(name) << data << true << expected;
+    };
+    auto addNonNumber = [](const char *name, QByteArray data) {
+        QTest::newRow(name) << data << false << 0.0;
+    };
+
+    // integers
+    add("0", QByteArray::fromHex("00"), 0);
+    add("1", QByteArray::fromHex("01"), 1);
+    add("-1", QByteArray::fromHex("20"), -1);
+    add("1000000", QByteArray::fromHex("1a000f4240"), 1000000);
+    add("-1000000", QByteArray::fromHex("3a000f423f"), -1000000);
+    add("2^53", QByteArray::fromHex("1b0020000000000000"), 0x1p53);
+    add("-2^53", QByteArray::fromHex("3b001fffffffffffff"), -0x1p53);
+    add("2^63-1", QByteArray::fromHex("1b7fffffffffffffff"), 0x1p63);
+    add("-2^63", QByteArray::fromHex("3b7fffffffffffffff"), -0x1p63);
+    // beyond the qint64 range, which toInteger() can't handle
+    add("2^63", QByteArray::fromHex("1b8000000000000000"), 0x1p63);
+    add("-2^63-1", QByteArray::fromHex("3b8000000000000000"), -0x1p63);
+    add("2^64-1", QByteArray::fromHex("1bffffffffffffffff"), 0x1p64);
+    add("-2^64+1", QByteArray::fromHex("3bfffffffffffffffe"), -0x1p64);
+    add("-2^64", QByteArray::fromHex("3bffffffffffffffff"), -0x1p64);
