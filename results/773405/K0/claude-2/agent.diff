+    add("f16:1", QByteArray::fromHex("f93c00"), 1);
+    add("f16:-2", QByteArray::fromHex("f9c000"), -2);
+    add("f16:1.5", QByteArray::fromHex("f93e00"), 1.5);
+    add("f16:65504", QByteArray::fromHex("f97bff"), 65504);
+    add("f16:min_denorm", QByteArray::fromHex("f90001"), 0x1p-24);
