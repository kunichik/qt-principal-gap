+void tst_QCborStreamReader::numbers()
+{
+    QFETCH_GLOBAL(bool, useDevice);
+    QFETCH(QByteArray, data);
+    QFETCH(bool, isNumber);
+    QFETCH(double, expected);
+
+    QBuffer buffer(&data);
+    QCborStreamReader reader(useDevice ? QByteArray() : data);
+    if (useDevice) {
+        buffer.open(QIODevice::ReadOnly);
+        reader.setDevice(&buffer);
+    }
+    QVERIFY(reader.isValid());
+    QCOMPARE(reader.lastError(), QCborError::NoError);
+    QCOMPARE(reader.isNumber(), isNumber);
+    QCOMPARE(reader.isNumber(), reader.isInteger() || reader.isFloat16()
+                                || reader.isFloat() || reader.isDouble());
+    if (!isNumber)
+        return;
+
+    const double value = reader.toNumber();
+    if (qIsNaN(expected)) {
+        QVERIFY(qIsNaN(value));
+    } else {
+        QCOMPARE(value, expected);
+        QCOMPARE(std::signbit(value), std::signbit(expected));
+    }
+
+    // toNumber() must agree with the type-specific accessors
+    if (reader.isFloat16())
+        QCOMPARE(qIsNaN(value) || value == double(reader.toFloat16()), true);
+    else if (reader.isFloat())
+        QCOMPARE(qIsNaN(value) || value == double(reader.toFloat()), true);
+    else if (reader.isDouble())
+        QCOMPARE(qIsNaN(value) || value == reader.toDouble(), true);
+
+    // reading the value must not advance the stream
+    QVERIFY(reader.next());
+    QCOMPARE(reader.currentOffset(), data.size());
