+void tst_QCborStreamReader::numbers()
+{
+    QFETCH_GLOBAL(bool, useDevice);
+    QFETCH(QByteArray, data);
+    QFETCH(QCborStreamReader::Type, type);
+    QFETCH(double, expected);
+
+    QBuffer buffer(&data);
+    QCborStreamReader reader(useDevice ? QByteArray() : data);
+    if (useDevice) {
+        buffer.open(QIODevice::ReadOnly);
+        reader.setDevice(&buffer);
+    }
+    QVERIFY(reader.isValid());
+    QCOMPARE(reader.lastError(), QCborError::NoError);
+    QCOMPARE(reader.type(), type);
+
+    const bool isNumber = type == QCborStreamReader::UnsignedInteger
+            || type == QCborStreamReader::NegativeInteger
+            || type == QCborStreamReader::Float16
+            || type == QCborStreamReader::Float
+            || type == QCborStreamReader::Double;
+    QCOMPARE(reader.isNumber(), isNumber);
+    if (!isNumber)
+        return;
+
+    const double value = reader.toNumber();
+    if (qIsNaN(expected)) {
+        QVERIFY2(qIsNaN(value), QByteArray::number(value));
+    } else {
+        // exact comparison, including the sign of zero
+        QCOMPARE_EQ(value, expected);
+        QCOMPARE(std::signbit(value), std::signbit(expected));
+    }
+
+    // toNumber() agrees with the type-specific getters
+    switch (type) {
+    case QCborStreamReader::Float16:
+        if (!qIsNaN(expected))
+            QCOMPARE_EQ(value, double(reader.toFloat16()));
+        break;
+    case QCborStreamReader::Float:
+        if (!qIsNaN(expected))
+            QCOMPARE_EQ(value, double(reader.toFloat()));
+        break;
+    case QCborStreamReader::Double:
+        if (!qIsNaN(expected))
+            QCOMPARE_EQ(value, reader.toDouble());
+        break;
+    default:
+        break;
+    }
 }
 
