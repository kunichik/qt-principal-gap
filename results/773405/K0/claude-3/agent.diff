+void tst_QCborStreamReader::numbers_data()
+{
+    QTest::addColumn<QByteArray>("data");
+    QTest::addColumn<QCborStreamReader::Type>("type");
+    QTest::addColumn<double>("expected");
+
+    constexpr double inf = std::numeric_limits<double>::infinity();
+    constexpr double nan = std::numeric_limits<double>::quiet_NaN();
+    auto add = [](const char *name, QByteArrayView data, QCborStreamReader::Type type,
+                  double expected) {
+        QTest::newRow(name) << data.toByteArray() << type << expected;
+    };
+
+    // integers
+    add("0", QByteArrayView("\0", 1), QCborStreamReader::UnsignedInteger, 0);
+    add("-1", "\x20", QCborStreamReader::NegativeInteger, -1);
+    add("2^53", QByteArrayView("\x1b\0\x20\0\0\0\0\0\0", 9),
+        QCborStreamReader::UnsignedInteger, 0x1p53);
+    add("2^53+1", QByteArrayView("\x1b\0\x20\0\0\0\0\0\1", 9),
+        QCborStreamReader::UnsignedInteger, 0x1p53);     // rounds to even
+    add("-2^53-1", QByteArrayView("\x3b\0\x20\0\0\0\0\0\0", 9),
+        QCborStreamReader::NegativeInteger, -0x1p53);    // rounds to even
+    add("INT64_MIN-1", QByteArrayView("\x3b\x80\0\0\0\0\0\0\0", 9),
+        QCborStreamReader::NegativeInteger, -0x1p63);
+    add("UINT64_MAX", "\x1b\xff\xff\xff\xff\xff\xff\xff\xff",
+        QCborStreamReader::UnsignedInteger, 0x1p64);
+    add("-UINT64_MAX-1", "\x3b\xff\xff\xff\xff\xff\xff\xff\xff",
+        QCborStreamReader::NegativeInteger, -0x1p64);
+    add("-UINT64_MAX", "\x3b\xff\xff\xff\xff\xff\xff\xff\xfe",
+        QCborStreamReader::NegativeInteger, -0x1p64);
+
+    // half-precision
+    add("float16-0", QByteArrayView("\xf9\0\0", 3), QCborStreamReader::Float16, 0.);
+    add("float16--0", QByteArrayView("\xf9\x80\0", 3), QCborStreamReader::Float16, -0.);
+    add("float16-1.5", QByteArrayView("\xf9\x3e\0", 3), QCborStreamReader::Float16, 1.5);
+    add("float16-max", "\xf9\x7b\xff", QCborStreamReader::Float16, 65504.);
+    add("float16-denorm_min", QByteArrayView("\xf9\0\1", 3),
+        QCborStreamReader::Float16, 0x1p-24);
+    add("float16-inf", QByteArrayView("\xf9\x7c\0", 3), QCborStreamReader::Float16, inf);
+    add("float16--inf", QByteArrayView("\xf9\xfc\0", 3), QCborStreamReader::Float16, -inf);
+    add("float16-nan", QByteArrayView("\xf9\x7e\0", 3), QCborStreamReader::Float16, nan);
+
+    // single-precision
+    add("float-0", QByteArrayView("\xfa\0\0\0\0", 5), QCborStreamReader::Float, 0.);
+    add("float--0", QByteArrayView("\xfa\x80\0\0\0", 5), QCborStreamReader::Float, -0.);
+    add("float-0.1", "\xfa\x3d\xcc\xcc\xcd", QCborStreamReader::Float, double(0.1f));
+    add("float-max", "\xfa\x7f\x7f\xff\xff", QCborStreamReader::Float,
+        double(std::numeric_limits<float>::max()));
+    add("float-denorm_min", QByteArrayView("\xfa\0\0\0\1", 5),
+        QCborStreamReader::Float, 0x1p-149);
+    add("float-inf", QByteArrayView("\xfa\x7f\x80\0\0", 5), QCborStreamReader::Float, inf);
+    add("float--inf", QByteArrayView("\xfa\xff\x80\0\0", 5), QCborStreamReader::Float, -inf);
+    add("float-nan", QByteArrayView("\xfa\x7f\xc0\0\0", 5), QCborStreamReader::Float, nan);
+
+    // double-precision
+    add("double-0", QByteArrayView("\xfb\0\0\0\0\0\0\0\0", 9),
+        QCborStreamReader::Double, 0.);
+    add("double--0", QByteArrayView("\xfb\x80\0\0\0\0\0\0\0", 9),
+        QCborStreamReader::Double, -0.);
+    add("double-1.1", "\xfb\x3f\xf1\x99\x99\x99\x99\x99\x9a",
+        QCborStreamReader::Double, 1.1);
+    add("double-max", "\xfb\x7f\xef\xff\xff\xff\xff\xff\xff",
+        QCborStreamReader::Double, std::numeric_limits<double>::max());
+    add("double-denorm_min", QByteArrayView("\xfb\0\0\0\0\0\0\0\1", 9),
+        QCborStreamReader::Double, std::numeric_limits<double>::denorm_min());
+    add("double-inf", QByteArrayView("\xfb\x7f\xf0\0\0\0\0\0\0", 9),
+        QCborStreamReader::Double, inf);
+    add("double--inf", QByteArrayView("\xfb\xff\xf0\0\0\0\0\0\0", 9),
+        QCborStreamReader::Double, -inf);
+    add("double-nan", QByteArrayView("\xfb\x7f\xf8\0\0\0\0\0\0", 9),
+        QCborStreamReader::Double, nan);
+
+    // not numbers
+    add("false", "\xf4", QCborStreamReader::SimpleType, nan);
+    add("true", "\xf5", QCborStreamReader::SimpleType, nan);
+    add("null", "\xf6", QCborStreamReader::SimpleType, nan);
+    add("undefined", "\xf7", QCborStreamReader::SimpleType, nan);
+    add("simpletype", "\xe0", QCborStreamReader::SimpleType, nan);
+    add("bytearray", "\x41\x01", QCborStreamReader::ByteArray, nan);
+    add("string", "\x61" "1", QCborStreamReader::String, nan);
+    add("array", "\x81\x01", QCborStreamReader::Array, nan);
+    add("map", "\xa1\x01\x01", QCborStreamReader::Map, nan);
+    add("bignum", "\xc2\x41\x01", QCborStreamReader::Tag, nan);
+}
