+void tst_QCborStreamReader::numbers()
+{
+    QFETCH_GLOBAL(bool, useDevice);
+    QFETCH(QByteArray, data);
+    QFETCH(bool, isNumber);
+    QFETCH(double, expected);
+
+    QBuffer buffer(&data);
+    QCborStreamReader reader(useDevice ? QByteArray() : data);
+    if (useDevice) {
+        buffer.open(QIODevice::ReadOnly);
+        reader.setDevice(&buffer);
+    }
+    QVERIFY(reader.isValid());
+    QCOMPARE(reader.lastError(), QCborError::NoError);
+    QCOMPARE(reader.isNumber(), isNumber);
+    QCOMPARE(reader.isNumber(),
+             reader.isInteger() || reader.isFloat16() || reader.isFloat() || reader.isDouble());
+    if (!isNumber)
+        return;
+
+    const double actual = reader.toNumber();
+    if (qIsNaN(expected)) {
+        QVERIFY2(qIsNaN(actual), QByteArray::number(actual));
+    } else {
+        // QCOMPARE is fuzzy for doubles; we want the exact value and sign
+        QCOMPARE_EQ(actual, expected);
+        QCOMPARE(std::signbit(actual), std::signbit(expected));
+    }
+
+    // toNumber() must agree with the type-specific getters
+    switch (reader.type()) {
+    case QCborStreamReader::UnsignedInteger:
+        QCOMPARE(actual, double(reader.toUnsignedInteger()));
+        break;
+    case QCborStreamReader::NegativeInteger:
+        if (reader.toInteger() < 0)
+            QCOMPARE(actual, double(reader.toInteger()));
+        break;
+    case QCborStreamReader::Float16:
+        QCOMPARE(qIsNaN(actual), qIsNaN(reader.toFloat16()));
+        if (!qIsNaN(actual))
+            QCOMPARE(actual, double(reader.toFloat16()));
+        break;
+    case QCborStreamReader::Float:
+        QCOMPARE(qIsNaN(actual), qIsNaN(reader.toFloat()));
+        if (!qIsNaN(actual))
+            QCOMPARE(actual, double(reader.toFloat()));
+        break;
+    case QCborStreamReader::Double:
+        QCOMPARE(qIsNaN(actual), qIsNaN(reader.toDouble()));
+        if (!qIsNaN(actual))
+            QCOMPARE(actual, reader.toDouble());
+        break;
+    default:
+        QFAIL("isNumber() returned true for a non-numeric type");
+    }
+
+    // reading the value must not advance
+    QCOMPARE(reader.currentOffset(), 0);
+}
