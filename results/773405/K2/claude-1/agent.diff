+void tst_QCborStreamReader::numbers_data()
+{
+    QTest::addColumn<QByteArray>("data");
+    QTest::addColumn<bool>("isNumber");
+    QTest::addColumn<double>("expected");
+
+    constexpr double inf = std::numeric_limits<double>::infinity();
+    constexpr double nan = std::numeric_limits<double>::quiet_NaN();
+    // the data may contain NULs, so don't use strlen()
+    const auto row = [](const char *name, const auto &data, double expected) {
+        QTest::newRow(name) << QByteArray(data, sizeof(data) - 1) << true << expected;
+    };
+    const auto nonNumber = [](const char *name, const auto &data) {
+        QTest::newRow(name) << QByteArray(data, sizeof(data) - 1) << false << 0.0;
+    };
+
+    // integers
+    row("uint0", "\x00", 0);
+    row("uint23", "\x17", 23);
+    row("uint24", "\x18\x18", 24);
+    row("uint65535", "\x19\xff\xff", 65535);
+    row("uint4294967296", "\x1b\0\0\0\1\0\0\0\0", 4294967296.);
+    row("uint2^53", "\x1b\0\x20\0\0\0\0\0\0", 0x1p53);
+    row("uint2^63", "\x1b\x80\0\0\0\0\0\0\0", 0x1p63);
+    row("uint2^64-1", "\x1b\xff\xff\xff\xff\xff\xff\xff\xff", 0x1p64);
+    row("nint-1", "\x20", -1);
+    row("nint-24", "\x37", -24);
+    row("nint-25", "\x38\x18", -25);
+    row("nint-2^53", "\x3b\0\x1f\xff\xff\xff\xff\xff\xff", -0x1p53);
+    row("nint-2^63", "\x3b\x7f\xff\xff\xff\xff\xff\xff\xff", -0x1p63);
+    row("nint-2^63-1", "\x3b\x80\0\0\0\0\0\0\0", -0x1p63);
+    row("nint-2^64", "\x3b\xff\xff\xff\xff\xff\xff\xff\xff", -0x1p64);
+    // -1 - (2^63 + 3 * 2^10 - 1) is a tie and must round to even once, to
+    // -(2^63 + 2^12); converting value64 first and then subtracting 1 would
+    // produce -(2^63 + 2^11)
+    row("nint-single-rounding", "\x3b\x80\0\0\0\0\0\x0b\xff",
+        -(0x1p63 + 0x1p12));
+
+    // half precision
+    row("float16-0", "\xf9\0\0", 0);
+    row("float16--0", "\xf9\x80\0", -0.);
+    row("float16-1", "\xf9\x3c\0", 1);
+    row("float16-1.5", "\xf9\x3e\0", 1.5);
+    row("float16-65504", "\xf9\x7b\xff", 65504);
+    row("float16-min-subnormal", "\xf9\0\1", 0x1p-24);
+    row("float16-inf", "\xf9\x7c\0", inf);
+    row("float16--inf", "\xf9\xfc\0", -inf);
+    row("float16-nan", "\xf9\x7e\0", nan);
+
+    // single precision
+    row("float-0", "\xfa\0\0\0\0", 0);
+    row("float-1", "\xfa\x3f\x80\0\0", 1);
+    row("float-0.1", "\xfa\x3d\xcc\xcc\xcd", double(0.1f));
+    row("float-16777216", "\xfa\x4b\x80\0\0", 16777216);
+    row("float-max", "\xfa\x7f\x7f\xff\xff", double(std::numeric_limits<float>::max()));
+    row("float-inf", "\xfa\x7f\x80\0\0", inf);
+    row("float--inf", "\xfa\xff\x80\0\0", -inf);
+    row("float-nan", "\xfa\x7f\xc0\0\0", nan);
+
+    // double precision
+    row("double-0", "\xfb\0\0\0\0\0\0\0\0", 0);
+    row("double--0", "\xfb\x80\0\0\0\0\0\0\0", -0.);
+    row("double-0.1", "\xfb\x3f\xb9\x99\x99\x99\x99\x99\x9a", 0.1);
+    row("double--4.1", "\xfb\xc0\x10\x66\x66\x66\x66\x66\x66", -4.1);
+    row("double-max", "\xfb\x7f\xef\xff\xff\xff\xff\xff\xff",
+        std::numeric_limits<double>::max());
+    row("double-min-subnormal", "\xfb\0\0\0\0\0\0\0\1",
+        std::numeric_limits<double>::denorm_min());
+    row("double-inf", "\xfb\x7f\xf0\0\0\0\0\0\0", inf);
+    row("double-nan", "\xfb\x7f\xf8\0\0\0\0\0\0", nan);
+
+    // not numbers
+    nonNumber("false", "\xf4");
+    nonNumber("true", "\xf5");
+    nonNumber("null", "\xf6");
+    nonNumber("undefined", "\xf7");
+    nonNumber("simple32", "\xf8\x20");
+    nonNumber("bytearray", "\x41\x31");
+    nonNumber("string", "\x61\x31");
+    nonNumber("empty-array", "\x80");
+    nonNumber("empty-map", "\xa0");
+    nonNumber("array-of-number", "\x81\x01");
