+void tst_QCborStreamReader::numbers()
+{
+    QFETCH_GLOBAL(bool, useDevice);
+    QFETCH(QByteArray, data);
+    QFETCH(QCborStreamReader::Type, type);
+    QFETCH(double, expected);
+
+    QBuffer buffer(&data);
+    QCborStreamReader reader(useDevice ? QByteArray() : data);
+    if (useDevice) {
+        buffer.open(QIODevice::ReadOnly);
+        reader.setDevice(&buffer);
+    }
+    QVERIFY(reader.isValid());
+    QCOMPARE(reader.lastError(), QCborError::NoError);
+    QCOMPARE(reader.type(), type);
+    QVERIFY(reader.isNumber());
+
+    double value = reader.toNumber();
+    QCOMPARE(value, expected);  // QCOMPARE treats NaNs as equal
+    QCOMPARE(std::signbit(value), std::signbit(expected));
+
+    // check consistency with the type-specific getters
+    switch (type) {
+    case QCborStreamReader::Float16:
+        QCOMPARE(value, double(reader.toFloat16()));
+        break;
+    case QCborStreamReader::Float:
+        QCOMPARE(value, double(reader.toFloat()));
+        break;
+    case QCborStreamReader::Double:
+        QCOMPARE(value, reader.toDouble());
+        break;
+    default:
+        QVERIFY(reader.isInteger());
+        break;
+    }
+
+    QVERIFY(reader.next());
+    QVERIFY(!reader.hasNext());
+}
