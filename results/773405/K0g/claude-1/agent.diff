+    constexpr double nan = std::numeric_limits<double>::quiet_NaN();
+    auto add = [](const char *name, const auto &data, QCborStreamReader::Type type,
+                  double expected) {
+        // the data contains NULs, so don't stop at the first one
+        QTest::newRow(name) << QByteArray(data, sizeof(data) - 1) << type << expected;
+    };
