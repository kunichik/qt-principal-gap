+    add("0", "\x00", QCborStreamReader::UnsignedInteger, 0);
+    add("1", "\x01", QCborStreamReader::UnsignedInteger, 1);
+    add("24", "\x18\x18", QCborStreamReader::UnsignedInteger, 24);
+    add("65536", "\x1a\0\1\0\0", QCborStreamReader::UnsignedInteger, 65536);
+    add("2^53", "\x1b\0\x20\0\0\0\0\0\0", QCborStreamReader::UnsignedInteger,
