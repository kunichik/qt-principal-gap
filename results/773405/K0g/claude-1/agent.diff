+    add("f16-inf", "\xf9\x7c\0", QCborStreamReader::Float16, inf);
+    add("f16--inf", "\xf9\xfc\0", QCborStreamReader::Float16, -inf);
+    add("f16-nan", "\xf9\x7e\0", QCborStreamReader::Float16, nan);
