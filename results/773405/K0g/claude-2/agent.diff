+void tst_QCborStreamReader::floatingPoint_data()
+{
+    addFloatingPoint();
+
+    QTest::newRow("-0.f16") << raw("\xf9\x80\0") << -0. << CborHalfFloatType;
+    QTest::newRow("-0.f") << raw("\xfa\x80\0\0\0") << -0. << CborFloatType;
+    QTest::newRow("-0.") << raw("\xfb\x80\0\0\0\0\0\0\0") << -0. << CborDoubleType;
+    QTest::newRow("min_denorm_f16") << raw("\xf9\0\1") << 0x1p-24 << CborHalfFloatType;
+    QTest::newRow("min_denorm_f") << raw("\xfa\0\0\0\1") << 0x1p-149 << CborFloatType;
+    QTest::newRow("0.1f") << raw("\xfa\x3d\xcc\xcc\xcd") << double(0.1f) << CborFloatType;
+    QTest::newRow("0.1") << raw("\xfb\x3f\xb9\x99\x99\x99\x99\x99\x9a") << 0.1 << CborDoubleType;
+}
+
+void tst_QCborStreamReader::floatingPoint()
+{
+    QFETCH_GLOBAL(bool, useDevice);
+    QFETCH(QByteArray, data);
+    QFETCH(double, expectedValue);
+    QFETCH(CborType, expectedType);
+
+    QBuffer buffer(&data);
+    QCborStreamReader reader(useDevice ? QByteArray() : data);
+    if (useDevice) {
+        buffer.open(QIODevice::ReadOnly);
+        reader.setDevice(&buffer);
+    }
+    QVERIFY(reader.isValid());
+    QCOMPARE(reader.lastError(), QCborError::NoError);
+    QCOMPARE(reader.type(), QCborStreamReader::Type(expectedType));
+    QVERIFY(!reader.isInteger());
+    QVERIFY(reader.isNumber());
+
+    const double value = reader.toNumber();
+    if (qIsNaN(expectedValue)) {
+        QVERIFY(qIsNaN(value));
+    } else {
+        QCOMPARE_EQ(value, expectedValue);
+        QCOMPARE(std::signbit(value), std::signbit(expectedValue));
+    }
+
+    // must match the precision-specific getters
+    switch (reader.type()) {
+    case QCborStreamReader::Float16:
+        if (!qIsNaN(value))
+            QCOMPARE_EQ(value, double(reader.toFloat16()));
+        break;
+    case QCborStreamReader::Float:
+        if (!qIsNaN(value))
+            QCOMPARE_EQ(value, double(reader.toFloat()));
+        break;
+    case QCborStreamReader::Double:
+        if (!qIsNaN(value))
+            QCOMPARE_EQ(value, reader.toDouble());
+        break;
+    default:
+        QFAIL("Unexpected type");
+    }
+}
