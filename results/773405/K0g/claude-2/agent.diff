+void tst_QCborStreamReader::integersToNumber_data()
+{
+    QTest::addColumn<QByteArray>("data");
+    QTest::addColumn<double>("expectedValue");
+
+    // exactly representable
+    QTest::newRow("0") << raw("\x00") << 0.;
+    QTest::newRow("-1") << raw("\x20") << -1.;
+    QTest::newRow("2^53") << raw("\x1b\0\x20\0\0""\0\0\0\0") << 0x1p53;
+    QTest::newRow("-2^53") << raw("\x3b\0\x1f\xff\xff""\xff\xff\xff\xff") << -0x1p53;
+    QTest::newRow("INT64_MIN") << raw("\x3b\x7f\xff\xff\xff""\xff\xff\xff\xff") << -0x1p63;
+    QTest::newRow("-2^64") << raw("\x3b\xff\xff\xff\xff""\xff\xff\xff\xff") << -0x1p64;
+
+    // rounded to the nearest double (none of these are ties)
+    QTest::newRow("2^54+1") << raw("\x1b\0\x40\0\0""\0\0\0\1") << 0x1p54;
+    QTest::newRow("-(2^54+1)") << raw("\x3b\0\x40\0\0""\0\0\0\0") << -0x1p54;
+    // -(2^55 + 5) rounds to -(2^55 + 8), but first converting 2^55 + 4 to
+    // double and then subtracting 1 would produce -2^55
+    QTest::newRow("-(2^55+5)") << raw("\x3b\0\x80\0\0""\0\0\0\4") << -(0x1p55 + 8);
+    QTest::newRow("INT64_MAX") << raw("\x1b\x7f\xff\xff\xff""\xff\xff\xff\xff") << 0x1p63;
+    QTest::newRow("INT64_MIN-1") << raw("\x3b\x80\0\0\0""\0\0\0\0") << -0x1p63;
+    QTest::newRow("UINT64_MAX") << raw("\x1b\xff\xff\xff\xff""\xff\xff\xff\xff") << 0x1p64;
+    QTest::newRow("-UINT64_MAX") << raw("\x3b\xff\xff\xff\xff""\xff\xff\xff\xfe") << -0x1p64;
+}
