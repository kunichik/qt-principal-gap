+void tst_QUrl::toLocalFile_unsafe_data()
+{
+    QTest::addColumn<QString>("theUrl");
+
+    QTest::newRow("encoded-slash") << u"file:///tmp/a%2F..%2F..%2Fetc%2Fpasswd"_s;
+    QTest::newRow("encoded-slash-lowercase") << u"file:///tmp/a%2fb"_s;
+    QTest::newRow("encoded-slash-host") << u"file://somehost/a%2Fb"_s;
+    QTest::newRow("encoded-slash-relative") << u"file:a%2Fb"_s;
+    QTest::newRow("encoded-nul") << u"file:///tmp/a.txt%00.png"_s;
+    QTest::newRow("invalid-utf8-continuation") << u"file:///tmp/a%80b"_s;
+    QTest::newRow("invalid-utf8-truncated") << u"file:///tmp/a%C3"_s;
+    QTest::newRow("invalid-utf8-overlong-slash") << u"file:///tmp/a%C0%AFb"_s;
+    QTest::newRow("invalid-utf8-ff") << u"file:///tmp/%FF"_s;
+#ifdef Q_OS_WIN
+    QTest::newRow("encoded-backslash") << u"file:///c:/tmp/a%5C..%5Cb"_s;
+#endif
+}
+
+void tst_QUrl::toLocalFile_unsafe()
+{
+    QFETCH(QString, theUrl);
+
+    QUrl url(theUrl);
+    QVERIFY(url.isValid());
+    QVERIFY(url.isLocalFile());
+    QCOMPARE(url.toLocalFile(), QString());
+    QVERIFY(url.toLocalFile().isNull());
+
+    // PreferLocalFile falls back to the URL form
+    QCOMPARE(url.toString(QUrl::PreferLocalFile), url.toString());
+
+    // still the same after re-setting the encoded path
+    url.setPath(url.path(QUrl::FullyEncoded), QUrl::TolerantMode);
+    QVERIFY(url.toLocalFile().isNull());
+}
