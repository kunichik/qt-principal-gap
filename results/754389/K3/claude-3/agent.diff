+class ThreadNotifyObject : public QObject
+{
+    Q_OBJECT
+public:
+    struct Record {
+        QMutex mutex;
+        QList<QMetaMethod> disconnectedSignals;
+        QList<QThread *> threads;
+    };
+    explicit ThreadNotifyObject(Record *record) : record(record) {}
+signals:
+    void signal1();
+protected:
+    void disconnectNotify(const QMetaMethod &signal) override
+    {
+        QMutexLocker locker(&record->mutex);
+        record->disconnectedSignals.append(signal);
+        record->threads.append(QThread::currentThread());
+    }
+private:
+    Record *record;
+};
+
+void tst_QObject::disconnectNotify_receiverDestroyedCrossThread()
+{
+#if !QT_CONFIG(thread)
+    QSKIP("This test requires threads");
+#else
+    // When the receiver is destroyed in a thread other than the sender's,
+    // disconnectNotify() must be called in the sender's thread, since the
+    // sender may be running its own destructors concurrently.
+    QThread thread;
+    thread.start();
+    auto cleanup = qScopeGuard([&] { thread.quit(); thread.wait(); });
+
+    ThreadNotifyObject::Record record;
+    auto *sender = new ThreadNotifyObject(&record);
+    sender->moveToThread(&thread);
+    auto deleteSender = qScopeGuard([&] {
+        QMetaObject::invokeMethod(sender, [sender] { delete sender; }, Qt::BlockingQueuedConnection);
+    });
+
+    {
+        QObject receiver;
+        QVERIFY(QObject::connect(sender, &ThreadNotifyObject::signal1, &receiver, [] {}));
+    }
+
+    QTRY_COMPARE([&] {
+        QMutexLocker locker(&record.mutex);
+        return record.disconnectedSignals.size();
+    }(), 1);
+    QMutexLocker locker(&record.mutex);
+    QCOMPARE(record.disconnectedSignals.at(0), QMetaMethod::fromSignal(&ThreadNotifyObject::signal1));
+    QCOMPARE(record.threads.at(0), &thread);
+#endif
+}
+
+void tst_QObject::disconnectNotify_receiverDestroyedCrossThreadSenderDeleted()
+{
+#if !QT_CONFIG(thread)
+    QSKIP("This test requires threads");
+#else
+    // The deferred disconnectNotify() is discarded if the sender is destroyed
+    // in its own thread before it gets delivered.
+    QThread thread;
+    thread.start();
+    auto cleanup = qScopeGuard([&] { thread.quit(); thread.wait(); });
+
+    ThreadNotifyObject::Record record;
+    auto *sender = new ThreadNotifyObject(&record);
+    sender->moveToThread(&thread);
+
+    QSemaphore blockerStarted;
+    QSemaphore receiverDeleted;
+    QSemaphore senderDeleted;
+    QMetaObject::invokeMethod(sender, [&, sender] {
+        blockerStarted.release();
+        receiverDeleted.acquire();
+        delete sender;
+        senderDeleted.release();
+    });
+    blockerStarted.acquire();
+
+    {
+        QObject receiver;
+        QVERIFY(QObject::connect(sender, &ThreadNotifyObject::signal1, &receiver, [] {}));
+    }
+    receiverDeleted.release();
+    senderDeleted.acquire();
+
+    // flush the sender's thread's event queue
+    QMetaObject::invokeMethod(QAbstractEventDispatcher::instance(&thread), [] {},
+                              Qt::BlockingQueuedConnection);
+    QMutexLocker locker(&record.mutex);
+    QVERIFY(record.disconnectedSignals.isEmpty());
+#endif
+}
+
+void tst_QObject::disconnectNotify_receiverDestroyedFinishedThread()
+{
+#if !QT_CONFIG(thread)
+    QSKIP("This test requires threads");
+#else
+    // If the sender's thread can no longer deliver events, disconnectNotify()
+    // is called inline.
+    QThread thread;
+    thread.start();
+
+    ThreadNotifyObject::Record record;
+    ThreadNotifyObject sender(&record);
+    sender.moveToThread(&thread);
+
+    thread.quit();
+    QVERIFY(thread.wait());
+
+    {
+        QObject receiver;
+        QVERIFY(QObject::connect(&sender, &ThreadNotifyObject::signal1, &receiver, [] {}));
+    }
+
+    QMutexLocker locker(&record.mutex);
+    QCOMPARE(record.disconnectedSignals.size(), 1);
+    QCOMPARE(record.disconnectedSignals.at(0), QMetaMethod::fromSignal(&ThreadNotifyObject::signal1));
+    QCOMPARE(record.threads.at(0), QThread::currentThread());
+#endif
+}
