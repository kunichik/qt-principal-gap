+/*
+    \internal
+
+    Notifies \a sender that the connection from its signal \a signal_index is
+    going away because the receiver is being destroyed. Must be called with
+    the receiver's signalSlotLock() held and the connection still in the
+    sender's connection list; that keeps \a sender's QObject part alive, as its
+    destructor needs the receiver's lock to remove the connection.
+
+    Resolving the signal and calling disconnectNotify() are virtual calls, and
+    are only safe from the thread \a sender lives in: there, its derived-class
+    destructors can't be running concurrently and rewriting its vptr. So if
+    \a sender lives in another thread, the call is posted as a meta-call event
+    to \a sender and happens in \a sender's thread later. If \a sender is
+    destroyed before that, ~QObjectPrivate() discards the event and
+    disconnectNotify() is not called.
+
+    If \a sender's thread has no event dispatcher (it has finished, has not
+    been started yet, or is an adopted thread that never ran an event loop),
+    the event could not be delivered, so disconnectNotify() is called inline,
+    as before.
+*/
+static void disconnectNotifyFromReceiverDestructor(QObject *sender, int signal_index)
+{
+    QThreadData *senderThreadData = QObjectPrivate::get(sender)->threadData.loadAcquire();
+    if (senderThreadData->threadId.loadRelaxed() == QThread::currentThreadId()
+            || !senderThreadData->hasEventDispatcher()) {
+        QObjectPrivate::get(sender)->disconnectNotify(
+                    QMetaObjectPrivate::signal(sender->metaObject(), signal_index));
+        return;
+    }
+
+    auto notify = [sender, signal_index] {
+        QObjectPrivate::get(sender)->disconnectNotify(
+                    QMetaObjectPrivate::signal(sender->metaObject(), signal_index));
+    };
+    QCoreApplication::postEvent(sender,
+                                new QMetaCallEvent(QtPrivate::makeCallableObject<void (*)()>(std::move(notify)),
+                                                   nullptr, -1, nullptr, nullptr));
+}
