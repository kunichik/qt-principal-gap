+namespace {
+// Calls QObject::disconnectNotify() in the thread of the object it is delivered to.
+class QDisconnectNotifyEvent : public QAbstractMetaCallEvent
+{
+public:
+    explicit QDisconnectNotifyEvent(int signal_index)
+        : QAbstractMetaCallEvent(nullptr, -1), signal_index(signal_index)
+    {}
+
+    void placeMetaCall(QObject *object) override
+    {
+        QObjectPrivate::get(object)->disconnectNotify(signal_index);
+    }
+
+private:
+    int signal_index;
+};
+} // unnamed namespace
+
+/*!
+    \internal
+
+    Returns \c true if disconnectNotify() for \a sender must be posted to
+    sender's thread instead of being called from the current thread.
+
+    Calling disconnectNotify() (or the virtual metaObject() needed to compute its
+    argument) on an object living in another thread races with that thread
+    running the object's destructors, which rewrite its vptr. This is avoided by
+    posting the call to the sender's thread, as long as that thread can still
+    deliver events (it has an event dispatcher). Otherwise, the call is made
+    inline, as before.
+*/
+bool QObjectPrivate::mustPostDisconnectNotify(const QObject *sender)
+{
+    QThreadData *senderData = get(sender)->threadData.loadAcquire();
+    return senderData && senderData->thread.loadAcquire() != QThread::currentThread()
+            && senderData->hasEventDispatcher();
+}
+
+/*!
+    \internal
+
+    Posts a call to disconnectNotify() for \a signal_index to \a sender's thread.
+
+    The caller must hold \a sender's signalSlotLock() and ensure that \a sender
+    is still alive, for example because one of its connections is still in its
+    connection list: this guarantees that the event is posted before ~QObject()
+    of \a sender has finished disconnecting, so ~QObjectPrivate() discards it if
+    the sender gets destroyed before the event is delivered.
+*/
+void QObjectPrivate::postDisconnectNotify(QObject *sender, int signal_index)
+{
+    QCoreApplication::postEvent(sender, new QDisconnectNotifyEvent(signal_index));
+}
+
+/*!
+    \internal
+
+    Calls disconnectNotify() for \a signal_index. Must only be called from the
+    object's thread, or if mustPostDisconnectNotify() returned \c false.
+*/
+void QObjectPrivate::disconnectNotify(int signal_index)
+{
+    Q_Q(QObject);
+    q->disconnectNotify(QMetaObjectPrivate::signal(q->metaObject(), signal_index));
+}
