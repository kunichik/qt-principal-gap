+class CrossThreadNotifyObject : public SenderObject
+{
+public:
+    struct Notification
+    {
+        QMetaMethod signal;
+        QThread *thread;
+    };
+
+    QList<Notification> notifications() const
+    {
+        QMutexLocker locker(&mutex);
+        return disconnectNotifications;
+    }
+
+protected:
+    void disconnectNotify(const QMetaMethod &signal) override
+    {
+        QMutexLocker locker(&mutex);
+        disconnectNotifications.append({signal, QThread::currentThread()});
+    }
+
+private:
+    mutable QMutex mutex;
+    QList<Notification> disconnectNotifications;
+};
+
+void tst_QObject::disconnectNotify_receiverDestroyedSenderInOtherThread()
+{
+    QThread thread;
+    thread.start();
+    auto cleanup = qScopeGuard([&] {
+        thread.quit();
+        thread.wait();
+    });
+
+    CrossThreadNotifyObject s;
+    s.moveToThread(&thread);
+
+    // The sender's thread can deliver events: disconnectNotify() is called there.
+    {
+        QObject r;
+        QVERIFY(QObject::connect(&s, &SenderObject::signal1, &r, [] {}));
+    }
+    QTRY_COMPARE(s.notifications().size(), 1);
+    QCOMPARE(s.notifications().at(0).signal, QMetaMethod::fromSignal(&SenderObject::signal1));
+    QCOMPARE(s.notifications().at(0).thread, &thread);
+
+    // The sender's thread has finished: disconnectNotify() is called inline.
+    thread.quit();
+    QVERIFY(thread.wait());
+    {
+        QObject r;
+        QVERIFY(QObject::connect(&s, &SenderObject::signal2, &r, [] {}));
+    }
+    QCOMPARE(s.notifications().size(), 2);
+    QCOMPARE(s.notifications().at(1).signal, QMetaMethod::fromSignal(&SenderObject::signal2));
+    QCOMPARE(s.notifications().at(1).thread, QThread::currentThread());
+}
+
+void tst_QObject::disconnectNotify_destroyInParallel()
+{
+    // Destroying the receiver must not call into the sender while the sender is being
+    // destroyed in its own thread (detected by ThreadSanitizer).
+    QThread thread;
+    thread.start();
+    auto cleanup = qScopeGuard([&] {
+        thread.quit();
+        thread.wait();
+    });
+
+    for (int i = 0; i < 1000; ++i) {
+        auto s = new CrossThreadNotifyObject;
+        auto r = new QObject;
+        QVERIFY(QObject::connect(s, &SenderObject::signal1, r, [] {}));
+        s->moveToThread(&thread);
+        s->deleteLater();
+        delete r;
+    }
+}
