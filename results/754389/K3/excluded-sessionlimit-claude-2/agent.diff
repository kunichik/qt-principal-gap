+class ThreadRecordingNotifyObject : public QObject
+{
+    Q_OBJECT
+public:
+    QMutex mutex;
+    QList<QMetaMethod> disconnectedSignals;
+    QList<QThread *> disconnectThreads;
+signals:
+    void signal1();
+protected:
+    void disconnectNotify(const QMetaMethod &signal) override
+    {
+        QMutexLocker locker(&mutex);
+        disconnectedSignals.append(signal);
+        disconnectThreads.append(QThread::currentThread());
+    }
+};
+
+void tst_QObject::disconnectNotify_receiverDestroyedSenderInOtherThread()
+{
+    QThread thread;
+    thread.start();
+    auto cleanup = qScopeGuard([&] { thread.quit(); thread.wait(); });
+
+    auto *sender = new ThreadRecordingNotifyObject;
+    sender->moveToThread(&thread);
+
+    {
+        QObject receiver;
+        QVERIFY(QObject::connect(sender, &ThreadRecordingNotifyObject::signal1,
+                                 &receiver, [] {}));
+    }
+
+    // disconnectNotify() must run in the sender's thread, not in the
+    // thread destroying the receiver
+    QTRY_COMPARE([&] { QMutexLocker l(&sender->mutex); return sender->disconnectedSignals.size(); }(), 1);
+    {
+        QMutexLocker l(&sender->mutex);
+        QCOMPARE(sender->disconnectedSignals.at(0),
+                 QMetaMethod::fromSignal(&ThreadRecordingNotifyObject::signal1));
+        QCOMPARE(sender->disconnectThreads.at(0), &thread);
+    }
+
+    // If the sender is destroyed before the deferred notification is
+    // delivered, the notification is discarded.
+    auto *sender2 = new ThreadRecordingNotifyObject;
+    sender2->moveToThread(&thread);
+    QSemaphore blocked, release;
+    QMetaObject::invokeMethod(sender2, [&] { blocked.release(); release.acquire(); },
+                              Qt::QueuedConnection);
+    blocked.acquire();
+    {
+        QObject receiver;
+        QObject::connect(sender2, &ThreadRecordingNotifyObject::signal1, &receiver, [] {});
+    }
+    QMetaObject::invokeMethod(sender2, [sender2] { delete sender2; }, Qt::QueuedConnection);
+    release.release();
+
+    QMetaObject::invokeMethod(sender, [sender] { delete sender; }, Qt::BlockingQueuedConnection);
+}
+
+void tst_QObject::disconnectNotify_receiverDestroyedSenderThreadFinished()
+{
+    QThread thread;
+    thread.start();
+    ThreadRecordingNotifyObject sender;
+    sender.moveToThread(&thread);
+    thread.quit();
+    QVERIFY(thread.wait());
+
+    {
+        QObject receiver;
+        QVERIFY(QObject::connect(&sender, &ThreadRecordingNotifyObject::signal1,
+                                 &receiver, [] {}));
+    }
+    // the sender's thread can no longer deliver events: called inline
+    QCOMPARE(sender.disconnectedSignals.size(), 1);
+    QCOMPARE(sender.disconnectThreads.at(0), QThread::currentThread());
+}
+
+void tst_QObject::disconnectNotify_parallelDestruction()
+{
+    // Destroying a receiver must not call virtual functions on a sender
+    // living in another thread, which might be destroying itself at the
+    // same time (reported by ThreadSanitizer as a race on the vptr).
+    struct Sender : ThreadRecordingNotifyObject
+    {
+        ~Sender() override { QThread::yieldCurrentThread(); }
+    };
+
+    QThread thread;
+    thread.start();
+    auto cleanup = qScopeGuard([&] { thread.quit(); thread.wait(); });
+    QObject context;
+    context.moveToThread(&thread);
+
+    for (int i = 0; i < 200; ++i) {
+        auto *sender = new Sender;
+        auto *receiver = new QObject;
+        QObject::connect(sender, &ThreadRecordingNotifyObject::signal1, receiver, [] {});
+        sender->moveToThread(&thread);
+
+        QSemaphore go;
+        QMetaObject::invokeMethod(sender, [sender, &go] {
+            go.acquire();
+            delete sender;
+        }, Qt::QueuedConnection);
+        go.release();
+        delete receiver;
+        // make sure the sender is gone before the semaphore goes out of scope
+        QMetaObject::invokeMethod(&context, [] {}, Qt::BlockingQueuedConnection);
+    }
+}
