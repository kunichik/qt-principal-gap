+/*!
+    \internal
+
+    Returns \c true if the thread owning \a data may still process posted
+    events, i.e. it has not started finishing yet.
+*/
+static bool threadCanStillDeliverEvents(QThreadData *data)
+{
+#if QT_CONFIG(thread)
+    QThread *thread = data->thread.loadAcquire();
+    return thread && !thread->isFinished();
+#else
+    Q_UNUSED(data);
+    return false;
+#endif
+}
+
+/*!
+    \internal
+
+    Calls \a sender's disconnectNotify() for the signal \a signal_index on
+    behalf of a receiver that is being destroyed in the current thread. The
+    receiver's signalSlotLock() must be held, which prevents \a sender's
+    ~QObject() from completing.
+
+    Calling virtual functions (metaObject(), disconnectNotify()) on \a sender
+    is only safe from \a sender's own thread: there, its derived-class
+    destructors may be running concurrently. So if \a sender lives in a
+    different thread that can still deliver events, the call is deferred by
+    posting it as an event to \a sender. Should \a sender be destroyed before
+    that event is delivered, the event is discarded (in ~QObjectPrivate()),
+    and disconnectNotify() is not called at all. If \a sender's thread can no
+    longer deliver events (e.g. it has finished), the call is made inline.
+*/
+static void notifyDisconnectFromDestroyedReceiver(QObject *sender, int signal_index)
+{
+    QThreadData *senderThreadData = QObjectPrivate::get(sender)->threadData.loadAcquire();
+    const bool sameThread =
+            senderThreadData->threadId.loadRelaxed() == QThread::currentThreadId();
+    if (sameThread || !threadCanStillDeliverEvents(senderThreadData)) {
+        sender->disconnectNotify(QMetaObjectPrivate::signal(sender->metaObject(), signal_index));
+        return;
+    }
+
+    QMetaObject::invokeMethod(sender, [sender, signal_index] {
+        sender->disconnectNotify(QMetaObjectPrivate::signal(sender->metaObject(), signal_index));
+    }, Qt::QueuedConnection);
+}
