+/*!
+    \internal
+
+    Calls \a sender's disconnectNotify() for the signal with signal index
+    \a signalIndex (see QObjectPrivate::signalIndex()).
+
+    metaObject() and disconnectNotify() are virtual, so they may only be
+    called on \a sender from the thread that owns it: in any other thread,
+    \a sender may be in the middle of running its derived-class destructors.
+    So if \a sender lives in another thread that is running, the notification
+    is posted to that thread instead, and is discarded if \a sender is
+    destroyed before it is delivered. Otherwise (the sender lives in the
+    current thread, has no thread affinity, or its thread is not running, e.g.
+    has finished), disconnectNotify() is called inline.
+
+    The caller must hold a lock that keeps ~QObject() of \a sender from
+    completing: the signalSlotLock() of \a sender, or that of a receiver which
+    is still connected to \a sender.
+*/
+void QObjectPrivate::notifyDisconnect(QObject *sender, int signalIndex)
+{
+    QThreadData *senderThreadData = sender->d_func()->threadData.loadAcquire();
+    QThread *senderThread = senderThreadData->thread.loadAcquire();
+    if (senderThreadData->threadId.loadRelaxed() == QThread::currentThreadId()
+            || !senderThread || !senderThread->isRunning()) {
+        sender->disconnectNotify(QMetaObjectPrivate::signal(sender->metaObject(), signalIndex));
+        return;
+    }
+
+    class DisconnectNotifyEvent : public QAbstractMetaCallEvent
+    {
+    public:
+        explicit DisconnectNotifyEvent(int signalIndex)
+            : QAbstractMetaCallEvent(nullptr, -1), signalIndex(signalIndex)
+        {}
+        void placeMetaCall(QObject *object) override
+        {
+            object->disconnectNotify(QMetaObjectPrivate::signal(object->metaObject(), signalIndex));
+        }
+    private:
+        int signalIndex;
+    };
+    QCoreApplication::postEvent(sender, new DisconnectNotifyEvent(signalIndex));
+}
