+struct DisconnectNotifyLog
+{
+    QMutex mutex;
+    QList<QMetaMethod> signalList;
+    QList<QThread *> threads;
+
+    qsizetype size()
+    {
+        QMutexLocker locker(&mutex);
+        return signalList.size();
+    }
+};
+
+class ThreadedNotifySender : public QObject
+{
+    Q_OBJECT
+public:
+    explicit ThreadedNotifySender(DisconnectNotifyLog *log) : log(log) {}
+    ~ThreadedNotifySender() override
+    {
+        // give a concurrent ~QObject() of a receiver a chance to call into us
+        // while our derived-class destructor is running
+        QThread::yieldCurrentThread();
+    }
+
+signals:
+    void signal1();
+
+protected:
+    void disconnectNotify(const QMetaMethod &signal) override
+    {
+        QMutexLocker locker(&log->mutex);
+        log->signalList.append(signal);
+        log->threads.append(QThread::currentThread());
+    }
+
+private:
+    DisconnectNotifyLog *log;
+};
+
+void tst_QObject::disconnectNotify_senderInOtherThread()
+{
+    DisconnectNotifyLog log;
+    QThread thread;
+    thread.start();
+    auto cleanup = qScopeGuard([&] {
+        thread.quit();
+        thread.wait();
+    });
+
+    auto *s = new ThreadedNotifySender(&log);
+    s->moveToThread(&thread);
+    connect(&thread, &QThread::finished, s, &QObject::deleteLater);
+
+    // receiver destroyed in another thread than the sender's
+    {
+        QObject r;
+        connect(s, &ThreadedNotifySender::signal1, &r, [] {});
+    }
+    QTRY_COMPARE(log.size(), 1);
+
+    // disconnecting a QMetaObject::Connection from another thread than the sender's
+    QObject r;
+    QMetaObject::Connection c = connect(s, &ThreadedNotifySender::signal1, &r, [] {});
+    QVERIFY(QObject::disconnect(c));
+    QTRY_COMPARE(log.size(), 2);
+
+    QMutexLocker locker(&log.mutex);
+    for (qsizetype i = 0; i < log.signalList.size(); ++i) {
+        QCOMPARE(log.signalList.at(i), QMetaMethod::fromSignal(&ThreadedNotifySender::signal1));
+        QCOMPARE(log.threads.at(i), &thread);
+    }
+}
+
+void tst_QObject::disconnectNotify_senderDestroyedBeforeNotify()
+{
+    DisconnectNotifyLog log;
+    QThread thread;
+    thread.start();
+    auto cleanup = qScopeGuard([&] {
+        thread.quit();
+        thread.wait();
+    });
+
+    auto *s = new ThreadedNotifySender(&log);
+    s->moveToThread(&thread);
+
+    // keep the sender's thread busy until the receiver is gone, then destroy
+    // the sender while the deferred notification is still pending
+    QSemaphore receiverGone;
+    QSemaphore senderGone;
+    QMetaObject::invokeMethod(s, [&] {
+        receiverGone.acquire();
+        delete s;
+        senderGone.release();
+    });
+
+    {
+        QObject r;
+        connect(s, &ThreadedNotifySender::signal1, &r, [] {});
+    }
+    receiverGone.release();
+    QVERIFY(senderGone.tryAcquire(1, 10s));
+
+    // the pending notification was discarded
+    QCoreApplication::processEvents();
+    QCOMPARE(log.size(), 0);
+}
+
+void tst_QObject::disconnectNotify_parallelDestruction()
+{
+    DisconnectNotifyLog log;
+    QThread thread;
+    thread.start();
+    auto cleanup = qScopeGuard([&] {
+        thread.quit();
+        thread.wait();
+    });
+
+    for (int i = 0; i < 200; ++i) {
+        auto *s = new ThreadedNotifySender(&log);
+        auto *r = new QObject;
+        connect(s, &ThreadedNotifySender::signal1, r, [] {});
+        s->moveToThread(&thread);
+
+        QSemaphore go;
+        QSemaphore senderGone;
+        QMetaObject::invokeMethod(s, [&] {
+            go.acquire();
+            delete s;
+            senderGone.release();
+        });
+        go.release();
+        delete r;
+        QVERIFY(senderGone.tryAcquire(1, 10s));
+    }
+
+    // if a notification was delivered at all, it was delivered in the sender's thread
+    QMutexLocker locker(&log.mutex);
+    for (QThread *t : std::as_const(log.threads))
+        QCOMPARE(t, &thread);
+}
