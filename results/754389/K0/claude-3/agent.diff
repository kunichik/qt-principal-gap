+class DisconnectNotifyRecorder : public QObject
+{
+public:
+    QList<QMetaMethod> disconnectedSignals;
+protected:
+    void disconnectNotify(const QMetaMethod &signal) override
+    { disconnectedSignals.append(signal); }
+};
+
+void tst_QObject::disconnectNotify_receiverDestroyedCrossThread()
+{
+    // When the receiver is destroyed, the sender must not be called into if it lives
+    // in another thread: it might be running its own destructors there concurrently.
+    QThread thread;
+    thread.start();
+    auto cleanup = qScopeGuard([&] {
+        thread.quit();
+        thread.wait();
+    });
+
+    {
+        auto s = std::make_unique<DisconnectNotifyRecorder>();
+        auto r = std::make_unique<DisconnectNotifyRecorder>();
+        QVERIFY(QObject::connect(s.get(), &QObject::objectNameChanged, r.get(), &QObject::deleteLater));
+        QVERIFY(s->moveToThread(&thread));
+        r.reset();
+        QVERIFY(s->disconnectedSignals.isEmpty());
+        QVERIFY(QMetaObject::invokeMethod(s.release(), &QObject::deleteLater));
+    }
+
+    // Destroy connected senders and receivers living in different threads in parallel.
+    // Exercises the race between ~QObject of both ends (most useful under TSan).
+    for (int i = 0; i < 100; ++i) {
+        auto s = new DisconnectNotifyRecorder;
+        auto r = new DisconnectNotifyRecorder;
+        QVERIFY(QObject::connect(s, &QObject::objectNameChanged, r, &QObject::deleteLater));
+        QVERIFY(QObject::connect(r, &QObject::objectNameChanged, s, &QObject::deleteLater));
+        QVERIFY(s->moveToThread(&thread));
+        QVERIFY(QMetaObject::invokeMethod(s, &QObject::deleteLater));
+        delete r;
+    }
+}
