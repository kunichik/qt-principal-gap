+void tst_QObject::disconnectNotify_receiverDestroyedInOtherThread()
+{
+    // A sender living in another thread may be getting destroyed concurrently,
+    // so destroying the receiver must not call the sender's virtual functions.
+    {
+        QThread thread;
+        NotifyObject s;
+        static_cast<SenderObject &>(s).moveToThread(&thread);
+        {
+            ReceiverObject r;
+            QVERIFY(QObject::connect(&s, &SenderObject::signal1, &r, &ReceiverObject::slot1,
+                                     Qt::DirectConnection));
+        }
+        QVERIFY(s.disconnectedSignals.isEmpty());
+    }
+
+    // The sender is in the middle of its subclass destructors in its own thread
+    // while the receiver gets destroyed in the main thread.
+    struct SlowlyDestroyedSender : SenderObject
+    {
+        QSemaphore *inDestructor = nullptr;
+        QSemaphore *proceed = nullptr;
+        std::atomic<int> *notifications = nullptr;
+        ~SlowlyDestroyedSender() override
+        {
+            inDestructor->release();
+            proceed->acquire();
+        }
+        void disconnectNotify(const QMetaMethod &) override { ++*notifications; }
+    };
+
+    QSemaphore created, inDestructor, proceed, destroy;
+    std::atomic<int> notifications = 0;
+    SlowlyDestroyedSender *s = nullptr;
+    std::thread t([&] {
+        s = new SlowlyDestroyedSender;
+        s->inDestructor = &inDestructor;
+        s->proceed = &proceed;
+        s->notifications = &notifications;
+        created.release();
+        destroy.acquire();
+        delete s;
+    });
+    created.acquire();
+    auto r = std::make_unique<ReceiverObject>();
+    QVERIFY(QObject::connect(s, &SenderObject::signal1, r.get(), &ReceiverObject::slot1,
+                             Qt::DirectConnection));
+    destroy.release();
+    inDestructor.acquire();
+    r.reset();
+    proceed.release();
+    t.join();
+    QCOMPARE(notifications.load(), 0);
+}
