+class ThreadAwareNotifyObject : public QObject
+{
+    Q_OBJECT
+public:
+    QList<QMetaMethod> disconnectedSignals;
+    QList<QThread *> disconnectThreads;
+protected:
+    void disconnectNotify(const QMetaMethod &signal) override
+    {
+        disconnectedSignals.append(signal);
+        disconnectThreads.append(QThread::currentThread());
+    }
+};
+
+void tst_QObject::disconnectNotify_receiverDestroyedInOtherThread()
+{
+    // When a receiver gets destroyed in another thread than the one the sender
+    // lives in, the sender may be in the middle of its own destruction, so
+    // disconnectNotify() must be delivered in the sender's thread.
+    QThread thread;
+    auto context = new QObject;
+    context->moveToThread(&thread);
+    thread.start();
+    auto cleanup = qScopeGuard([&] { thread.quit(); thread.wait(); delete context; });
+
+    {
+        ThreadAwareNotifyObject s;
+        auto r = new QObject;
+        r->moveToThread(&thread);
+        QVERIFY(connect(&s, &QObject::objectNameChanged, r, [] {}));
+        QMetaObject::invokeMethod(context, [r] { delete r; }, Qt::BlockingQueuedConnection);
+
+        QTRY_COMPARE(s.disconnectedSignals.size(), 1);
+        QCOMPARE(s.disconnectedSignals.at(0), QMetaMethod::fromSignal(&QObject::objectNameChanged));
+        QCOMPARE(s.disconnectThreads.at(0), QThread::currentThread());
+    }
+
+    {
+        // The sender gets destroyed before the notification is delivered:
+        // it must be discarded.
+        auto s = new ThreadAwareNotifyObject;
+        auto r = new QObject;
+        r->moveToThread(&thread);
+        QVERIFY(connect(s, &QObject::objectNameChanged, r, [] {}));
+        QMetaObject::invokeMethod(context, [r] { delete r; }, Qt::BlockingQueuedConnection);
+        QVERIFY(s->disconnectedSignals.isEmpty());
+        delete s;
+        QCoreApplication::processEvents();
+    }
+}
+
+void tst_QObject::destroyConnectedObjectsInParallel()
+{
+    // Destroying the receiver must not call into the sender while the sender
+    // is being destroyed in its own thread (run with TSan to detect the race).
+    QThread senderThread;
+    QThread receiverThread;
+    auto senderContext = new QObject;
+    auto receiverContext = new QObject;
+    senderContext->moveToThread(&senderThread);
+    receiverContext->moveToThread(&receiverThread);
+    senderThread.start();
+    receiverThread.start();
+    auto cleanup = qScopeGuard([&] {
+        senderThread.quit();
+        receiverThread.quit();
+        senderThread.wait();
+        receiverThread.wait();
+        delete senderContext;
+        delete receiverContext;
+    });
+
+    for (int i = 0; i < 200; ++i) {
+        auto s = new ThreadAwareNotifyObject;
+        auto r = new QObject;
+        QVERIFY(connect(s, &QObject::objectNameChanged, r, [] {}));
+        s->moveToThread(&senderThread);
+        r->moveToThread(&receiverThread);
+
+        QSemaphore ready;
+        QSemaphore go;
+        QSemaphore done;
+        auto destroy = [&](QObject *o) {
+            ready.release();
+            go.acquire();
+            delete o;
+            done.release();
+        };
+        QMetaObject::invokeMethod(senderContext, [&, s] { destroy(s); });
+        QMetaObject::invokeMethod(receiverContext, [&, r] { destroy(r); });
+        ready.acquire(2);
+        go.release(2);
+        QVERIFY(done.tryAcquire(2, 10s));
+    }
+}
