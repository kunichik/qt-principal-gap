+/*
+    \internal
+
+    Calls \a sender's disconnectNotify() for the signal \a signalIndex on
+    behalf of a receiver that is being destroyed. The caller holds the
+    receiver's signal slot lock, and the connection is still in the sender's
+    connection list.
+
+    If \a sender lives in another thread, it may be running its own destructors
+    in that thread right now: the destructors of QObject subclasses do not take
+    any of the signal slot locks, so holding them does not prevent that. Calling
+    a virtual function (metaObject(), disconnectNotify()) on it from here would
+    then race with the destructors updating the object's vtable pointer, or call
+    into a partially destroyed object. So the notification is queued to the
+    sender's thread instead. It is posted while the connection still exists, so
+    ~QObject() of the sender cannot get past disconnecting its receivers, and
+    thus not past removing its posted events, before the event is in the queue.
+    If the sender is destroyed before the event gets delivered, the event is
+    discarded with the sender.
+
+    If the sender's thread cannot process events (it has finished, or has not
+    been started), the sender is effectively used from other threads and we
+    call disconnectNotify() directly, as before.
+*/
+static void notifySenderOfReceiverDestruction(QObject *sender, int signalIndex)
+{
+    QThreadData *senderThreadData = QObjectPrivate::get(sender)->threadData.loadAcquire();
+    if (senderThreadData->threadId.loadRelaxed() == QThread::currentThreadId()
+            || !senderThreadData->hasEventDispatcher()) {
+        QObjectPrivate::get(sender)->disconnectNotify(
+                QMetaObjectPrivate::signal(sender->metaObject(), signalIndex));
+        return;
+    }
+
+    auto notify = [sender, signalIndex] {
+        QObjectPrivate::get(sender)->disconnectNotify(
+                QMetaObjectPrivate::signal(sender->metaObject(), signalIndex));
+    };
+    QtPrivate::SlotObjUniquePtr slotObj(QtPrivate::makeCallableObject<void (*)()>(std::move(notify)));
+    const QtPrivate::QMetaTypeInterface *argTypes[] = { nullptr }; // no return value
+    const void *argValues[] = { nullptr };
+    QCoreApplication::postEvent(sender, new QQueuedMetaCallEvent(std::move(slotObj), nullptr, -1,
+                                                                 1, argTypes, argValues));
+}
