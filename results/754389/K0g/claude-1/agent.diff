+class SlowlyDestroyedNotifySender : public QObject
+{
+    Q_OBJECT
+public:
+    QSemaphore *destructionStarted = nullptr;
+    QSemaphore *receiverDestroyed = nullptr;
+    QAtomicInt *disconnectNotifyDuringDestruction = nullptr;
+    QAtomicInt inDestructor = 0;
+
+    ~SlowlyDestroyedNotifySender() override
+    {
+        inDestructor.storeRelease(1);
+        destructionStarted->release();
+        // give the other thread the chance to destroy the receiver while the
+        // derived part of this object is still being destroyed
+        receiverDestroyed->tryAcquire(1, QDeadlineTimer(1000));
+        inDestructor.storeRelease(0);
+    }
+
+    void disconnectNotify(const QMetaMethod &) override
+    {
+        if (inDestructor.loadAcquire())
+            disconnectNotifyDuringDestruction->storeRelease(1);
+    }
+
+Q_SIGNALS:
+    void signal();
+};
+
+void tst_QObject::disconnectNotify_receiverDestroyedWhileSenderDestroyedInOtherThread()
+{
+    // Destroying a receiver must not call into a sender living in another thread,
+    // as that one might be in the middle of being destroyed there.
+    QSemaphore destructionStarted;
+    QSemaphore receiverDestroyed;
+    QAtomicInt disconnectNotifyDuringDestruction = 0;
+
+    auto receiver = std::make_unique<QObject>();
+    std::unique_ptr<QThread> thread(QThread::create([&] {
+        auto *sender = new SlowlyDestroyedNotifySender;
+        sender->destructionStarted = &destructionStarted;
+        sender->receiverDestroyed = &receiverDestroyed;
+        sender->disconnectNotifyDuringDestruction = &disconnectNotifyDuringDestruction;
+        QObject::connect(sender, &SlowlyDestroyedNotifySender::signal,
+                         receiver.get(), [] {}, Qt::DirectConnection);
+        delete sender;
+    }));
+
+    thread->start();
+    QVERIFY(destructionStarted.tryAcquire(1, QDeadlineTimer(5000)));
+    receiver.reset();
+    receiverDestroyed.release();
+    QVERIFY(thread->wait(5000));
+    QCOMPARE(disconnectNotifyDuringDestruction.loadAcquire(), 0);
+}
