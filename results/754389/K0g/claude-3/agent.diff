+class ThreadNotifyObject : public NotifyObject
+{
+public:
+    QThread *disconnectNotifyThread = nullptr;
+protected:
+    void disconnectNotify(const QMetaMethod &signal) override
+    {
+        disconnectNotifyThread = QThread::currentThread();
+        NotifyObject::disconnectNotify(signal);
+    }
+};
+
+void tst_QObject::disconnectNotify_receiverDestroyedInOtherThread()
+{
+    ThreadNotifyObject s;
+    QThread thread;
+    thread.start();
+    auto cleanup = qScopeGuard([&] { thread.quit(); thread.wait(); });
+
+    auto *r = new ReceiverObject;
+    QVERIFY(QObject::connect(&s, &SenderObject::signal1, r, &ReceiverObject::slot1));
+    r->moveToThread(&thread);
+    r->deleteLater();
+    // the receiver is destroyed in the worker thread, but disconnectNotify()
+    // must still be called in the sender's own thread
+    QTRY_COMPARE(s.disconnectedSignals.size(), 1);
+    QCOMPARE(s.disconnectedSignals.at(0), QMetaMethod::fromSignal(&SenderObject::signal1));
+    QCOMPARE(s.disconnectNotifyThread, QThread::currentThread());
+}
+
+void tst_QObject::disconnectNotify_senderAndReceiverDestroyedInParallel()
+{
+    // The receiver must not call into the sender (virtual disconnectNotify()
+    // or metaObject()) while the sender is being destroyed in another thread.
+    class Sender : public SenderObject
+    {
+    public:
+        QSemaphore *destroying;
+        QSemaphore *receiverDestroyed;
+        std::atomic<bool> *notifiedWhileDestroyed;
+        std::atomic<bool> alive = true;
+        ~Sender() override
+        {
+            alive = false;
+            destroying->release();
+            receiverDestroyed->acquire();
+        }
+    protected:
+        void disconnectNotify(const QMetaMethod &) override
+        {
+            if (!alive)
+                *notifiedWhileDestroyed = true;
+        }
+    };
+
+    QSemaphore destroying, receiverDestroyed;
+    QThread thread;
+    thread.start();
+    auto cleanup = qScopeGuard([&] { thread.quit(); thread.wait(); });
+
+    auto *s = new Sender;
+    s->destroying = &destroying;
+    s->receiverDestroyed = &receiverDestroyed;
+    std::atomic<bool> notifiedWhileDestroyed = false;
+    s->notifiedWhileDestroyed = &notifiedWhileDestroyed;
+    auto *r = new ReceiverObject;
+    QVERIFY(QObject::connect(s, &SenderObject::signal1, r, &ReceiverObject::slot1));
+    s->moveToThread(&thread);
+    s->deleteLater();
+
+    destroying.acquire();
+    delete r;
+    receiverDestroyed.release();
+    QVERIFY(!notifiedWhileDestroyed);
+}
