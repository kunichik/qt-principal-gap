diff --git a/src/corelib/io/qlockfile_unix.cpp b/src/corelib/io/qlockfile_unix.cpp
index 421412f2..844c2b37 100644
--- a/src/corelib/io/qlockfile_unix.cpp
+++ b/src/corelib/io/qlockfile_unix.cpp
@@ -133,6 +133,41 @@ static bool setNativeLocks(int fd)
     return true;
 }
 
+static void clearNativeLocks(int fd)
+{
+#if defined(Q_OS_ANDROID)
+    struct flock fl;
+    fl.l_type = F_UNLCK;
+    fl.l_whence = SEEK_SET;
+    fl.l_start = 0;
+    fl.l_len = 0;
+    fcntl(fd, F_SETLK, &fl);
+#elif defined(LOCK_EX) && defined(LOCK_NB)
+    flock(fd, LOCK_UN);
+#else
+    Q_UNUSED(fd);
+#endif
+}
+
+/*
+ * Removes the lock file while we hold the native lock on \a fd.
+ *
+ * Some network file systems (e.g. some NFSv4.2 servers) refuse to remove a
+ * file that still has an active lock and fail with EBUSY. In that case, drop
+ * our native lock and try again. The native lock is only an additional safety
+ * net against concurrent removal; the lock file contents (PID, hostname) remain
+ * the authoritative ownership information.
+ */
+static int unlinkLockedFile(int fd, const char *fileName)
+{
+    int ret = ::unlink(fileName);
+    if (ret != 0 && errno == EBUSY && fd >= 0) {
+        clearNativeLocks(fd);
+        ret = ::unlink(fileName);
+    }
+    return ret;
+}
+
 QLockFile::LockError QLockFilePrivate::tryLock_sys()
 {
     const QByteArray lockFileName = QFile::encodeName(fileName);
@@ -183,7 +218,7 @@ bool QLockFilePrivate::removeStaleLock()
     if (fd < 0) // gone already?
         return errno == ENOENT;
 
-    bool success = setNativeLocks(fd) && (::unlink(lockFileName) == 0);
+    bool success = setNativeLocks(fd) && (unlinkLockedFile(fd, lockFileName) == 0);
     close(fd);
     return success;
 }
