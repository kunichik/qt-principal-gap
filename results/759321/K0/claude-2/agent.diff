diff --git a/src/corelib/io/qlockfile_unix.cpp b/src/corelib/io/qlockfile_unix.cpp
index 421412f2..9d05fcf9 100644
--- a/src/corelib/io/qlockfile_unix.cpp
+++ b/src/corelib/io/qlockfile_unix.cpp
@@ -133,6 +133,46 @@ static bool setNativeLocks(int fd)
     return true;
 }
 
+static void releaseNativeLocks(int fd)
+{
+#if defined(Q_OS_ANDROID)
+    struct flock fl;
+    fl.l_type = F_UNLCK;
+    fl.l_whence = SEEK_SET;
+    fl.l_start = 0;
+    fl.l_len = 0;
+    fcntl(fd, F_SETLK, &fl);
+#elif defined(LOCK_EX) && defined(LOCK_NB)
+    flock(fd, LOCK_UN);
+#else
+    Q_UNUSED(fd);
+#endif
+}
+
+/*
+ * Some network file systems (observed with NFSv4.2 servers) refuse to remove
+ * a file that still has an active lock on it and fail with EBUSY. In that
+ * case, release our lock and try again, but only if the path still refers to
+ * the file we have open (someone may have replaced it after we unlocked).
+ */
+static int unlinkLockedFile(const char *path, int fd)
+{
+    if (::unlink(path) == 0)
+        return 0;
+    if (errno != EBUSY)
+        return -1;
+
+    releaseNativeLocks(fd);
+
+    QT_STATBUF fdStat, pathStat;
+    if (QT_FSTAT(fd, &fdStat) == 0 && QT_STAT(path, &pathStat) == 0
+            && (fdStat.st_dev != pathStat.st_dev || fdStat.st_ino != pathStat.st_ino)) {
+        errno = ENOENT;     // our file is gone; don't remove someone else's
+        return -1;
+    }
+    return ::unlink(path);
+}
