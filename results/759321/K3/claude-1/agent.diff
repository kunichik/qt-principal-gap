+void tst_QLockFile::unlockClosesBeforeRemoving()
+{
+#if !defined(Q_OS_UNIX) || defined(Q_OS_VXWORKS)
+    QSKIP("This test is Unix-specific");
+#else
+    // Some network file systems refuse to remove a file on which we still
+    // hold a lock (EBUSY), so unlock() must close the handle first.
+    const QString fileName = dir.path() + "/lock-closebeforeremove";
+    QLockFile lockFile(fileName);
+    QVERIFY(lockFile.lock());
+    const int fd = QLockFilePrivate::getLockFileHandle(&lockFile);
+    QVERIFY(fd >= 0);
+    lockFile.unlock();
+    QCOMPARE(QLockFilePrivate::getLockFileHandle(&lockFile), -1);
+    QVERIFY(!QFile::exists(fileName));
+    errno = 0;
+    QCOMPARE(::fcntl(fd, F_GETFD), -1);
+    QCOMPARE(errno, EBADF);
+#endif
+}
+
+void tst_QLockFile::unlockDoesNotRemoveReplacedFile()
+{
+#if !defined(Q_OS_UNIX) || defined(Q_OS_VXWORKS)
+    QSKIP("This test is Unix-specific");
+#else
+    // If our lock file was replaced by someone else's (e.g. because they
+    // considered it stale), unlock() must not delete theirs.
+    const QString fileName = dir.path() + "/lock-replaced";
+    QLockFile lockFile(fileName);
+    QVERIFY(lockFile.lock());
+    QVERIFY(QFile::remove(fileName));
+    QFile other(fileName);
+    QVERIFY(other.open(QIODevice::WriteOnly | QIODevice::NewOnly));
+    other.close();
+
+    lockFile.unlock();
+    QVERIFY(!lockFile.isLocked());
+    QVERIFY(QFile::exists(fileName));
+    QVERIFY(QFile::remove(fileName));
+#endif
+}
