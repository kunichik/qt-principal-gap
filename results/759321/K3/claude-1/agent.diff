index 421412f2..5cf7733d 100644
--- a/src/corelib/io/qlockfile_unix.cpp
+++ b/src/corelib/io/qlockfile_unix.cpp
@@ -133,6 +133,40 @@ static bool setNativeLocks(int fd)
     return true;
 }
 
+/*
+ * Closes \a fd and then removes the lock file \a lockFileName, provided that
+ * it still is the same file that \a fd referred to.
+ *
+ * The file must be closed before it is unlinked: some network file systems
+ * (observed with NFSv4.2) refuse to remove or rename a file on which a lock is
+ * still held, failing with EBUSY. Closing the descriptor drops our locks.
+ *
+ * Since that leaves a window between the close() and the unlink() in which
+ * another process may have removed the file and created its own lock file
+ * under the same name, we compare the file identities and don't remove a file
+ * that isn't ours. In that case, our file is gone already and we report
+ * ENOENT.
+ *
+ * Returns 0 on success, -1 on failure with errno set.
+ */
+static int closeAndUnlink(int fd, const char *lockFileName)
+{
+    QT_STATBUF ours;
+    const bool haveIdentity = QT_FSTAT(fd, &ours) == 0;
+    qt_safe_close(fd);
+
+    if (haveIdentity) {
+        QT_STATBUF current;
+        if (QT_LSTAT(lockFileName, &current) != 0)
+            return -1;
+        if (current.st_dev != ours.st_dev || current.st_ino != ours.st_ino) {
+            errno = ENOENT;
+            return -1;
+        }
+    }
+    return ::unlink(lockFileName);
+}
