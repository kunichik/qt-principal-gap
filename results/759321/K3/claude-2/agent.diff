+void tst_QLockFile::busyUnlink()
+{
+#if !defined(QT_BUILD_INTERNAL) || !defined(Q_OS_UNIX)
+    QSKIP("This test requires a developer build on Unix");
+#else
+    // Some network file systems refuse to remove a file holding an active
+    // lock with EBUSY; the lock file must be removed nevertheless.
+    QTemporaryDir busyDir;
+    QVERIFY2(busyDir.isValid(), qPrintable(busyDir.errorString()));
+    const QString fileName = busyDir.path() + "/busyLock";
+    qt_lockfile_simulate_ebusy = true;
+    auto resetSimulation = qScopeGuard([] { qt_lockfile_simulate_ebusy = false; });
+
+    {
+        QLockFile lockFile(fileName);
+        QVERIFY(lockFile.lock());
+        QVERIFY(QFile::exists(fileName));
+        lockFile.unlock();
+        QVERIFY(!lockFile.isLocked());
+        QVERIFY(!QFile::exists(fileName));
+        QCOMPARE(QDir(busyDir.path()).entryList(QDir::NoDotAndDotDot | QDir::AllEntries),
+                 QStringList());
+    }
+
+#if QT_CONFIG(process) && !defined(Q_OS_HARMONY)
+    // Stale lock left behind by a crashed process
+    int ret = QProcess::execute(m_helperApp, QStringList() << fileName << "-uncleanexit");
+    QCOMPARE(ret, int(QLockFile::NoError));
+    QTRY_VERIFY(QFile::exists(fileName));
+    QLockFile secondLock(fileName);
+    QVERIFY(secondLock.removeStaleLockFile());
+    QVERIFY(!QFile::exists(fileName));
+    QVERIFY(secondLock.tryLock());
+    secondLock.unlock();
+    QCOMPARE(QDir(busyDir.path()).entryList(QDir::NoDotAndDotDot | QDir::AllEntries),
+             QStringList());
+#endif
+#endif
+}
