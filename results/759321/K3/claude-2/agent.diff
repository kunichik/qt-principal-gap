+/*
+ * Removes a lock file whose handle has already been closed, i.e. whose native
+ * locks are no longer held. \a st identifies the file we had open.
+ *
+ * Since another process may have removed the file (as stale) and created a new
+ * lock file between the close() and now, we must not blindly unlink() the name.
+ * Instead, atomically move the file out of the way to a unique name, check that
+ * it is the file we had open, and only then delete it. If it isn't ours, move
+ * it back.
+ *
+ * Returns 0 on success or an errno value; ENOENT means our file no longer
+ * exists under that name.
+ */
+static int removeUnlockedLockFile(const QByteArray &lockFileName, const QT_STATBUF &st)
+{
+    const QFileSystemEntry entry(lockFileName, QFileSystemEntry::FromNativePath());
+    const QFileSystemEntry tmpEntry(lockFileName + ".rm."
+                                            + QByteArray::number(QRandomGenerator::global()->generate64(), 16),
+                                    QFileSystemEntry::FromNativePath());
+    QSystemError error;
+    if (!QFileSystemEngine::renameFile(entry, tmpEntry, error))
+        return error.error();
+
+    const QByteArray tmpName = tmpEntry.nativeFilePath();
+    QT_STATBUF tmpSt;
+    if (QT_LSTAT(tmpName.constData(), &tmpSt) == 0
+            && tmpSt.st_dev == st.st_dev && tmpSt.st_ino == st.st_ino) {
+        return ::unlink(tmpName.constData()) == 0 ? 0 : errno;
+    }
+
+    // Not our file: someone else's lock replaced ours in the meantime. Put it
+    // back, but never over a file that has been created in the meantime.
+    if (!QFileSystemEngine::renameFile(tmpEntry, entry, error)) {
+        qWarning("QLockFile: Could not restore lock file %s from %s: %ls",
+                 lockFileName.constData(), tmpName.constData(),
+                 qUtf16Printable(error.toString()));
+    }
+    return ENOENT;
+}
+
+// For autotests: behave as if unlinking a locked file failed with EBUSY.
+Q_AUTOTEST_EXPORT bool qt_lockfile_simulate_ebusy = false;
+
+static int unlinkLockedFile(const QByteArray &lockFileName)
+{
+    if (Q_UNLIKELY(qt_lockfile_simulate_ebusy)) {
+        errno = EBUSY;
+        return -1;
+    }
+    return ::unlink(lockFileName.constData());
+}
+
+/*
+ * Removes the lock file \a lockFileName while still holding the native locks on
+ * \a fd, then closes \a fd. Returns 0 on success or an errno value.
+ *
+ * Some network file systems (observed with NFSv4.2) refuse to remove or rename a
+ * file that still has an active lock, failing with EBUSY. In that case close the
+ * file first (which drops the locks) and remove it afterwards.
+ */
+static int releaseLockFile(const QByteArray &lockFileName, int fd)
+{
+    if (unlinkLockedFile(lockFileName) == 0) {
+        qt_safe_close(fd);
+        return 0;
+    }
+
+    int err = errno;
+    if (err != EBUSY) {
+        qt_safe_close(fd);
+        return err;
+    }
+
+    QT_STATBUF st;
+    const bool haveStat = QT_FSTAT(fd, &st) == 0;
+    err = errno;
+    qt_safe_close(fd);
+    if (!haveStat)
+        return err;
+    return removeUnlockedLockFile(lockFileName, st);
+}
