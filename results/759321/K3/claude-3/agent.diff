+void tst_QLockFile::removeUnlockedLockFile()
+{
+#if !defined(Q_OS_UNIX) || defined(Q_OS_VXWORKS)
+    QSKIP("This test is Unix-specific");
+#elif !defined(QT_BUILD_INTERNAL)
+    QSKIP("This test requires a developer build");
+#else
+    // This is the fallback used when the file system refuses to remove a
+    // locked file (EBUSY on NFSv4), after our handle has been closed.
+    const QString fileName = dir.path() + "/unlockedLockFile";
+    const QByteArray nativeName = QFile::encodeName(fileName);
+
+    QLockFile lockFile(fileName);
+    QVERIFY(lockFile.lock());
+    QT_STATBUF ours;
+    QCOMPARE(QT_FSTAT(QLockFilePrivate::getLockFileHandle(&lockFile), &ours), 0);
+
+    // Simulate the lock having been stolen and recreated by someone else
+    // after we dropped the native locks: it must be left alone.
+    QFile other(fileName + ".other");
+    QVERIFY(other.open(QIODevice::WriteOnly));
+    other.close();
+    QT_STATBUF theirs;
+    QCOMPARE(QT_STAT(QFile::encodeName(other.fileName()).constData(), &theirs), 0);
+    QVERIFY(!QLockFilePrivate::removeUnlockedLockFile(nativeName, theirs.st_dev, theirs.st_ino));
+    QCOMPARE(errno, EBUSY);
+    QVERIFY(QFile::exists(fileName));
+    QCOMPARE(QDir(dir.path()).entryList(QDir::Files | QDir::Hidden).size(), 2);
+
+    // Our own file is removed, without leaving anything behind.
+    QVERIFY(QLockFilePrivate::removeUnlockedLockFile(nativeName, ours.st_dev, ours.st_ino));
+    QVERIFY(!QFile::exists(fileName));
+    QVERIFY(QFile::remove(other.fileName()));
+    QVERIFY(QDir(dir.path()).entryList(QDir::Files | QDir::Hidden).isEmpty());
+
+    // A file that is already gone reports ENOENT, which unlock() ignores.
+    QVERIFY(!QLockFilePrivate::removeUnlockedLockFile(nativeName, ours.st_dev, ours.st_ino));
+    QCOMPARE(errno, ENOENT);
+    lockFile.unlock();
+    QVERIFY(!lockFile.isLocked());
+#endif
+}
+
 QTEST_MAIN(tst_QLockFile)
