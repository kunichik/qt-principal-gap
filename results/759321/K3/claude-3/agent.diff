+/*
+ * Removes the lock file \a lockFileName, which must be the file with device
+ * \a dev and inode \a ino. The caller must have closed all of its descriptors
+ * to the file, so it no longer holds the native locks on it.
+ *
+ * Since another process may have stolen and recreated the lock file once we
+ * dropped the native locks, we must not blindly unlink() the name. Instead,
+ * we atomically move whatever is there out of the way, check that it is the
+ * file we expect, and either remove it or put it back.
+ */
+bool QLockFilePrivate::removeUnlockedLockFile(const QByteArray &lockFileName, dev_t dev, ino_t ino)
+{
+    QTemporaryFileName templ(QFile::decodeName(lockFileName) + QLatin1StringView(".removing.XXXXXX"));
+    const QFileSystemEntry source(lockFileName, QFileSystemEntry::FromNativePath());
+    QFileSystemEntry target;
+    QSystemError error;
+    for (int attempt = 0; ; ++attempt) {
+        target = QFileSystemEntry(templ.generateNext(), QFileSystemEntry::FromNativePath());
+        if (QFileSystemEngine::renameFile(source, target, error))
+            break;
+        if (error.errorCode != EEXIST || attempt == 16) {
+            errno = error.errorCode;
+            return false;
+        }
+    }
+
+    const QByteArray movedName = target.nativeFilePath();
+    QT_STATBUF st;
+    if (QT_LSTAT(movedName.constData(), &st) == 0 && st.st_dev == dev && st.st_ino == ino)
+        return ::unlink(movedName.constData()) == 0;
+
+    // Not our file: someone else locked it in the meantime. Put it back.
+    if (!QFileSystemEngine::renameFile(target, source, error)) {
+        qWarning("QLockFile: Could not restore lock file %s: %ls",
+                 lockFileName.constData(), qUtf16Printable(error.toString()));
+    }
+    errno = EBUSY;
+    return false;
+}
+
+/*
+ * Removes the lock file \a lockFileName while we hold the native locks on it
+ * through \a fd, then closes \a fd. The descriptor is always closed when this
+ * function returns.
+ *
+ * Some network file systems (e.g. NFSv4) refuse to remove a file that has an
+ * active lock, failing with EBUSY. In that case, we drop the locks by closing
+ * the descriptor and retry with removeUnlockedLockFile().
+ */
+bool QLockFilePrivate::releaseLockFile(const QByteArray &lockFileName, int fd)
+{
+    if (::unlink(lockFileName.constData()) == 0) {
+        qt_safe_close(fd);
+        return true;
+    }
+    if (errno != EBUSY) {
+        const int savedErrno = errno;
+        qt_safe_close(fd);
+        errno = savedErrno;
+        return false;
+    }
+
+    QT_STATBUF st;
+    const bool statOk = QT_FSTAT(fd, &st) == 0;
+    // close() drops the native locks (POSIX locks are dropped on any close())
+    qt_safe_close(fd);
+    if (!statOk) {
+        errno = EBUSY;
+        return false;
+    }
+    return removeUnlockedLockFile(lockFileName, st.st_dev, st.st_ino);
+}
