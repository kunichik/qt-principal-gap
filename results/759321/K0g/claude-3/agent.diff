diff --git a/src/corelib/io/qlockfile_unix.cpp b/src/corelib/io/qlockfile_unix.cpp
index 421412f2..a8d10f34 100644
--- a/src/corelib/io/qlockfile_unix.cpp
+++ b/src/corelib/io/qlockfile_unix.cpp
@@ -133,6 +133,40 @@ static bool setNativeLocks(int fd)
     return true;
 }
 
+static void releaseNativeLocks(int fd)
+{
+#if defined(Q_OS_ANDROID)
+    struct flock fl;
+    fl.l_type = F_UNLCK;
+    fl.l_whence = SEEK_SET;
+    fl.l_start = 0;
+    fl.l_len = 0;
+    fcntl(fd, F_SETLK, &fl);
+#elif defined(LOCK_UN)
+    flock(fd, LOCK_UN);
+#else
+    Q_UNUSED(fd);
+#endif
+}
+
+/*
+ * Removes the lock file \a lockFileName while we hold the native lock on \a fd.
+ *
+ * Some network file systems (observed with NFSv4.2) refuse to remove or rename
+ * a file that still holds an active lock and fail with EBUSY. In that case,
+ * release the native lock and try again: we've already done what was needed
+ * while holding it, and leaving the file behind would create a stale lock.
+ */
+static int unlinkLockedFile(const char *lockFileName, int fd)
+{
+    int ret = ::unlink(lockFileName);
+    if (ret != 0 && errno == EBUSY) {
+        releaseNativeLocks(fd);
+        ret = ::unlink(lockFileName);
+    }
+    return ret;
+}
