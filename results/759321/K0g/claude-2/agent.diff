     return true;
 }
 
+#ifdef QT_BUILD_INTERNAL
+// used in tst_QLockFile to simulate file systems refusing to remove locked files
+Q_AUTOTEST_EXPORT int (*qt_lockfile_unlink_hook)(const char *) = nullptr;
+#endif
+
+static int lockFileUnlink(const char *fileName)
+{
+#ifdef QT_BUILD_INTERNAL
+    if (qt_lockfile_unlink_hook)
+        return qt_lockfile_unlink_hook(fileName);
+#endif
+    return ::unlink(fileName);
+}
+
+/*
+ * Removes the lock file \a fileName and closes \a fd, which refers to it and
+ * on which we hold the native lock.
+ *
+ * Normally the file is removed while the lock is still held, so that nobody
+ * can create a new lock file in its place that we would then remove. However,
+ * some network file systems (e.g. NFSv4.2) refuse to remove or rename a file
+ * on which a lock is held and fail with EBUSY. In that case, release the lock
+ * by closing the file descriptor and try again, provided the path still refers
+ * to the file we had open.
+ *
+ * Returns 0 on success, -1 with errno set otherwise. If the file was replaced
+ * in the meantime, it is not removed and errno is set to ENOENT.
+ */
+static int unlinkAndClose(const char *fileName, int fd)
+{
+    int ret = lockFileUnlink(fileName);
+    if (ret == 0 || errno != EBUSY) {
+        const int savedErrno = errno;
+        qt_safe_close(fd);
+        errno = savedErrno;
+        return ret;
+    }
+
+    QT_STATBUF before;
+    const bool haveStat = QT_FSTAT(fd, &before) == 0;
+    qt_safe_close(fd);
+    if (!haveStat) {
+        errno = EBUSY;
+        return -1;
+    }
+
+    QT_STATBUF after;
+    if (QT_STAT(fileName, &after) != 0)
+        return -1;
+    if (after.st_dev != before.st_dev || after.st_ino != before.st_ino) {
+        errno = ENOENT; // someone else's lock file now, not ours to remove
+        return -1;
+    }
+    return lockFileUnlink(fileName);
+}
