+void tst_QLockFile::unlinkFailsWhileLocked()
+{
+#ifndef HAVE_UNLINK_HOOK
+    QSKIP("This test requires a developer build with flock() support");
+#else
+    qt_lockfile_unlink_hook = unlinkFailingIfLocked;
+    const auto cleanup = qScopeGuard([] { qt_lockfile_unlink_hook = nullptr; });
+    QTest::failOnWarning();
+    busyUnlinkCount = 0;
+
+    const QString fileName = dir.path() + "/unlinkFailsWhileLocked";
+    {
+        QLockFile lockFile(fileName);
+        QVERIFY(lockFile.lock());
+        QVERIFY(QFile::exists(fileName));
+        lockFile.unlock();
+        QCOMPARE(busyUnlinkCount, 1);
+        QCOMPARE(lockFile.error(), QLockFile::NoError);
+        QVERIFY(!QFile::exists(fileName));
+    }
+
+    // A stale lock must be removable too
+    {
+        QFile file(fileName);
+        QVERIFY(file.open(QFile::WriteOnly));
+    }
+    busyUnlinkCount = 0;
+    QLockFile lockFile(fileName);
+    lockFile.setStaleLockTime(100ms);
+    QVERIFY(lockFile.tryLock(10s));
+    QCOMPARE(lockFile.error(), QLockFile::NoError);
+    // once for the stale lock file, once for the ".rmlock" guarding its removal
+    QCOMPARE(busyUnlinkCount, 2);
+    QVERIFY(!QFile::exists(fileName + ".rmlock"));
+    lockFile.unlock();
+    QVERIFY(!QFile::exists(fileName));
+#endif
+}
