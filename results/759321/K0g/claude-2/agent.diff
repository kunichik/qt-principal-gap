+
+static int busyUnlinkCount = 0;
+
+// Behaves like some network file systems (e.g. NFSv4.2), which refuse to
+// remove a file while someone holds a lock on it.
+static int unlinkFailingIfLocked(const char *fileName)
+{
+    const int fd = ::open(fileName, O_RDONLY);
+    if (fd >= 0) {
+        const bool locked = ::flock(fd, LOCK_EX | LOCK_NB) != 0 && errno == EWOULDBLOCK;
+        ::close(fd);
+        if (locked) {
+            ++busyUnlinkCount;
+            errno = EBUSY;
+            return -1;
+        }
+    }
+    return ::unlink(fileName);
+}
+#endif
