     if (fd < 0) // gone already?
         return errno == ENOENT;
 
-    bool success = setNativeLocks(fd) && (::unlink(lockFileName) == 0);
+    bool success = setNativeLocks(fd) && (unlinkLockedFile(lockFileName, fd) == 0);
     close(fd);
     return success;
 }
