+/*
+ * Removes the lock file \a lockFileName and closes \a fd, which must refer to
+ * it. The file is unlinked before the descriptor is closed, so the native lock
+ * keeps protecting it until it is gone. However, some network file systems
+ * (observed with NFSv4.2) refuse to remove a file while a lock is held on it,
+ * failing with EBUSY; in that case (and for ETXTBSY / EPERM) we retry after
+ * closing the descriptor, which drops the lock.
+ *
+ * \a fd is always closed by this function. Returns true if the file no longer
+ * exists; on failure, errno is set to the reason.
+ */
+static bool unlinkAndClose(const QByteArray &lockFileName, int fd)
+{
+    auto isGone = [](int err) { return err == ENOENT || err == ENOTDIR; };
+
+    int ret = ::unlink(lockFileName.constData());
+    int savedErrno = errno;
+    qt_safe_close(fd);
+    if (ret == 0)
+        return true;
+    if (isGone(savedErrno))
+        return true;
+
+    if (savedErrno == EBUSY || savedErrno == ETXTBSY || savedErrno == EPERM) {
+        ret = ::unlink(lockFileName.constData());
+        savedErrno = errno;
+        if (ret == 0 || isGone(savedErrno))
+            return true;
+    }
+
+    errno = savedErrno;
+    return false;
+}
