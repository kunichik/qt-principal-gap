-    bool success = setNativeLocks(fd) && (::unlink(lockFileName) == 0);
-    close(fd);
-    return success;
+    // Only remove the file if nobody else holds the lock on it
+    if (!setNativeLocks(fd)) {
+        qt_safe_close(fd);
+        return false;
+    }
+    return unlinkAndClose(lockFileName, fd);
 }
 
