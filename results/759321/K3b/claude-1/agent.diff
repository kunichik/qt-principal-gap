@@ -133,6 +133,33 @@ static bool setNativeLocks(int fd)
     return true;
 }
 
+/*
+ * Removes the lock file \a lockFileName and closes \a fd, which holds the
+ * native lock on it. The unlink() is attempted first, while we still hold the
+ * lock. Some network file systems (seen on NFS) refuse to remove a file with
+ * an active lock (EBUSY), so if that fails we retry after closing the file
+ * descriptor, which releases the lock.
+ *
+ * \a fd is always closed. Returns true only if the file is gone; on failure,
+ * errno is set by the last failed unlink().
+ */
+static bool unlinkAndClose(const QByteArray &lockFileName, int fd)
+{
+    int ret = ::unlink(lockFileName.constData());
+    int savedErrno = errno;
+    qt_safe_close(fd);
+
+    if (ret != 0 && (savedErrno == EBUSY || savedErrno == ETXTBSY || savedErrno == EPERM)) {
+        ret = ::unlink(lockFileName.constData());
+        savedErrno = errno;
+    }
+
+    if (ret == 0 || savedErrno == ENOENT || savedErrno == ENOTDIR)
+        return true;
+    errno = savedErrno;
+    return false;
+}
+
