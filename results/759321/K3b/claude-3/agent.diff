+/*!
+    \internal
+    Removes the lock file \a lockFileName and closes \a fd, which refers to it.
+
+    The file is unlinked first, before closing the descriptor (and thereby
+    dropping the native lock), so that no other process can mistake the file
+    for an abandoned lock in between. Some network file systems (e.g. NFS)
+    refuse to unlink a file that is still locked or open, failing with EBUSY;
+    in that case (and for ETXTBSY and EPERM) the unlink is retried after
+    the descriptor has been closed.
+
+    \a fd is always closed by this function. Returns \c true only if the file
+    is gone afterwards; otherwise returns \c false with errno set.
+*/
+static bool unlinkAndClose(const QByteArray &lockFileName, int fd)
+{
+    int ret = ::unlink(lockFileName.constData());
+    int savedErrno = ret == 0 ? 0 : errno;
+    qt_safe_close(fd);
+    if (ret == 0)
+        return true;
+
+    if (savedErrno == EBUSY || savedErrno == ETXTBSY || savedErrno == EPERM) {
+        ret = ::unlink(lockFileName.constData());
+        if (ret == 0)
+            return true;
+        savedErrno = errno;
+    }
+
+    errno = savedErrno;
+    return savedErrno == ENOENT || savedErrno == ENOTDIR;
+}
