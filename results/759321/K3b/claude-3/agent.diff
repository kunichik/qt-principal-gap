+void tst_QLockFile::unlockClosesHandle()
+{
+#ifdef Q_OS_UNIX
+    const QString fileName = dir.path() + "/lockCloses";
+    QLockFile lockFile(fileName);
+    QVERIFY(lockFile.lock());
+    const int fd = QLockFilePrivate::getLockFileHandle(&lockFile);
+    QVERIFY(fd >= 0);
+    QVERIFY(fcntl(fd, F_GETFD) != -1);
+
+    lockFile.unlock();
+    QVERIFY(!QFile::exists(fileName));
+    QCOMPARE(QLockFilePrivate::getLockFileHandle(&lockFile), -1);
+    // the descriptor must have been closed exactly once, by unlock()
+    QCOMPARE(fcntl(fd, F_GETFD), -1);
+    QCOMPARE(errno, EBADF);
+
+    // and it can be locked again
+    QVERIFY(lockFile.tryLock());
+    lockFile.unlock();
+    QVERIFY(!QFile::exists(fileName));
+#else
+    QSKIP("Unix-specific test");
+#endif
+}
