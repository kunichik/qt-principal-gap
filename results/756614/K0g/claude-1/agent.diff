+
+/*!
+    \fn template <class T> void QThreadStorage<T>::clearLocalData()
+    \since 6.13
+
+    Destroys the local data of the calling thread, if any. Afterwards,
+    hasLocalData() returns \c false, until the data is re-created by a call
+    to setLocalData() or (non-const) localData().
+
+    If T is a pointer type, the object pointed to is deleted. This is
+    equivalent to calling \c{setLocalData(nullptr)}.
+
+    If T is a value type, the stored value is destroyed. Unlike
+    \c{setLocalData(T())}, which merely replaces the stored value with a
+    default-constructed one, this function makes hasLocalData() return
+    \c false again.
+
+    \sa setLocalData(), hasLocalData()
 */
 
 QT_END_NAMESPACE
