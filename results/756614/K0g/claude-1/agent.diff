+namespace {
+struct Counted
+{
+    static inline int count = 0;
+    int value = 0;
+    Counted() { ++count; }
+    Counted(const Counted &other) : value(other.value) { ++count; }
+    ~Counted() { --count; }
+};
+} // unnamed namespace
+
+void tst_QThreadStorage::clearLocalData()
+{
+    // pointer-based
+    {
+        QThreadStorage<Pointer *> pointers;
+        pointers.clearLocalData(); // no data: must be a no-op
+        QVERIFY(!pointers.hasLocalData());
+
+        const int c = Pointer::count;
+        pointers.setLocalData(new Pointer);
+        QVERIFY(pointers.hasLocalData());
+        QCOMPARE(Pointer::count, c + 1);
+
+        pointers.clearLocalData();
+        QVERIFY(!pointers.hasLocalData());
+        QCOMPARE(Pointer::count, c);
+        QCOMPARE(std::as_const(pointers).localData(), nullptr);
+
+        pointers.clearLocalData(); // repeated: must be a no-op
+        QVERIFY(!pointers.hasLocalData());
+    }
+
+    // value-based
+    {
+        QThreadStorage<Counted> values;
+        values.clearLocalData(); // no data: must be a no-op
+        QVERIFY(!values.hasLocalData());
+        QCOMPARE(Counted::count, 0);
+
+        values.localData().value = 42;
+        QVERIFY(values.hasLocalData());
+        QCOMPARE(Counted::count, 1);
+
+        values.clearLocalData();
+        QVERIFY(!values.hasLocalData());
+        QCOMPARE(Counted::count, 0);
+
+        // re-created, default-constructed, on next access:
+        QCOMPARE(values.localData().value, 0);
+        QVERIFY(values.hasLocalData());
+        QCOMPARE(Counted::count, 1);
+
+        values.setLocalData(Counted{});
+        QVERIFY(values.hasLocalData());
+        QCOMPARE(Counted::count, 1);
+        values.clearLocalData();
+        QVERIFY(!values.hasLocalData());
+        QCOMPARE(Counted::count, 0);
+
+        values.clearLocalData(); // repeated: must be a no-op
+        QVERIFY(!values.hasLocalData());
+    }
+
+    // only affects the calling thread
+    {
+        QThreadStorage<QString> strings;
+        strings.setLocalData(u"main"_s);
+
+        bool otherHadData = true;
+        bool otherHasDataAfterSet = false;
+        bool otherHasDataAfterClear = true;
+        QScopedPointer<QThread> thread(QThread::create([&] {
+            otherHadData = strings.hasLocalData();
+            strings.setLocalData(u"other"_s);
+            otherHasDataAfterSet = strings.hasLocalData();
+            strings.clearLocalData();
+            otherHasDataAfterClear = strings.hasLocalData();
+        }));
+        thread->start();
+        QVERIFY(thread->wait());
+
+        QVERIFY(!otherHadData);
+        QVERIFY(otherHasDataAfterSet);
+        QVERIFY(!otherHasDataAfterClear);
+        QVERIFY(strings.hasLocalData());
+        QCOMPARE(strings.localData(), u"main"_s);
+
+        strings.clearLocalData();
+        QVERIFY(!strings.hasLocalData());
+    }
+}
+
 class Thread : public QThread
 {
     Q_OBJECT
