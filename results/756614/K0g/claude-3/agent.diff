+void tst_QThreadStorage::clearLocalData_otherThreads()
+{
+    QThreadStorage<SPointer> storage;
+    const int c = SPointer::count.loadRelaxed();
+
+    storage.localData();
+    QVERIFY(storage.hasLocalData());
+    QCOMPARE(SPointer::count.loadRelaxed(), c + 1);
+
+    bool otherHadData = true;
+    bool otherHasDataAfterClear = true;
+    auto t = std::unique_ptr<QThread>(QThread::create([&] {
+        otherHadData = storage.hasLocalData();
+        storage.localData();
+        storage.clearLocalData();
+        otherHasDataAfterClear = storage.hasLocalData();
+    }));
+    t->start();
+    QVERIFY(t->wait(WaitTimeout));
+    QVERIFY(!otherHadData);
+    QVERIFY(!otherHasDataAfterClear);
+
+    // the main thread's data is unaffected:
+    QVERIFY(storage.hasLocalData());
+    QCOMPARE(SPointer::count.loadRelaxed(), c + 1);
+
+    storage.clearLocalData();
+    QVERIFY(!storage.hasLocalData());
+    QCOMPARE(SPointer::count.loadRelaxed(), c);
+}
