+void tst_QThreadStorage::clearLocalData_pointer()
+{
+    QThreadStorage<Pointer *> pointers;
+    const int c = Pointer::count;
+
+    // no-op without data:
+    pointers.clearLocalData();
+    QVERIFY(!pointers.hasLocalData());
+    QCOMPARE(pointers.localData(), nullptr);
+
+    pointers.setLocalData(new Pointer);
+    QVERIFY(pointers.hasLocalData());
+    QCOMPARE(Pointer::count, c + 1);
+
+    pointers.clearLocalData();
+    QVERIFY(!pointers.hasLocalData());
+    QCOMPARE(Pointer::count, c); // deleted the payload
+    QCOMPARE(pointers.localData(), nullptr);
+
+    // can be set again afterwards:
+    Pointer *p = new Pointer;
+    pointers.setLocalData(p);
+    QCOMPARE(pointers.localData(), p);
+    pointers.clearLocalData();
+    QCOMPARE(Pointer::count, c);
+    QVERIFY(!pointers.hasLocalData());
+}
+
+void tst_QThreadStorage::clearLocalData_value()
+{
+    {
+        QThreadStorage<QString> strings;
+        const auto &const_strings = strings;
+
+        // no-op without data:
+        strings.clearLocalData();
+        QVERIFY(!strings.hasLocalData());
+
+        strings.setLocalData(u"hello"_s);
+        QVERIFY(strings.hasLocalData());
+        QCOMPARE(strings.localData(), u"hello"_s);
+
+        strings.clearLocalData();
+        QVERIFY(!strings.hasLocalData());
+        QVERIFY(const_strings.localData().isNull());
+        QVERIFY(!strings.hasLocalData()); // const localData() doesn't create
+
+        // non-const localData() re-creates a default-constructed value:
+        QVERIFY(strings.localData().isNull());
+        QVERIFY(strings.hasLocalData());
+        strings.clearLocalData();
+        QVERIFY(!strings.hasLocalData());
+    }
+    {
+        QThreadStorage<Pointer> values;
+        const int c = Pointer::count;
+
+        values.localData();
+        QVERIFY(values.hasLocalData());
+        QCOMPARE(Pointer::count, c + 1);
+
+        values.clearLocalData();
+        QVERIFY(!values.hasLocalData());
+        QCOMPARE(Pointer::count, c); // destroyed the payload
+
+        values.clearLocalData(); // idempotent
+        QVERIFY(!values.hasLocalData());
+        QCOMPARE(Pointer::count, c);
+    }
+    {
+        // move-only payload
+        QThreadStorage<std::unique_ptr<Pointer>> ptrs;
+        const int c = Pointer::count;
+
+        ptrs.setLocalData(std::make_unique<Pointer>());
+        QVERIFY(ptrs.hasLocalData());
+        QCOMPARE(Pointer::count, c + 1);
+
+        ptrs.clearLocalData();
+        QVERIFY(!ptrs.hasLocalData());
+        QCOMPARE(Pointer::count, c);
+    }
+}
