+void tst_QThreadStorage::otherStorageInDestructor_clearLocalData()
+{
+    // Like OtherStorageUsingPayload, but default-constructible, so it can be
+    // created in-place by localData(), without a temporary whose destructor
+    // would already make first use of `other`:
+    struct Payload
+    {
+        QThreadStorage<int> *other = nullptr;
+        ~Payload() { if (other) other->setLocalData(42); }
+    };
+
+    struct Thread : public QThread // clazy:exclude=missing-qobject-macro
+    {
+        QThreadStorage<Payload> &primary;
+        QThreadStorage<int> &other;
+
+        explicit Thread(QThreadStorage<Payload> &p, QThreadStorage<int> &o)
+            : primary(p), other(o)
+        { }
+
+        void run() override
+        {
+            primary.localData().other = &other;
+            QVERIFY(!other.hasLocalData());
+            primary.clearLocalData();
+            // the destructor made first use of `other` on this thread:
+            QVERIFY(!primary.hasLocalData());
+            QVERIFY(other.hasLocalData());
+            QCOMPARE(other.localData(), 42);
+        }
+    };
+
+    QThreadStorage<Payload> primary;
+    // see otherStorageInDestructor()
+    std::array<QThreadStorage<int>, 256> others;
+
+    Thread t(primary, others.back());
+    t.start();
+    QVERIFY(t.wait(WaitTimeout));
+}
