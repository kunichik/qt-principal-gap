+void tst_QThreadStorage::clearLocalData()
+{
+    QThreadStorage<Pointer *> pointers;
+    const QThreadStorage<Pointer *> &const_pointers = pointers;
+
+    // clearing without data is a no-op:
+    pointers.clearLocalData();
+    QVERIFY(!pointers.hasLocalData());
+
+    const int c = Pointer::count;
+    pointers.setLocalData(new Pointer);
+    QVERIFY(pointers.hasLocalData());
+    QCOMPARE(Pointer::count, c + 1);
+
+    pointers.clearLocalData();
+    QVERIFY(!pointers.hasLocalData());
+    QCOMPARE(Pointer::count, c); // the pointee was deleted
+    QCOMPARE(const_pointers.localData(), nullptr);
+
+    // clearing twice is fine:
+    pointers.clearLocalData();
+    QVERIFY(!pointers.hasLocalData());
+
+    // can set again after clearing:
+    pointers.setLocalData(new Pointer);
+    QVERIFY(pointers.hasLocalData());
+    QCOMPARE(Pointer::count, c + 1);
+    pointers.clearLocalData();
+    QCOMPARE(Pointer::count, c);
+}
+
+void tst_QThreadStorage::clearLocalData_valueBased()
+{
+    {
+        QThreadStorage<std::shared_ptr<Pointer>> tls;
+        const auto &const_tls = tls;
+
+        tls.clearLocalData();
+        QVERIFY(!tls.hasLocalData());
+
+        const int c = Pointer::count;
+        tls.setLocalData(std::make_shared<Pointer>());
+        QVERIFY(tls.hasLocalData());
+        QCOMPARE(Pointer::count, c + 1);
+
+        tls.clearLocalData();
+        QVERIFY(!tls.hasLocalData());
+        QCOMPARE(Pointer::count, c); // the stored object was destroyed
+
+        // the const overload returns a default-constructed T, but doesn't create data:
+        QCOMPARE(const_tls.localData(), nullptr);
+        QVERIFY(!tls.hasLocalData());
+
+        // the non-const overload re-creates a default-constructed T:
+        QCOMPARE(tls.localData(), nullptr);
+        QVERIFY(tls.hasLocalData());
+        tls.clearLocalData();
+        QVERIFY(!tls.hasLocalData());
+    }
+    {
+        QThreadStorage<QString> tls;
+        tls.setLocalData(u"hello"_s);
+        QCOMPARE(tls.localData(), u"hello"_s);
+
+        tls.clearLocalData();
+        QVERIFY(!tls.hasLocalData());
+        QVERIFY(tls.localData().isNull()); // fresh, not the old value
+        QVERIFY(tls.hasLocalData());
+
+        tls.localData() = u"world"_s;
+        tls.clearLocalData();
+        tls.clearLocalData();
+        QVERIFY(!tls.hasLocalData());
+    }
+}
+
+void tst_QThreadStorage::clearLocalData_otherThreads()
+{
+    struct Thread : QThread // clazy:exclude=missing-qobject-macro
+    {
+        QThreadStorage<QString> &tls;
+        explicit Thread(QThreadStorage<QString> &t) : tls(t) {}
+
+        void run() override
+        {
+            QVERIFY(!tls.hasLocalData());
+            // must not affect the main thread's data:
+            tls.clearLocalData();
+            QVERIFY(!tls.hasLocalData());
+
+            tls.setLocalData(u"thread"_s);
+            QVERIFY(tls.hasLocalData());
+            tls.clearLocalData();
+            QVERIFY(!tls.hasLocalData());
+        }
+    };
+
+    QThreadStorage<QString> tls;
+    tls.setLocalData(u"main"_s);
+
+    Thread t(tls);
+    t.start();
+    QVERIFY(t.wait(WaitTimeout));
+
+    QVERIFY(tls.hasLocalData());
+    QCOMPARE(tls.localData(), u"main"_s);
+    tls.clearLocalData();
+    QVERIFY(!tls.hasLocalData());
+}
+
 class Thread : public QThread
 {
     Q_OBJECT
