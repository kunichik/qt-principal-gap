+void tst_QThreadStorage::clearLocalDataValueBased()
+{
+    QThreadStorage<SPointer> tlsSPointer;
+    QThreadStorage<QString> tlsString;
+    const int c = SPointer::count.loadRelaxed();
+
+    // clearing when there's nothing to clear is a no-op:
+    tlsSPointer.clearLocalData();
+    QVERIFY(!tlsSPointer.hasLocalData());
+    QCOMPARE(SPointer::count.loadRelaxed(), c);
+
+    // implicitly created by localData():
+    [[maybe_unused]] SPointer &p = tlsSPointer.localData();
+    QVERIFY(tlsSPointer.hasLocalData());
+    QCOMPARE(SPointer::count.loadRelaxed(), c + 1);
+
+    tlsSPointer.clearLocalData();
+    QVERIFY(!tlsSPointer.hasLocalData());
+    QCOMPARE(SPointer::count.loadRelaxed(), c);
+
+    // idempotent:
+    tlsSPointer.clearLocalData();
+    QVERIFY(!tlsSPointer.hasLocalData());
+    QCOMPARE(SPointer::count.loadRelaxed(), c);
+
+    // explicitly set by setLocalData():
+    tlsSPointer.setLocalData(SPointer());
+    QVERIFY(tlsSPointer.hasLocalData());
+    QCOMPARE(SPointer::count.loadRelaxed(), c + 1);
+    tlsSPointer.clearLocalData();
+    QVERIFY(!tlsSPointer.hasLocalData());
+    QCOMPARE(SPointer::count.loadRelaxed(), c);
+
+    // after clearing, localData() returns a new default-constructed value:
+    tlsString.setLocalData(u"hello"_s);
+    QCOMPARE(tlsString.localData(), u"hello"_s);
+    tlsString.clearLocalData();
+    QVERIFY(!tlsString.hasLocalData());
+    QVERIFY(std::as_const(tlsString).localData().isNull());
+    QVERIFY(!tlsString.hasLocalData()); // the const overload doesn't create
+    QVERIFY(tlsString.localData().isNull());
+    QVERIFY(tlsString.hasLocalData());
+    tlsString.clearLocalData();
+    QVERIFY(!tlsString.hasLocalData());
+}
+
+void tst_QThreadStorage::clearLocalDataOnlyAffectsCurrentThread()
+{
+    QThreadStorage<QString> tls;
+    tls.setLocalData(u"main"_s);
+
+    bool otherHadData = true;
+    bool otherClearedOk = false;
+    QString otherValueAfterMainCleared;
+
+    QMutex mutex;
+    QWaitCondition cond;
+    enum { Started, Set, MainCleared, Done } state = Started;
+
+    auto thread = std::unique_ptr<QThread>(QThread::create([&] {
+        otherHadData = tls.hasLocalData();
+        tls.clearLocalData(); // doesn't touch the main thread's data
+        tls.setLocalData(u"other"_s);
+        {
+            QMutexLocker locker(&mutex);
+            state = Set;
+            cond.wakeAll();
+            while (state != MainCleared)
+                cond.wait(&mutex);
+        }
+        otherValueAfterMainCleared = tls.localData();
+        tls.clearLocalData();
+        otherClearedOk = !tls.hasLocalData();
+    }));
+    thread->start();
+
+    {
+        QMutexLocker locker(&mutex);
+        while (state != Set)
+            QVERIFY(cond.wait(&mutex, WaitTimeout));
+        QVERIFY(tls.hasLocalData());
+        QCOMPARE(tls.localData(), u"main"_s);
+        tls.clearLocalData();
+        QVERIFY(!tls.hasLocalData());
+        state = MainCleared;
+        cond.wakeAll();
+    }
+    QVERIFY(thread->wait(WaitTimeout));
+
+    QVERIFY(!otherHadData);
+    QCOMPARE(otherValueAfterMainCleared, u"other"_s);
+    QVERIFY(otherClearedOk);
+    QVERIFY(!tls.hasLocalData());
+}
 
