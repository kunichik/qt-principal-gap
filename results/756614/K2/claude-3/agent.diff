+void tst_QThreadStorage::clearLocalData()
+{
+    QThreadStorage<Pointer *> pointers;
+    const int c = Pointer::count;
+
+    // no-op without data
+    pointers.clearLocalData();
+    QVERIFY(!pointers.hasLocalData());
+
+    pointers.setLocalData(new Pointer);
+    QVERIFY(pointers.hasLocalData());
+    QCOMPARE(Pointer::count, c + 1);
+
+    pointers.clearLocalData();
+    QVERIFY(!pointers.hasLocalData());
+    QCOMPARE(Pointer::count, c);
+    QCOMPARE(pointers.localData(), nullptr);
+
+    // repeated calls are fine
+    pointers.clearLocalData();
+    QVERIFY(!pointers.hasLocalData());
+}
+
+namespace {
+struct Counted
+{
+    static inline int count = 0;
+    int value = 42;
+    Counted() { ++count; }
+    Counted(const Counted &other) : value(other.value) { ++count; }
+    Counted &operator=(const Counted &) = default;
+    ~Counted() { --count; }
+};
+} // unnamed namespace
+
+void tst_QThreadStorage::clearLocalData_valueBased()
+{
+    QThreadStorage<Counted> storage;
+    const int c = Counted::count;
+
+    // no-op without data
+    storage.clearLocalData();
+    QVERIFY(!storage.hasLocalData());
+    QCOMPARE(Counted::count, c);
+
+    storage.localData().value = 1;
+    QVERIFY(storage.hasLocalData());
+    QCOMPARE(Counted::count, c + 1);
+
+    storage.clearLocalData();
+    QVERIFY(!storage.hasLocalData());
+    QCOMPARE(Counted::count, c);
+
+    // a fresh, default-constructed instance is created on next access
+    QCOMPARE(storage.localData().value, 42);
+    QVERIFY(storage.hasLocalData());
+    QCOMPARE(Counted::count, c + 1);
+    storage.clearLocalData();
+    QCOMPARE(Counted::count, c);
+
+    QThreadStorage<QString> strings;
+    strings.setLocalData(u"Hello"_s);
+    QVERIFY(strings.hasLocalData());
+    strings.clearLocalData();
+    QVERIFY(!strings.hasLocalData());
+    QVERIFY(strings.localData().isNull());
+
+    // don't leave data behind for the next QThreadStorage that reuses this id
+    strings.clearLocalData();
+}
+
+void tst_QThreadStorage::clearLocalData_otherThread()
+{
+    QThreadStorage<QString> strings;
+    strings.setLocalData(u"main"_s);
+
+    auto t = std::unique_ptr<QThread>(QThread::create([&strings] {
+        QVERIFY(!strings.hasLocalData());
+        strings.setLocalData(u"other"_s);
+        strings.clearLocalData();
+        QVERIFY(!strings.hasLocalData());
+    }));
+    t->start();
+    QVERIFY(t->wait(WaitTimeout));
+
+    // clearing in one thread doesn't affect another thread
+    QVERIFY(strings.hasLocalData());
+    QCOMPARE(strings.localData(), u"main"_s);
+
+    strings.clearLocalData();
+    QVERIFY(!strings.hasLocalData());
+}
+
+namespace {
+struct ClearInDestructorTester
+{
+    QThreadStorage<ClearInDestructorTester> *storage = nullptr;
+    bool *hadLocalDataInDestructor = nullptr;
+    ~ClearInDestructorTester()
+    {
+        if (storage) {
+            *hadLocalDataInDestructor = storage->hasLocalData();
+            storage->clearLocalData(); // must be harmless
+        }
+    }
+};
+} // unnamed namespace
+
+void tst_QThreadStorage::clearLocalData_inDestructor()
+{
+    QThreadStorage<ClearInDestructorTester> storage;
+    bool hadLocalData = true;
+    storage.localData().storage = &storage;
+    storage.localData().hadLocalDataInDestructor = &hadLocalData;
+    QVERIFY(storage.hasLocalData());
+
+    storage.clearLocalData();
+    QVERIFY(!storage.hasLocalData());
+    QVERIFY(!hadLocalData);
+}
