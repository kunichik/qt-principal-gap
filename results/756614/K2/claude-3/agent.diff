+
+/*!
+    \fn template <class T> void QThreadStorage<T>::clearLocalData()
+    \since 6.13
+
+    Destroys the local data of the calling thread, if any. Afterwards,
+    hasLocalData() returns \c false for the calling thread, and the next call
+    to localData() creates a new, default-constructed instance.
+
+    If T is a pointer type, the object pointed to is deleted, just as if
+    \c{setLocalData(nullptr)} had been called. If T is a value type, the
+    stored instance of T is destroyed.
+
+    The data is detached from the storage before it is destroyed. If the
+    destructor of the data accesses this QThreadStorage, it observes that the
+    calling thread has no local data.
+
+    \sa setLocalData(), hasLocalData()
 */
 
 QT_END_NAMESPACE
