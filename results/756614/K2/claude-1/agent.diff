+void tst_QThreadStorage::clearLocalData_pointer()
+{
+    QThreadStorage<Pointer *> pointers;
+    const int c = Pointer::count;
+
+    // no-op if there's no data:
+    pointers.clearLocalData();
+    QVERIFY(!pointers.hasLocalData());
+
+    pointers.setLocalData(new Pointer);
+    QVERIFY(pointers.hasLocalData());
+    QCOMPARE(Pointer::count, c + 1);
+
+    pointers.clearLocalData();
+    QVERIFY(!pointers.hasLocalData());
+    QCOMPARE(pointers.localData(), nullptr);
+    QCOMPARE(Pointer::count, c);
+
+    // can be set again afterwards:
+    Pointer *p = new Pointer;
+    pointers.setLocalData(p);
+    QVERIFY(pointers.hasLocalData());
+    QCOMPARE(pointers.localData(), p);
+    pointers.clearLocalData();
+    QVERIFY(!pointers.hasLocalData());
+    QCOMPARE(Pointer::count, c);
+
+    // calling it repeatedly is fine:
+    pointers.clearLocalData();
+    QVERIFY(!pointers.hasLocalData());
+}
+
+void tst_QThreadStorage::clearLocalData_value()
+{
+    {
+        QThreadStorage<SPointer> tls;
+        const int c = SPointer::count.loadRelaxed();
+
+        // no-op if there's no data:
+        tls.clearLocalData();
+        QVERIFY(!tls.hasLocalData());
+        QCOMPARE(SPointer::count.loadRelaxed(), c);
+
+        tls.setLocalData(SPointer());
+        QVERIFY(tls.hasLocalData());
+        QCOMPARE(SPointer::count.loadRelaxed(), c + 1);
+
+        tls.clearLocalData();
+        QVERIFY(!tls.hasLocalData());
+        QCOMPARE(SPointer::count.loadRelaxed(), c);
+
+        // localData() re-creates a default-constructed value:
+        (void) tls.localData();
+        QVERIFY(tls.hasLocalData());
+        QCOMPARE(SPointer::count.loadRelaxed(), c + 1);
+
+        tls.clearLocalData();
+        QVERIFY(!tls.hasLocalData());
+        QCOMPARE(SPointer::count.loadRelaxed(), c);
+
+        tls.clearLocalData();
+        QVERIFY(!tls.hasLocalData());
+        QCOMPARE(SPointer::count.loadRelaxed(), c);
+    }
+    {
+        QThreadStorage<QString> tls;
+        tls.setLocalData(u"hello"_s);
+        QCOMPARE(tls.localData(), u"hello"_s);
+        tls.clearLocalData();
+        QVERIFY(!tls.hasLocalData());
+        QVERIFY(std::as_const(tls).localData().isNull());
+        QVERIFY(!tls.hasLocalData()); // the const overload doesn't create data
+        QVERIFY(tls.localData().isNull());
+        QVERIFY(tls.hasLocalData());
+    }
+    {
+        // move-only payload
+        QThreadStorage<std::unique_ptr<SPointer>> tls;
+        const int c = SPointer::count.loadRelaxed();
+        tls.setLocalData(std::make_unique<SPointer>());
+        QCOMPARE(SPointer::count.loadRelaxed(), c + 1);
+        tls.clearLocalData();
+        QVERIFY(!tls.hasLocalData());
+        QCOMPARE(SPointer::count.loadRelaxed(), c);
+    }
+}
+
+void tst_QThreadStorage::clearLocalData_otherThreads()
+{
+    QThreadStorage<SPointer> tls;
+    const int c = SPointer::count.loadRelaxed();
+
+    tls.setLocalData(SPointer());
+    QCOMPARE(SPointer::count.loadRelaxed(), c + 1);
+
+    bool otherHadDataBefore = true;
+    bool otherHadDataAfter = true;
+    std::thread t([&] {
+        otherHadDataBefore = tls.hasLocalData();
+        (void) tls.localData();
+        tls.clearLocalData();
+        otherHadDataAfter = tls.hasLocalData();
+    });
+    t.join();
+
+    QVERIFY(!otherHadDataBefore);
+    QVERIFY(!otherHadDataAfter);
+    // clearing in the other thread doesn't affect this thread's data:
+    QVERIFY(tls.hasLocalData());
+    QCOMPARE(SPointer::count.loadRelaxed(), c + 1);
+
+    tls.clearLocalData();
+    QVERIFY(!tls.hasLocalData());
+    QCOMPARE(SPointer::count.loadRelaxed(), c);
+}
+
 
 // ---------------------------------------------------------------------
 // QThreadStorage reentrancy contracts.
