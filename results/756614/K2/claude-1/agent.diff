+/*!
+    \fn template <class T> void QThreadStorage<T>::clearLocalData()
+    \since 6.13
+
+    Clears the local data for the calling thread, if any. Afterwards,
+    hasLocalData() returns \c false, until the data is set again by calling
+    setLocalData() or localData().
+
+    If T is a value type, the stored object is destroyed. If T is a pointer
+    type, the object pointed to is deleted; this is equivalent to calling
+    \c{setLocalData(nullptr)}.
