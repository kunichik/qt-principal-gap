+void tst_QThreadStorage::clearLocalData_valueBased()
+{
+    QThreadStorage<SPointer> spointers;
+    QThreadStorage<QString> strings;
+    QThreadStorage<std::unique_ptr<Pointer>> uniquePointers;
+    const int initialSPointerCount = SPointer::count.loadRelaxed();
+    const int initialPointerCount = Pointer::count;
+
+    // no data: must be a no-op
+    spointers.clearLocalData();
+    strings.clearLocalData();
+    uniquePointers.clearLocalData();
+    QVERIFY(!spointers.hasLocalData());
+    QVERIFY(!strings.hasLocalData());
+    QVERIFY(!uniquePointers.hasLocalData());
+
+    // data created by setLocalData():
+    spointers.setLocalData(SPointer());
+    strings.setLocalData(u"hello"_s);
+    uniquePointers.setLocalData(std::make_unique<Pointer>());
+    QVERIFY(spointers.hasLocalData());
+    QVERIFY(strings.hasLocalData());
+    QVERIFY(uniquePointers.hasLocalData());
+    QCOMPARE(SPointer::count.loadRelaxed(), initialSPointerCount + 1);
+    QCOMPARE(Pointer::count, initialPointerCount + 1);
+
+    spointers.clearLocalData();
+    strings.clearLocalData();
+    uniquePointers.clearLocalData();
+    QVERIFY(!spointers.hasLocalData());
+    QVERIFY(!strings.hasLocalData());
+    QVERIFY(!uniquePointers.hasLocalData());
+    QCOMPARE(SPointer::count.loadRelaxed(), initialSPointerCount);
+    QCOMPARE(Pointer::count, initialPointerCount);
+
+    // again: must be a no-op
+    spointers.clearLocalData();
+    QVERIFY(!spointers.hasLocalData());
+    QCOMPARE(SPointer::count.loadRelaxed(), initialSPointerCount);
+
+    // data created by localData():
+    [[maybe_unused]] SPointer &spointer = spointers.localData();
+    strings.localData() = u"world"_s;
+    QVERIFY(spointers.hasLocalData());
+    QCOMPARE(SPointer::count.loadRelaxed(), initialSPointerCount + 1);
+
+    spointers.clearLocalData();
+    strings.clearLocalData();
+    QVERIFY(!spointers.hasLocalData());
+    QVERIFY(!strings.hasLocalData());
+    QCOMPARE(SPointer::count.loadRelaxed(), initialSPointerCount);
+
+    // after clearing, localData() default-constructs anew:
+    QVERIFY(strings.localData().isNull());
+    QVERIFY(strings.hasLocalData());
+    strings.clearLocalData();
+
+    // in another thread:
+    bool hasLocalData = true;
+    std::unique_ptr<QThread> thread(QThread::create([&] {
+        spointers.setLocalData(SPointer());
+        uniquePointers.localData() = std::make_unique<Pointer>();
+        spointers.clearLocalData();
+        uniquePointers.clearLocalData();
+        hasLocalData = spointers.hasLocalData() || uniquePointers.hasLocalData();
+    }));
+    thread->start();
+    QVERIFY(thread->wait(WaitTimeout));
+    QVERIFY(!hasLocalData);
+    QCOMPARE(SPointer::count.loadRelaxed(), initialSPointerCount);
+    QCOMPARE(Pointer::count, initialPointerCount);
+}
 
