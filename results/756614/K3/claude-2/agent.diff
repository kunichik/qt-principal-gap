+void tst_QThreadStorage::clearLocalData()
+{
+    QThreadStorage<Pointer *> pointers;
+    const int initialCount = Pointer::count;
+
+    pointers.clearLocalData(); // no data: must be a no-op
+    QVERIFY(!pointers.hasLocalData());
+    QCOMPARE(Pointer::count, initialCount);
+
+    pointers.setLocalData(new Pointer);
+    QVERIFY(pointers.hasLocalData());
+    QCOMPARE(Pointer::count, initialCount + 1);
+
+    pointers.clearLocalData();
+    QVERIFY(!pointers.hasLocalData());
+    QCOMPARE(Pointer::count, initialCount);
+
+    pointers.clearLocalData(); // again: must be a no-op
+    QVERIFY(!pointers.hasLocalData());
+    QCOMPARE(Pointer::count, initialCount);
+
+    // the storage remains usable:
+    Pointer *pointer = new Pointer;
+    pointers.setLocalData(pointer);
+    QCOMPARE(pointers.localData(), pointer);
+    pointers.clearLocalData();
+    QCOMPARE(Pointer::count, initialCount);
+    QCOMPARE(pointers.localData(), nullptr);
+}
+
+void tst_QThreadStorage::clearLocalData_noData()
+{
+    QThreadStorage<Pointer *> pointers;
+    QThreadStorage<QString> strings;
+    pointers.setLocalData(new Pointer);
+    strings.setLocalData(u"main"_s);
+    const int initialCount = Pointer::count;
+
+    // a thread that never set data (and has no QThreadData, as it never used Qt):
+    bool hadThreadData = true;
+    bool hasLocalData = true;
+    std::thread thread([&] {
+        pointers.clearLocalData();
+        strings.clearLocalData();
+#ifdef QT_BUILD_INTERNAL
+        // clearing must not have created a QThreadData:
+        hadThreadData = QThreadData::currentThreadData() != nullptr;
+#else
+        hadThreadData = false;
+#endif
+        hasLocalData = pointers.hasLocalData() || strings.hasLocalData();
+    });
+    thread.join();
+    QVERIFY(!hadThreadData);
+    QVERIFY(!hasLocalData);
+
+    // a QThread that never set data:
+    std::unique_ptr<QThread> qthread(QThread::create([&] {
+        pointers.clearLocalData();
+        strings.clearLocalData();
+        hasLocalData = pointers.hasLocalData() || strings.hasLocalData();
+    }));
+    qthread->start();
+    QVERIFY(qthread->wait(WaitTimeout));
+    QVERIFY(!hasLocalData);
+
+    // other threads' data is unaffected:
+    QCOMPARE(Pointer::count, initialCount);
+    QVERIFY(pointers.hasLocalData());
+    QVERIFY(strings.hasLocalData());
+    QCOMPARE(strings.localData(), u"main"_s);
+
+    pointers.clearLocalData();
+    strings.clearLocalData();
+    QCOMPARE(Pointer::count, initialCount - 1);
+    QVERIFY(!pointers.hasLocalData());
+    QVERIFY(!strings.hasLocalData());
+}
