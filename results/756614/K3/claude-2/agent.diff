+void QThreadStorageData::clear()
+{
+    // unlike get() and set(), don't create a QThreadData if there's none:
+    QThreadData *data = QThreadData::currentThreadData();
+    if (!data)
+        return;
+    QList<void *> &tls = data->tls;
+    if (tls.size() <= id || tls.at(id) == nullptr)
+        return;
+
+    DEBUG_MSG("QThreadStorageData: Clearing storage %d, data %p, for thread %p",
+              id,
+              tls.at(id),
+              data->thread.loadRelaxed());
+
+    QMutexLocker locker(&destructorsMutex);
+    DestructorMap *destr = destructors();
+    void (*destructor)(void *) = destr ? destr->value(id) : nullptr;
+    locker.unlock();
+
+    void *q = std::exchange(tls[id], nullptr);
+    if (destructor)
+        destructor(q);
+}
