+/*!
+    \fn template <class T> void QThreadStorage<T>::clearLocalData()
+    \since 6.13
+
+    Deletes the calling thread's local data, if any. Afterwards,
+    hasLocalData() returns \c false for the calling thread. The data of
+    other threads is not affected.
+
+    If T is a pointer type, this deletes the object pointed to, like
+    \c{setLocalData(nullptr)} does. If T is a value type, this destroys the
+    stored value; a subsequent call to localData() will create a new,
+    default-constructed instance of T.
+
+    Unlike hasLocalData(), localData() and setLocalData(), this function can
+    safely be called during thread or program shutdown: if the calling
+    thread has no thread-local storage (anymore), it does nothing.
+
+    \sa setLocalData(), hasLocalData()
 */
 
