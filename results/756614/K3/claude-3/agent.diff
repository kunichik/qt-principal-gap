+void tst_QThreadStorage::clearLocalData_pointer()
+{
+    QThreadStorage<Pointer *> pointers;
+    const int initialCount = Pointer::count;
+
+    // clearing without data is a no-op:
+    pointers.clearLocalData();
+    QVERIFY(!pointers.hasLocalData());
+    QCOMPARE(Pointer::count, initialCount);
+
+    pointers.setLocalData(new Pointer);
+    QVERIFY(pointers.hasLocalData());
+    QCOMPARE(Pointer::count, initialCount + 1);
+
+    pointers.clearLocalData();
+    QVERIFY(!pointers.hasLocalData());
+    QCOMPARE(pointers.localData(), nullptr);
+    QCOMPARE(Pointer::count, initialCount);
+
+    // clearing twice is fine:
+    pointers.clearLocalData();
+    QVERIFY(!pointers.hasLocalData());
+    QCOMPARE(Pointer::count, initialCount);
+
+    // storage is usable again:
+    pointers.setLocalData(new Pointer);
+    QVERIFY(pointers.hasLocalData());
+    QCOMPARE(Pointer::count, initialCount + 1);
+    pointers.clearLocalData();
+    QCOMPARE(Pointer::count, initialCount);
+}
+
+void tst_QThreadStorage::clearLocalData_value()
+{
+    QThreadStorage<Pointer> values;
+    const int initialCount = Pointer::count;
+
+    values.clearLocalData();
+    QVERIFY(!values.hasLocalData());
+    QCOMPARE(Pointer::count, initialCount);
+
+    values.localData();
+    QVERIFY(values.hasLocalData());
+    QCOMPARE(Pointer::count, initialCount + 1);
+
+    values.clearLocalData();
+    QVERIFY(!values.hasLocalData());
+    QCOMPARE(Pointer::count, initialCount);
+
+    values.clearLocalData();
+    QVERIFY(!values.hasLocalData());
+    QCOMPARE(Pointer::count, initialCount);
+
+    // localData() default-constructs a new instance afterwards:
+    QThreadStorage<QString> strings;
+    strings.setLocalData(u"hello"_s);
+    QVERIFY(strings.hasLocalData());
+    strings.clearLocalData();
+    QVERIFY(!strings.hasLocalData());
+    QVERIFY(strings.localData().isNull());
+    QVERIFY(strings.hasLocalData());
+}
+
+void tst_QThreadStorage::clearLocalData_withoutData()
+{
+    QThreadStorage<Pointer *> pointers;
+    QThreadStorage<Pointer> values;
+    pointers.setLocalData(new Pointer);
+    values.localData();
+    const int initialCount = Pointer::count;
+
+    bool hadThreadDataBefore = true;
+    bool hadThreadDataAfter = true;
+    // A thread Qt doesn't know about, which never used either storage:
+    std::thread thread([&] {
+        hadThreadDataBefore = QThreadData::currentThreadData() != nullptr;
+        pointers.clearLocalData();
+        values.clearLocalData();
+        // clearing must not have created a QThreadData for this thread:
+        hadThreadDataAfter = QThreadData::currentThreadData() != nullptr;
+    });
+    thread.join();
+
+    QVERIFY(!hadThreadDataBefore);
+    QVERIFY(!hadThreadDataAfter);
+
+    // the main thread's data is unaffected:
+    QVERIFY(pointers.hasLocalData());
+    QVERIFY(values.hasLocalData());
+    QCOMPARE(Pointer::count, initialCount);
+
+    pointers.clearLocalData();
+    values.clearLocalData();
+    QCOMPARE(Pointer::count, initialCount - 2);
+}
