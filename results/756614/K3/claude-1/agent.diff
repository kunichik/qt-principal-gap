+void tst_QThreadStorage::clearLocalData_pointer()
+{
+    QThreadStorage<Pointer *> pointers;
+    const int initialCount = Pointer::count;
+
+    // clearing without data is a no-op:
+    pointers.clearLocalData();
+    QVERIFY(!pointers.hasLocalData());
+    QCOMPARE(Pointer::count, initialCount);
+
+    pointers.setLocalData(new Pointer);
+    QVERIFY(pointers.hasLocalData());
+    QCOMPARE(Pointer::count, initialCount + 1);
+
+    pointers.clearLocalData();
+    QVERIFY(!pointers.hasLocalData());
+    QCOMPARE(pointers.localData(), nullptr);
+    QCOMPARE(Pointer::count, initialCount);
+
+    // clearing twice is fine:
+    pointers.clearLocalData();
+    QVERIFY(!pointers.hasLocalData());
+    QCOMPARE(Pointer::count, initialCount);
+
+    // storage is usable again afterwards:
+    pointers.setLocalData(new Pointer);
+    QVERIFY(pointers.hasLocalData());
+    QCOMPARE(Pointer::count, initialCount + 1);
+    pointers.clearLocalData();
+    QCOMPARE(Pointer::count, initialCount);
+}
+
+void tst_QThreadStorage::clearLocalData_value()
+{
+    QThreadStorage<SPointer> spointers;
+    QThreadStorage<QString> strings;
+    const int initialCount = SPointer::count.loadRelaxed();
+
+    // clearing without data is a no-op:
+    spointers.clearLocalData();
+    strings.clearLocalData();
+    QVERIFY(!spointers.hasLocalData());
+    QVERIFY(!strings.hasLocalData());
+    QCOMPARE(SPointer::count.loadRelaxed(), initialCount);
+
+    spointers.setLocalData(SPointer());
+    QVERIFY(spointers.hasLocalData());
+    QCOMPARE(SPointer::count.loadRelaxed(), initialCount + 1);
+
+    spointers.clearLocalData();
+    QVERIFY(!spointers.hasLocalData());
+    QCOMPARE(SPointer::count.loadRelaxed(), initialCount);
+
+    // localData() re-creates a default-constructed value:
+    strings.setLocalData(u"hello"_s);
+    QCOMPARE(strings.localData(), u"hello"_s);
+    strings.clearLocalData();
+    QVERIFY(!strings.hasLocalData());
+    QVERIFY(strings.localData().isNull());
+    QVERIFY(strings.hasLocalData());
+    strings.clearLocalData();
+    QVERIFY(!strings.hasLocalData());
+
+    // only the calling thread's data is cleared:
+    spointers.setLocalData(SPointer());
+    QCOMPARE(SPointer::count.loadRelaxed(), initialCount + 1);
+    bool otherThreadHadData = true;
+    int countInOtherThread = 0;
+    std::thread otherThread([&] {
+        spointers.setLocalData(SPointer());
+        countInOtherThread = SPointer::count.loadRelaxed();
+        spointers.clearLocalData();
+        otherThreadHadData = spointers.hasLocalData();
+    });
+    otherThread.join();
+    QCOMPARE(countInOtherThread, initialCount + 2);
+    QVERIFY(!otherThreadHadData);
+    QVERIFY(spointers.hasLocalData());
+    QCOMPARE(SPointer::count.loadRelaxed(), initialCount + 1);
+
+    spointers.clearLocalData();
+    QCOMPARE(SPointer::count.loadRelaxed(), initialCount);
+}
+
+void tst_QThreadStorage::clearLocalData_threadWithoutData()
+{
+    QThreadStorage<Pointer *> pointers;
+    QThreadStorage<SPointer> spointers;
+    const int initialPointerCount = Pointer::count;
+    const int initialSPointerCount = SPointer::count.loadRelaxed();
+
+    // other threads' data must survive:
+    pointers.setLocalData(new Pointer);
+    spointers.setLocalData(SPointer());
+
+    bool hadThreadDataBefore = false;
+    bool hadThreadDataAfter = false;
+    std::thread neverSetThread([&] {
+#ifdef QT_BUILD_INTERNAL
+        hadThreadDataBefore = QThreadData::currentThreadData() != nullptr;
+#endif
+        pointers.clearLocalData();
+        spointers.clearLocalData();
+#ifdef QT_BUILD_INTERNAL
+        // clearing must not create a QThreadData:
+        hadThreadDataAfter = QThreadData::currentThreadData() != nullptr;
+#endif
+    });
+    neverSetThread.join();
+    QVERIFY(!hadThreadDataBefore);
+    QVERIFY(!hadThreadDataAfter);
+
+    QVERIFY(pointers.hasLocalData());
+    QVERIFY(spointers.hasLocalData());
+    QCOMPARE(Pointer::count, initialPointerCount + 1);
+    QCOMPARE(SPointer::count.loadRelaxed(), initialSPointerCount + 1);
+
+    pointers.clearLocalData();
+    spointers.clearLocalData();
+    QCOMPARE(Pointer::count, initialPointerCount);
+    QCOMPARE(SPointer::count.loadRelaxed(), initialSPointerCount);
+}
