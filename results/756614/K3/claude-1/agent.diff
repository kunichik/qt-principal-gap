+void QThreadStorageData::clear()
+{
+    // Don't use get()/set() unconditionally: they'd create a QThreadData
+    // (and grow its tls) for a thread that has nothing to clear.
+    QThreadData *data = QThreadData::currentThreadData();
+    if (!data || data->tls.size() <= id || !data->tls.at(id))
+        return;
+    (void) set(nullptr);
+}
