+/*!
+    \fn template <class T> void QThreadStorage<T>::clearLocalData()
+    \since 6.13
+
+    Destroys the local data of the calling thread, if any. Afterwards,
+    hasLocalData() returns \c false for the calling thread. The data of
+    other threads is not affected.
+
+    If T is a pointer type, this deletes the object pointed to, and is
+    equivalent to calling \c{setLocalData(nullptr)}. If T is a value type,
+    this destroys the stored value; a subsequent call to localData() will
+    create a new, default-constructed one.
+
+    Unlike setLocalData(), this function does not create the thread's
+    internal bookkeeping data if the calling thread has never used thread
+    storage, which makes it safe to call during program shutdown, for
+    instance from the destructor of a Q_GLOBAL_STATIC.
+
+    \sa setLocalData(), hasLocalData()
 */
 
 QT_END_NAMESPACE
