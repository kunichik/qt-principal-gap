+namespace {
+
+// A value payload whose destructor clears both storages, including the one
+// it is being destroyed from:
+class ClearingPayload
+{
+public:
+    static inline QThreadStorage<ClearingPayload> *first = nullptr;
+    static inline QThreadStorage<ClearingPayload> *second = nullptr;
+    static inline QBasicAtomicInt destroyed = Q_BASIC_ATOMIC_INITIALIZER(0);
+
+    ~ClearingPayload()
+    {
+        destroyed.ref();
+        first->clearLocalData();
+        second->clearLocalData();
+    }
+};
+
+} // unnamed namespace
+
+void tst_QThreadStorage::clearInDestructor()
+{
+    QThreadStorage<ClearingPayload> first;
+    QThreadStorage<ClearingPayload> second;
+    ClearingPayload::first = &first;
+    ClearingPayload::second = &second;
+    auto cleanup = qScopeGuard([] {
+        ClearingPayload::first = nullptr;
+        ClearingPayload::second = nullptr;
+    });
+
+    // explicit clearLocalData():
+    std::thread t1([&] {
+        ClearingPayload::destroyed.storeRelaxed(0);
+        first.localData();
+        second.localData();
+        first.clearLocalData();
+        QVERIFY(!first.hasLocalData());
+        QVERIFY(!second.hasLocalData());
+        QCOMPARE(ClearingPayload::destroyed.loadRelaxed(), 2);
+    });
+    t1.join();
+
+    // thread exit, with the first payload still set:
+    std::thread t2([&] {
+        ClearingPayload::destroyed.storeRelaxed(0);
+        first.localData();
+        second.localData();
+    });
+    t2.join();
+    QCOMPARE(ClearingPayload::destroyed.loadRelaxed(), 2);
+}
