+/*!
+    \fn template <class T> void QThreadStorage<T>::clearLocalData()
+    \since 6.13
+
+    Destroys the local data of the calling thread, if any. Afterwards,
+    hasLocalData() returns \c false for the calling thread, until data is
+    stored again using setLocalData() or localData().
+
+    If T is a pointer type, this deletes the object pointed to, and is
+    equivalent to calling \c{setLocalData(nullptr)}. If T is a value type,
+    this destroys the stored value; there is no way to achieve this with
+    setLocalData().
