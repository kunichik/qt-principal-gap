+void tst_QThreadStorage::clearLocalData()
+{
+    QThreadStorage<Pointer *> pointers;
+    const int c = Pointer::count;
+
+    // no data: no-op
+    pointers.clearLocalData();
+    QVERIFY(!pointers.hasLocalData());
+
+    pointers.setLocalData(new Pointer);
+    QVERIFY(pointers.hasLocalData());
+    QCOMPARE(Pointer::count, c + 1);
+
+    pointers.clearLocalData();
+    QVERIFY(!pointers.hasLocalData());
+    QCOMPARE(pointers.localData(), nullptr);
+    QCOMPARE(Pointer::count, c);
+
+    // storage is usable again afterwards
+    pointers.setLocalData(new Pointer);
+    QVERIFY(pointers.hasLocalData());
+    QCOMPARE(Pointer::count, c + 1);
+    pointers.clearLocalData();
+    pointers.clearLocalData(); // idempotent
+    QVERIFY(!pointers.hasLocalData());
+    QCOMPARE(Pointer::count, c);
+}
+
+void tst_QThreadStorage::clearLocalDataValueBased()
+{
+    {
+        QThreadStorage<QString> strings;
+
+        strings.clearLocalData(); // no data: no-op
+        QVERIFY(!strings.hasLocalData());
+
+        strings.setLocalData(u"hello"_s);
+        QVERIFY(strings.hasLocalData());
+        strings.clearLocalData();
+        QVERIFY(!strings.hasLocalData());
+
+        // localData() re-creates a default-constructed value
+        QVERIFY(strings.localData().isNull());
+        QVERIFY(strings.hasLocalData());
+        strings.clearLocalData();
+        QVERIFY(!strings.hasLocalData());
+    }
+    {
+        // the value is destroyed (not just reset) by clearLocalData():
+        QThreadStorage<std::unique_ptr<Pointer>> uniquePtrs;
+        const int c = Pointer::count;
+
+        uniquePtrs.setLocalData(std::make_unique<Pointer>());
+        QVERIFY(uniquePtrs.hasLocalData());
+        QCOMPARE(Pointer::count, c + 1);
+
+        uniquePtrs.clearLocalData();
+        QVERIFY(!uniquePtrs.hasLocalData());
+        QCOMPARE(Pointer::count, c);
+
+        uniquePtrs.localData() = std::make_unique<Pointer>();
+        QCOMPARE(Pointer::count, c + 1);
+        uniquePtrs.clearLocalData();
+        QVERIFY(!uniquePtrs.hasLocalData());
+        QCOMPARE(Pointer::count, c);
+    }
+}
+
+void tst_QThreadStorage::clearLocalDataOtherThreads()
+{
+    QThreadStorage<QString> strings;
+    strings.setLocalData(u"main"_s);
+
+    bool hadData = false;
+    bool hasDataAfterClear = true;
+    QString otherValue;
+    std::unique_ptr<QThread> t(QThread::create([&]() {
+        strings.setLocalData(u"other"_s);
+        hadData = strings.hasLocalData();
+        strings.clearLocalData();
+        hasDataAfterClear = strings.hasLocalData();
+        otherValue = strings.localData();
+    }));
+    t->start();
+    QVERIFY(t->wait(WaitTimeout));
+
+    QVERIFY(hadData);
+    QVERIFY(!hasDataAfterClear);
+    QVERIFY(otherValue.isNull());
+
+    // clearing in another thread doesn't affect this thread's data:
+    QVERIFY(strings.hasLocalData());
+    QCOMPARE(strings.localData(), u"main"_s);
+
+    // ... and vice versa
+    QString otherValueBefore;
+    t.reset(QThread::create([&]() {
+        strings.setLocalData(u"other"_s);
+        QMetaObject::invokeMethod(QCoreApplication::instance(), [&]() {
+            strings.clearLocalData();
+        }, Qt::BlockingQueuedConnection);
+        otherValueBefore = strings.localData();
+    }));
+    t->start();
+    QTRY_VERIFY(t->isFinished());
+    QVERIFY(t->wait(WaitTimeout));
+    QCOMPARE(otherValueBefore, u"other"_s);
+    QVERIFY(!strings.hasLocalData());
+}
+
