+void tst_QThreadStorage::clearLocalData()
+{
+    QThreadStorage<Pointer *> pointers;
+    const int c = Pointer::count;
+
+    // no data: must be a no-op
+    pointers.clearLocalData();
+    QVERIFY(!pointers.hasLocalData());
+    QCOMPARE(Pointer::count, c);
+
+    pointers.setLocalData(new Pointer);
+    QVERIFY(pointers.hasLocalData());
+    QCOMPARE(Pointer::count, c + 1);
+
+    pointers.clearLocalData();
+    QVERIFY(!pointers.hasLocalData());
+    QCOMPARE(Pointer::count, c);
+    QCOMPARE(pointers.localData(), nullptr);
+    QVERIFY(!pointers.hasLocalData());
+
+    // clearing twice is fine
+    pointers.clearLocalData();
+    QVERIFY(!pointers.hasLocalData());
+    QCOMPARE(Pointer::count, c);
+
+    // storage is usable again afterwards
+    Pointer *p = new Pointer;
+    pointers.setLocalData(p);
+    QCOMPARE(pointers.localData(), p);
+    pointers.clearLocalData();
+    QVERIFY(!pointers.hasLocalData());
+    QCOMPARE(Pointer::count, c);
+}
+
+void tst_QThreadStorage::clearLocalData_valueBased()
+{
+    {
+        QThreadStorage<SPointer> tls;
+        const int c = SPointer::count.loadRelaxed();
+
+        tls.clearLocalData();
+        QVERIFY(!tls.hasLocalData());
+        QCOMPARE(int(SPointer::count.loadRelaxed()), c);
+
+        // implicitly created by localData()
+        [[maybe_unused]] SPointer &ref = tls.localData();
+        QVERIFY(tls.hasLocalData());
+        QCOMPARE(int(SPointer::count.loadRelaxed()), c + 1);
+
+        tls.clearLocalData();
+        QVERIFY(!tls.hasLocalData());
+        QCOMPARE(int(SPointer::count.loadRelaxed()), c);
+
+        // explicitly set
+        tls.setLocalData(SPointer());
+        QVERIFY(tls.hasLocalData());
+        QCOMPARE(int(SPointer::count.loadRelaxed()), c + 1);
+
+        tls.clearLocalData();
+        QVERIFY(!tls.hasLocalData());
+        QCOMPARE(int(SPointer::count.loadRelaxed()), c);
+
+        tls.clearLocalData();
+        QVERIFY(!tls.hasLocalData());
+        QCOMPARE(int(SPointer::count.loadRelaxed()), c);
+    }
+    {
+        // after clearing, localData() starts over with a default-constructed value
+        QThreadStorage<QString> tls;
+        tls.setLocalData(u"hello"_s);
+        QCOMPARE(tls.localData(), u"hello"_s);
+        tls.clearLocalData();
+        QVERIFY(!tls.hasLocalData());
+        QVERIFY(tls.localData().isNull());
+        QVERIFY(tls.hasLocalData());
+        tls.clearLocalData();
+        QVERIFY(!tls.hasLocalData());
+    }
+    {
+        // move-only payload
+        QThreadStorage<std::unique_ptr<Pointer>> tls;
+        const int c = Pointer::count;
+        tls.setLocalData(std::make_unique<Pointer>());
+        QCOMPARE(Pointer::count, c + 1);
+        tls.clearLocalData();
+        QVERIFY(!tls.hasLocalData());
+        QCOMPARE(Pointer::count, c);
+        QCOMPARE(tls.localData(), nullptr);
+        tls.clearLocalData();
+    }
+}
+
+void tst_QThreadStorage::clearLocalData_perThread()
+{
+    QThreadStorage<QString> strings;
+    QThreadStorage<Pointer *> pointers;
+    const int c = Pointer::count;
+
+    strings.setLocalData(u"main"_s);
+    pointers.setLocalData(new Pointer);
+
+    QMutex mutex;
+    QWaitCondition cond;
+    bool threadHasData = false;
+    bool mainHasCleared = false;
+    bool ok = false;
+
+    std::unique_ptr<QThread> thread(QThread::create([&]() {
+        // the main thread's data is not visible here, and clearing doesn't touch it:
+        if (strings.hasLocalData() || pointers.hasLocalData())
+            return;
+        strings.clearLocalData();
+        pointers.clearLocalData();
+
+        strings.setLocalData(u"thread"_s);
+        pointers.setLocalData(new Pointer);
+
+        QMutexLocker locker(&mutex);
+        threadHasData = true;
+        cond.wakeOne();
+        while (!mainHasCleared) {
+            if (!cond.wait(&mutex, WaitTimeout / 2))
+                return;
+        }
+        // the main thread clearing its data didn't touch ours:
+        ok = strings.hasLocalData() && strings.localData() == u"thread"_s
+                && pointers.hasLocalData() && pointers.localData() != nullptr;
+        strings.clearLocalData();
+        pointers.clearLocalData();
+        ok = ok && !strings.hasLocalData() && !pointers.hasLocalData();
+    }));
+    thread->start();
+    {
+        QMutexLocker locker(&mutex);
+        while (!threadHasData)
+            QVERIFY(cond.wait(&mutex, WaitTimeout / 2));
+        QCOMPARE(Pointer::count, c + 2);
+        QCOMPARE(strings.localData(), u"main"_s);
+        QVERIFY(pointers.hasLocalData());
+
+        strings.clearLocalData();
+        pointers.clearLocalData();
+        QVERIFY(!strings.hasLocalData());
+        QVERIFY(!pointers.hasLocalData());
+        QCOMPARE(Pointer::count, c + 1);
+
+        mainHasCleared = true;
+        cond.wakeOne();
+    }
+    QVERIFY(thread->wait(WaitTimeout));
+    QVERIFY(ok);
+    QCOMPARE(Pointer::count, c);
+}
