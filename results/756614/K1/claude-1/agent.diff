+namespace {
+
+// A payload whose destructor calls clearLocalData() on its own storage:
+class SelfClearingPayload
+{
+public:
+    explicit SelfClearingPayload(QThreadStorage<SelfClearingPayload *> *storage)
+        : storage(storage)
+    {}
+    ~SelfClearingPayload()
+    {
+        destroyed = true;
+        storage->clearLocalData();
+        hadDataInDestructor = storage->hasLocalData();
+    }
+
+    static inline bool destroyed = false;
+    static inline bool hadDataInDestructor = false;
+
+private:
+    QThreadStorage<SelfClearingPayload *> *storage;
+};
+
+} // unnamed namespace
+
+void tst_QThreadStorage::clearInDestructor()
+{
+    QThreadStorage<SelfClearingPayload *> storage;
+    SelfClearingPayload::destroyed = false;
+    SelfClearingPayload::hadDataInDestructor = true;
+
+    std::unique_ptr<QThread> thread(QThread::create([&storage]() {
+        storage.setLocalData(new SelfClearingPayload(&storage));
+        storage.clearLocalData();
+    }));
+    thread->start();
+    QVERIFY(thread->wait(WaitTimeout));
+    QVERIFY(SelfClearingPayload::destroyed);
+    QVERIFY(!SelfClearingPayload::hadDataInDestructor);
+}
