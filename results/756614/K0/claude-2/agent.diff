+void tst_QThreadStorage::clearLocalData_pointer()
+{
+    QThreadStorage<Pointer *> pointers;
+    const int c = Pointer::count;
+
+    // no-op without data:
+    pointers.clearLocalData();
+    QVERIFY(!pointers.hasLocalData());
+    QCOMPARE(pointers.localData(), nullptr);
+
+    pointers.setLocalData(new Pointer);
+    QVERIFY(pointers.hasLocalData());
+    QCOMPARE(Pointer::count, c + 1);
+
+    pointers.clearLocalData();
+    QVERIFY(!pointers.hasLocalData());
+    QCOMPARE(Pointer::count, c); // deleted
+    QCOMPARE(std::as_const(pointers).localData(), nullptr);
+
+    // idempotent:
+    pointers.clearLocalData();
+    QVERIFY(!pointers.hasLocalData());
+    QCOMPARE(Pointer::count, c);
+
+    // storage is usable again:
+    pointers.setLocalData(new Pointer);
+    QVERIFY(pointers.hasLocalData());
+    QCOMPARE(Pointer::count, c + 1);
+    pointers.clearLocalData();
+    QCOMPARE(Pointer::count, c);
+}
+
+namespace {
+struct Counted
+{
+    static inline int count = 0;
+    int value = 0;
+    Counted() { ++count; }
+    Counted(const Counted &other) : value(other.value) { ++count; }
+    ~Counted() { --count; }
+};
+} // unnamed namespace
+
+void tst_QThreadStorage::clearLocalData_value()
+{
+    QThreadStorage<Counted> storage;
+    const int c = Counted::count;
+
+    // no-op without data:
+    storage.clearLocalData();
+    QVERIFY(!storage.hasLocalData());
+    QCOMPARE(Counted::count, c);
+
+    // lazily created by localData():
+    storage.localData().value = 42;
+    QVERIFY(storage.hasLocalData());
+    QCOMPARE(Counted::count, c + 1);
+
+    storage.clearLocalData();
+    QVERIFY(!storage.hasLocalData());
+    QCOMPARE(Counted::count, c); // destroyed
+
+    // idempotent:
+    storage.clearLocalData();
+    QVERIFY(!storage.hasLocalData());
+    QCOMPARE(Counted::count, c);
+
+    // const localData() doesn't re-create:
+    QCOMPARE(std::as_const(storage).localData().value, 0);
+    QVERIFY(!storage.hasLocalData());
+
+    // non-const localData() re-creates a default-constructed value:
+    QCOMPARE(storage.localData().value, 0);
+    QVERIFY(storage.hasLocalData());
+    QCOMPARE(Counted::count, c + 1);
+
+    // set by setLocalData():
+    {
+        Counted v;
+        v.value = 17;
+        storage.setLocalData(v);
+    }
+    QCOMPARE(storage.localData().value, 17);
+    QCOMPARE(Counted::count, c + 1);
+    storage.clearLocalData();
+    QVERIFY(!storage.hasLocalData());
+    QCOMPARE(Counted::count, c);
+
+    // move-only types:
+    QThreadStorage<std::unique_ptr<Counted>> uniquePtrs;
+    uniquePtrs.setLocalData(std::make_unique<Counted>());
+    QVERIFY(uniquePtrs.hasLocalData());
+    QCOMPARE(Counted::count, c + 1);
+    uniquePtrs.clearLocalData();
+    QVERIFY(!uniquePtrs.hasLocalData());
+    QCOMPARE(Counted::count, c);
+}
+
+namespace {
+// A payload whose destructor calls clearLocalData() on its own storage:
+struct SelfClearingPayload
+{
+    static inline int destructions = 0;
+    ~SelfClearingPayload();
+};
+Q_GLOBAL_STATIC(QThreadStorage<SelfClearingPayload>, selfClearingStorage)
+SelfClearingPayload::~SelfClearingPayload()
+{
+    ++destructions;
+    QVERIFY(!selfClearingStorage->hasLocalData());
+    selfClearingStorage->clearLocalData(); // must be a no-op
+}
+} // unnamed namespace
+
+void tst_QThreadStorage::clearLocalData_reentrant()
+{
+    SelfClearingPayload::destructions = 0;
+    selfClearingStorage->localData();
+    QVERIFY(selfClearingStorage->hasLocalData());
+    selfClearingStorage->clearLocalData();
+    QVERIFY(!selfClearingStorage->hasLocalData());
+    QCOMPARE(SelfClearingPayload::destructions, 1);
+}
+
+void tst_QThreadStorage::clearLocalData_perThread()
+{
+    QThreadStorage<QString> strings;
+    strings.setLocalData(u"main"_s);
+
+    bool threadHadDataInitially = true;
+    bool threadHadDataAfterSet = false;
+    bool threadHadDataAfterClear = true;
+    std::unique_ptr<QThread> thread(QThread::create([&] {
+        threadHadDataInitially = strings.hasLocalData();
+        strings.setLocalData(u"thread"_s);
+        threadHadDataAfterSet = strings.hasLocalData();
+        strings.clearLocalData();
+        threadHadDataAfterClear = strings.hasLocalData();
+    }));
+    thread->start();
+    QVERIFY(thread->wait(WaitTimeout));
+
+    QVERIFY(!threadHadDataInitially);
+    QVERIFY(threadHadDataAfterSet);
+    QVERIFY(!threadHadDataAfterClear);
+
+    // the main thread's data is unaffected:
+    QVERIFY(strings.hasLocalData());
+    QCOMPARE(strings.localData(), u"main"_s);
+
+    strings.clearLocalData();
+    QVERIFY(!strings.hasLocalData());
+}
+
