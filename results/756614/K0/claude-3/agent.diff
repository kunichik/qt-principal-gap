+void QThreadStorageData::clear()
+{
+    // Don't use QThreadData::current(): if this thread has no QThreadData
+    // (yet, or anymore), there is nothing to clear, and we must not create one.
+    QThreadData *data = QThreadData::currentThreadData();
+    if (!data || data->tls.size() <= id || !data->tls.at(id))
+        return;
+    (void) set(nullptr);
+}
