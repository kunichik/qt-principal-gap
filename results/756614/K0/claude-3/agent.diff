+void tst_QThreadStorage::clearLocalData_pointer()
+{
+    const int c = Pointer::count;
+    QThreadStorage<Pointer *> pointers;
+
+    // no-op when there's no data:
+    pointers.clearLocalData();
+    QVERIFY(!pointers.hasLocalData());
+
+    pointers.setLocalData(new Pointer);
+    QVERIFY(pointers.hasLocalData());
+    QCOMPARE(Pointer::count, c + 1);
+
+    pointers.clearLocalData();
+    QVERIFY(!pointers.hasLocalData());
+    QCOMPARE(pointers.localData(), nullptr);
+    QCOMPARE(Pointer::count, c); // deleted
+
+    // can be set again:
+    Pointer *p = new Pointer;
+    pointers.setLocalData(p);
+    QVERIFY(pointers.hasLocalData());
+    QCOMPARE(pointers.localData(), p);
+    pointers.clearLocalData();
+    QVERIFY(!pointers.hasLocalData());
+    QCOMPARE(Pointer::count, c);
+
+    // repeated clearing is fine:
+    pointers.clearLocalData();
+    QVERIFY(!pointers.hasLocalData());
+}
+
+void tst_QThreadStorage::clearLocalData_value()
+{
+    const int c = SPointer::count.loadRelaxed();
+    {
+        QThreadStorage<SPointer> tls;
+        tls.clearLocalData();
+        QVERIFY(!tls.hasLocalData());
+        QCOMPARE(SPointer::count.loadRelaxed(), c);
+
+        // created by localData():
+        [[maybe_unused]] SPointer &ref = tls.localData();
+        QVERIFY(tls.hasLocalData());
+        QCOMPARE(SPointer::count.loadRelaxed(), c + 1);
+
+        tls.clearLocalData();
+        QVERIFY(!tls.hasLocalData());
+        QCOMPARE(SPointer::count.loadRelaxed(), c);
+
+        // created by setLocalData():
+        tls.setLocalData(SPointer());
+        QVERIFY(tls.hasLocalData());
+        QCOMPARE(SPointer::count.loadRelaxed(), c + 1);
+
+        tls.clearLocalData();
+        QVERIFY(!tls.hasLocalData());
+        QCOMPARE(SPointer::count.loadRelaxed(), c);
+
+        tls.clearLocalData();
+        QVERIFY(!tls.hasLocalData());
+    }
+    QCOMPARE(SPointer::count.loadRelaxed(), c);
+
+    QThreadStorage<QString> tlsString;
+    tlsString.setLocalData(u"hello"_s);
+    QCOMPARE(tlsString.localData(), u"hello"_s);
+    tlsString.clearLocalData();
+    QVERIFY(!tlsString.hasLocalData());
+    // re-created default-constructed:
+    QVERIFY(tlsString.localData().isNull());
+    QVERIFY(tlsString.hasLocalData());
+    tlsString.clearLocalData();
+
+    QThreadStorage<std::unique_ptr<int>> tlsUniquePtr; // move-only payload
+    tlsUniquePtr.setLocalData(std::make_unique<int>(42));
+    QVERIFY(tlsUniquePtr.hasLocalData());
+    tlsUniquePtr.clearLocalData();
+    QVERIFY(!tlsUniquePtr.hasLocalData());
+    QCOMPARE_EQ(tlsUniquePtr.localData(), nullptr);
+    tlsUniquePtr.clearLocalData();
+}
+
+void tst_QThreadStorage::clearLocalData_perThread()
+{
+    const int c = SPointer::count.loadRelaxed();
+    QThreadStorage<SPointer> tls;
+    QThreadStorage<Pointer *> pointers;
+    const int pc = Pointer::count;
+
+    tls.localData();
+    pointers.setLocalData(new Pointer);
+
+    bool otherHadData = true;
+    bool otherHasDataAfterClear = true;
+    QScopedPointer<QThread> thread(QThread::create([&] {
+        otherHadData = tls.hasLocalData() || pointers.hasLocalData();
+        tls.localData();
+        // clearing in this thread must not affect the main thread's data...
+        tls.clearLocalData();
+        pointers.clearLocalData();
+        otherHasDataAfterClear = tls.hasLocalData() || pointers.hasLocalData();
+        // ...and data left behind here is cleaned up on thread exit:
+        tls.localData();
+        pointers.setLocalData(new Pointer);
+    }));
+    thread->start();
+    QVERIFY(thread->wait(WaitTimeout));
+
+    QVERIFY(!otherHadData);
+    QVERIFY(!otherHasDataAfterClear);
+    QVERIFY(tls.hasLocalData());
+    QVERIFY(pointers.hasLocalData());
+    QCOMPARE(SPointer::count.loadRelaxed(), c + 1);
+    QCOMPARE(Pointer::count, pc + 1);
+
+    tls.clearLocalData();
+    pointers.clearLocalData();
+    QVERIFY(!tls.hasLocalData());
+    QVERIFY(!pointers.hasLocalData());
+    QCOMPARE(SPointer::count.loadRelaxed(), c);
+    QCOMPARE(Pointer::count, pc);
+}
+
+void tst_QThreadStorage::clearLocalData_foreignThread()
+{
+    // clearLocalData() on a thread that never used Qt must be a no-op
+    // (and must not leave anything behind):
+    QThreadStorage<SPointer> tls;
+    QThreadStorage<Pointer *> pointers;
+    const int c = SPointer::count.loadRelaxed();
+    const int pc = Pointer::count;
+
+    std::thread t([&] {
+        tls.clearLocalData();
+        pointers.clearLocalData();
+    });
+    t.join();
+
+    QCOMPARE(SPointer::count.loadRelaxed(), c);
+    QCOMPARE(Pointer::count, pc);
+    QVERIFY(!tls.hasLocalData());
+    QVERIFY(!pointers.hasLocalData());
+}
+
