+void tst_QThreadStorage::clearLocalData_valueBased()
+{
+    const int c = SPointer::count.loadRelaxed();
+    {
+        QThreadStorage<SPointer> tlsSPointer;
+
+        // no-op when there is no data
+        tlsSPointer.clearLocalData();
+        QVERIFY(!tlsSPointer.hasLocalData());
+        QCOMPARE(int(SPointer::count.loadRelaxed()), c);
+
+        tlsSPointer.localData();
+        QVERIFY(tlsSPointer.hasLocalData());
+        QCOMPARE(int(SPointer::count.loadRelaxed()), c + 1);
+
+        tlsSPointer.clearLocalData();
+        QVERIFY(!tlsSPointer.hasLocalData());
+        QCOMPARE(int(SPointer::count.loadRelaxed()), c);
+
+        tlsSPointer.setLocalData(SPointer());
+        QVERIFY(tlsSPointer.hasLocalData());
+        QCOMPARE(int(SPointer::count.loadRelaxed()), c + 1);
+
+        tlsSPointer.clearLocalData();
+        tlsSPointer.clearLocalData(); // repeated: no-op
+        QVERIFY(!tlsSPointer.hasLocalData());
+        QCOMPARE(int(SPointer::count.loadRelaxed()), c);
+    }
+
+    QThreadStorage<QString> tlsString;
+    tlsString.setLocalData(u"hello"_s);
+    QCOMPARE(tlsString.localData(), u"hello"_s);
+    tlsString.clearLocalData();
+    QVERIFY(!tlsString.hasLocalData());
+    // the const overload does not re-create the data:
+    QVERIFY(std::as_const(tlsString).localData().isNull());
+    QVERIFY(!tlsString.hasLocalData());
+    // the non-const overload re-creates default-constructed data:
+    QVERIFY(tlsString.localData().isNull());
+    QVERIFY(tlsString.hasLocalData());
+    tlsString.clearLocalData();
+
+    QThreadStorage<std::unique_ptr<int>> tlsUniquePtr;
+    tlsUniquePtr.setLocalData(std::make_unique<int>(42));
+    QCOMPARE_NE(tlsUniquePtr.localData(), nullptr);
+    tlsUniquePtr.clearLocalData();
+    QVERIFY(!tlsUniquePtr.hasLocalData());
+    QCOMPARE_EQ(tlsUniquePtr.localData(), nullptr);
+    tlsUniquePtr.clearLocalData();
+}
+
+void tst_QThreadStorage::clearLocalData_perThread()
+{
+    // clearLocalData() only affects the calling thread's data
+    QThreadStorage<SPointer *> pointers;
+    QThreadStorage<QString> strings;
+
+    const int c = SPointer::count.loadRelaxed();
+
+    pointers.setLocalData(new SPointer);
+    strings.setLocalData(u"main"_s);
+
+    auto t = std::unique_ptr<QThread>(QThread::create([&] {
+        QVERIFY(!pointers.hasLocalData());
+        QVERIFY(!strings.hasLocalData());
+
+        pointers.setLocalData(new SPointer);
+        strings.setLocalData(u"worker"_s);
+        QCOMPARE(int(SPointer::count.loadRelaxed()), c + 2);
+
+        pointers.clearLocalData();
+        strings.clearLocalData();
+        QVERIFY(!pointers.hasLocalData());
+        QVERIFY(!strings.hasLocalData());
+        QCOMPARE(int(SPointer::count.loadRelaxed()), c + 1);
+    }));
+    t->start();
+    QVERIFY(t->wait(WaitTimeout));
+
+    QVERIFY(pointers.hasLocalData());
+    QVERIFY(strings.hasLocalData());
+    QCOMPARE(strings.localData(), u"main"_s);
+    QCOMPARE(int(SPointer::count.loadRelaxed()), c + 1);
+
+    pointers.clearLocalData();
+    strings.clearLocalData();
+    QVERIFY(!pointers.hasLocalData());
+    QVERIFY(!strings.hasLocalData());
+    QCOMPARE(int(SPointer::count.loadRelaxed()), c);
+}
