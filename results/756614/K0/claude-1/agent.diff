+/*!
+    \fn template <class T> void QThreadStorage<T>::clearLocalData()
+    \since 6.13
+
+    Destroys the local data of the calling thread, if any. Afterwards,
+    hasLocalData() returns \c false for the calling thread. The data of other
+    threads is not affected.
